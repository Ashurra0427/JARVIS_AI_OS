# ============================================================
# JARVIS AI OS — Environment Variables
# ============================================================
# 1. Copy this file:  cp config/.env.example .env
# 2. Fill in your API keys below.
# 3. NEVER commit .env to version control.
#
# Keys in .env override config/models.yaml at runtime.
#
# ── How defaults work ───────────────────────────────────────
# Variables marked "(required)" will cause a startup failure or
# silent degradation if left empty.
# Variables marked "(optional)" have a built-in default shown;
# only set them if you want to override the default.
# Variables marked "(security)" are required when binding on a
# non-localhost interface — server.py refuses to start without them.
# ============================================================


# ============================================================
# LLM Providers
# ============================================================

# ── Groq ── PRIMARY provider (fast inference, low latency)
# (required for cloud inference)
# Get key: https://console.groq.com/keys
# Format:  gsk_<48 alphanumeric characters>
GROQ_API_KEY=

# Groq model to use for chat completions.
# (optional, default: llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Custom Groq API base URL — only needed for proxies / enterprise endpoints.
# (optional, default: https://api.groq.com — leave blank for standard endpoint)
GROQ_BASE_URL=

# HTTP/HTTPS proxy for Groq requests only (overrides HTTP_PROXY/HTTPS_PROXY for Groq).
# (optional, default: inherits HTTP_PROXY / HTTPS_PROXY below)
GROQ_HTTP_PROXY=

# Disable SSL verification for Groq (e.g. behind a corporate TLS-inspection proxy).
# (optional, default: true — only set to false in trusted corporate network environments)
GROQ_VERIFY_SSL=true

# ── Gemini ── SECONDARY provider (reasoning, structured generation)
# (required for cloud inference fallback)
# Get key: https://aistudio.google.com/app/apikey
# Format:  AIza<39 alphanumeric characters>  (starts with "AIza")
# ⚠️  Keys starting with "AQ." are OAuth tokens, NOT API keys.
GEMINI_API_KEY=

# ── OpenAI ── optional, disabled by default in config/models.yaml
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Anthropic Claude ── optional
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── System-wide HTTP proxy ── used as fallback by Groq/Gemini clients
# (optional — only set if your network requires a proxy)
HTTP_PROXY=
HTTPS_PROXY=


# ============================================================
# Local Model / Ollama  (FINAL FALLBACK — no key needed)
# ============================================================

# Base URL for the Ollama server. Only change if running Ollama on a
# non-default port or a remote host.
# (optional, default: http://localhost:11434)
# To install: https://ollama.com/download
# To pull the default model: ollama pull qwen2.5:1.5b
OLLAMA_HOST=http://localhost:11434

# Ollama model tag used for standard chat completions (the primary local model).
# (optional, default: qwen2.5:1.5b)
OLLAMA_MODEL=qwen2.5:1.5b

# Ollama model used as last-resort emergency fallback if all other providers fail.
# (optional, default: qwen3:4b)
OLLAMA_EMERGENCY_MODEL=qwen3:4b

# HTTP request timeout in seconds for Ollama calls.
# Increase if using large local models that take longer to respond.
# (optional, default: 90)
OLLAMA_TIMEOUT_S=90

# Context-window size passed to Ollama (num_ctx Modelfile parameter).
# Larger values increase memory usage. Reduce on low-RAM hardware.
# (optional, default: 4096)
JARVIS_OLLAMA_NUM_CTX=4096

# Number of CPU threads used by Ollama's local inference.
# (optional, default: auto-detected by Ollama)
JARVIS_OLLAMA_NUM_THREAD=


# ============================================================
# OpenVINO / Qwen local acceleration (optional)
# ============================================================

# Enable the Qwen OpenVINO provider (requires openvino + a converted model).
# (optional, default: false)
QWEN_OPENVINO_ENABLED=false

# Inference device string passed to openvino.Core().
# HETERO:GPU,CPU tries GPU first and spills to CPU.
# On CPU-only hardware, set this explicitly to CPU to avoid silent degradation.
# (optional, default: HETERO:GPU,CPU — set CPU if no discrete GPU present)
QWEN_OPENVINO_DEVICE=CPU

# Number of CPU threads for OpenVINO inference.
# (optional, default: auto-detected)
QWEN_OPENVINO_CPU_THREADS=

# Timeout in seconds for OpenVINO inference calls.
# (optional, default: 60)
QWEN_OPENVINO_TIMEOUT_S=60

# Override the device used for all OpenVINO operations system-wide
# (not just Qwen — affects any openvino.Core() instance).
# (optional — leave blank to use QWEN_OPENVINO_DEVICE per-provider)
OPENVINO_DEVICE=


# ============================================================
# WebSocket Server
# ============================================================

# Port the JARVIS WebSocket server binds on.
# (optional, default: 7788)
JARVIS_PORT=7788

# ── WebSocket authentication secret ── (security)
# Required when binding on any non-localhost interface.
# If unset and server binds on 0.0.0.0 or a public IP, startup is REFUSED.
# Generate a strong random value:  python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️  Without this, any device on your network can connect to JARVIS unauthenticated.
JARVIS_SECRET=

# ── ngrok tunnel (optional) ──
# Only needed if you want remote access via an ngrok tunnel.
# Get token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Static ngrok URL, e.g. wss://catchy-wow-extras.ngrok-free.app/ws
# Leave blank to use a random ngrok-assigned URL each run.
NGROK_STATIC_URL=


# ============================================================
# Feature flags — these defaults determine which subsystems run
# ============================================================

# Enable the multi-agent Orchestrator + CoordinatorAgent + 7 specialists.
# When false (default), each message is handled by a single call to ModelRouter
# via per-agent system-prompt personas (AGENT_PROMPTS) — lightweight but single-agent.
# Set to true once Phase 3 bridge fix is confirmed working in your environment.
# (optional, default: false)
JARVIS_ENABLE_ORCHESTRATOR=false

# Enable always-listening microphone mode (continuous wake-word detection).
# Requires PICOVOICE_ACCESS_KEY. Disabled by default for remote/multi-client use.
# (optional, default: false)
JARVIS_ENABLE_ALWAYS_LISTENING=false

# Enable the ACTION_GUARD security layer (PolicyEngine → PermissionManager → ActionGuard).
# Disabling this is DANGEROUS — filesystem/terminal/browser actions become unsandboxed.
# Only disable temporarily for debugging, never in production.
# (optional, default: true — do not set to false in production)
JARVIS_ENABLE_ACTION_GUARD=true


# ============================================================
# Speech / STT / TTS
# ============================================================

# Faster-Whisper model size used for full-utterance transcription.
# Options: tiny, base, small, medium, large-v2, large-v3
# Larger = more accurate but slower and higher RAM usage.
# (optional, default: base)
FASTER_WHISPER_MODEL=base

# Kokoro ONNX TTS model file path (relative to repo root or absolute).
# Only needed if using Kokoro TTS instead of edge-tts.
# (optional, default: models/kokoro/kokoro-v1.0.onnx)
KOKORO_MODEL=models/kokoro/kokoro-v1.0.onnx

# Kokoro voices binary file path.
# (optional, default: models/kokoro/voices-v1.0.bin)
KOKORO_VOICES=models/kokoro/voices-v1.0.bin

# Picovoice access key — required ONLY if JARVIS_ENABLE_ALWAYS_LISTENING=true.
# Used for wake-word detection (Porcupine engine).
# Get free key: https://console.picovoice.ai/
# (required if JARVIS_ENABLE_ALWAYS_LISTENING=true, otherwise unused)
PICOVOICE_ACCESS_KEY=


# ============================================================
# Tool APIs
# ============================================================

# Google / Serper web search (used by ResearchAgent)
# Get key: https://serper.dev/
SERPER_API_KEY=

# NewsAPI — news fetching tool
# Get key: https://newsapi.org/register
NEWS_API_KEY=

# Wolfram Alpha — computation/knowledge tool
# Get key: https://developer.wolframalpha.com/
WOLFRAM_APP_ID=

# GitHub — code/repo tool
# Create token: https://github.com/settings/tokens
GITHUB_TOKEN=

# ElevenLabs — premium TTS (optional, edge-tts is the default)
# Get key: https://elevenlabs.io/
ELEVENLABS_API_KEY=


# ============================================================
# Display / GUI (auto-detected in most environments)
# ============================================================

# X11 display for the PySide6 HUD (auto-set by the desktop environment).
# Only set manually if running headless or via SSH with X forwarding.
# (optional, auto-detected)
# DISPLAY=:0

# Wayland display socket (alternative to X11).
# (optional, auto-detected)
# WAYLAND_DISPLAY=wayland-0


# ============================================================
# System Overrides
# ============================================================

# Override the environment tag (development | staging | production)
# JARVIS_SYSTEM__ENVIRONMENT=development

# Override log level (DEBUG | INFO | WARNING | ERROR)
# JARVIS_LOGGING__LEVEL=INFO

# Override data directory
# JARVIS_SYSTEM__DATA_DIR=datastore
