#  WEBSOCKET MANAGER
# ═══════════════════════════════════════════════════════════════════════════════

class ConnectionManager:
    # P-06: Per-connection rate-limit settings (configurable via RUNTIME_SETTINGS)
    _RATE_LIMIT_MSGS: int = 30     # max messages
    _RATE_LIMIT_WINDOW: float = 10.0  # seconds

    def __init__(self):
        self._clients: set[WebSocket] = set()
        # P-06: {ws: {"msg_times": deque(maxlen=30)}}
        self._states: dict[WebSocket, dict] = {}

    async def connect(self, ws: WebSocket):
        await ws.accept()
        self._clients.add(ws)
        from collections import deque
        self._states[ws] = {"msg_times": deque(maxlen=self._RATE_LIMIT_MSGS)}
        log.info(f"HUD connected ({len(self._clients)} clients)")

    def disconnect(self, ws: WebSocket):
        self._clients.discard(ws)
        self._states.pop(ws, None)
        log.info(f"HUD disconnected ({len(self._clients)} clients)")

    def is_rate_limited(self, ws: WebSocket) -> bool:
        """Return True if this connection has exceeded the rate limit."""
        state = self._states.get(ws)
        if state is None:
            return False
        now = time.time()
        times = state["msg_times"]
        times.append(now)
        # Count messages within the window
        limit = RUNTIME_SETTINGS.get("rate_limit_msgs", self._RATE_LIMIT_MSGS)
        window = RUNTIME_SETTINGS.get("rate_limit_window", self._RATE_LIMIT_WINDOW)
        recent = sum(1 for t in times if now - t <= window)
        return recent > limit

    async def broadcast(self, msg: dict):
        dead = set()
        for ws in self._clients:
            try:
                await ws.send_text(json.dumps(msg))
            except Exception:
                dead.add(ws)
        for ws in dead:
            self._clients.discard(ws)

    async def send(self, ws: WebSocket, msg: dict):
        await ws.send_text(json.dumps(msg))
        # P-11: Keep a short replay buffer per connection (last 5 messages)
        state = self._states.get(ws)
        if state is not None:
            buf = state.setdefault("replay_buf", [])
            buf.append(msg)
            if len(buf) > 5:
                buf.pop(0)


manager = ConnectionManager()


