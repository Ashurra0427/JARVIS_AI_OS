@app.get("/health")
def health():
    """
    Phase 0: backed by observability/health/health_monitor.py when it loaded
    successfully at startup. Falls back to the original static "ok" response
    if HealthMonitor is disabled or failed to initialize — same shape callers
    have always gotten, just with a "degraded"/"starting" possibility added
    (existing tests already accept those values).
    """
    base = {"status": "ok", "uptime": int(time.time() - _start_time)}
    if HEALTH_MONITOR is None:
        base["health_monitor"] = "not loaded"
        return base
    snapshot = HEALTH_MONITOR.status_snapshot()
    # "healthy" -> "ok" keeps this endpoint backward compatible with anything
    # already polling /health and checking status == "ok"; degraded/unhealthy
    # are new information this endpoint never reported before Phase 0.
    base["status"] = "ok" if snapshot["system"] == "healthy" else snapshot["system"]
    base["components"] = {
        name: {"status": c["status"], "pass_rate": c["pass_rate"]}
        for name, c in snapshot["components"].items()
    }
    return base


@app.get("/config/ws_url")
def ws_url_config():
    """
    Returns the best WebSocket URL(s) for this server.
    The HTML HUD fetches this on load to auto-discover local + ngrok URLs
    without any hardcoding.  Response shape:
      {
        "local":  "ws://localhost:7788/ws",
        "remote": "wss://xxxx.ngrok-free.app/ws"  // or "" if no tunnel
      }
    The HUD tries local first; falls back to remote; falls back to offline.
    """
    local_url = f"ws://localhost:{PORT}/ws"
    return JSONResponse({
        "local":  local_url,
        "remote": _ngrok_tunnel_url,
    })


