async def _prewarm_ollama() -> None:
    """Fire-and-forget: send a trivial request to Ollama at boot so the
    user's actually-selected model is loaded into memory *before* the
    first real chat message needs it. Without this, the first request to
    Ollama pays the full model-load cost (often 45-90s+ for a 4B model) on
    top of whatever timeout the router allows.

    v4.0 note: the router's Ollama instance starts with NO model loaded —
    ModelSwitcher decides what's active. Prewarming the OLLAMA_MODEL env
    var unconditionally would warm a model that may not even be the one
    the user selected, while leaving their actual selection cold. So this
    only prewarms when Ollama is the user's active provider, and warms
    exactly the tag ModelSwitcher reports as current.
    """
    from models.switcher.model_switcher import ModelSwitcher
    switcher = ModelSwitcher.get_instance()
    if switcher.current_provider != "ollama":
        log.debug("Ollama pre-warm skipped — active provider is not Ollama")
        return

    model_to_warm = switcher.current_model
    if not model_to_warm:
        log.debug("Ollama pre-warm skipped — no model tag set")
        return

    import aiohttp
    url = f"{OLLAMA_HOST.rstrip('/')}/api/chat"
    payload = {
        "model": model_to_warm,
        "stream": False,
        "messages": [{"role": "user", "content": "hi"}],
        "options": {"num_predict": 1},
    }
    try:
        timeout = aiohttp.ClientTimeout(total=180)  # cold load can be slow
        async with aiohttp.ClientSession(timeout=timeout) as session:
            t0 = time.monotonic()
            async with session.post(url, json=payload) as resp:
                await resp.read()
                if resp.status == 200:
                    log.info(f"Ollama pre-warmed ({model_to_warm}) in {time.monotonic()-t0:.1f}s")
                else:
                    log.warning(f"Ollama pre-warm got HTTP {resp.status} (model: {model_to_warm})")
    except Exception as e:
        log.info(f"Ollama pre-warm skipped (not running?): {e}")


async def _daily_summary_scheduler() -> None:
    """
    Background task: runs DailySummary every 6 hours and exports to disk.
    Also feeds the aggregated report into MemoryManager as a REFLECTION entry
    so the ReflectionEngine can consume it on the next cycle.
    Interval is 6 h (not midnight) so long-running server sessions get at
    least one mid-session summary without having to wait until day rollover.
    """
    INTERVAL_S = 6 * 3600.0
    await asyncio.sleep(60)          # short initial delay so startup is clean
    while True:
        if DAILY_SUMMARY is not None:
            try:
                report = DAILY_SUMMARY.generate_summary()
                # Export to disk
                try:
                    paths = DAILY_SUMMARY.export_summary(
                        report, output_dir="datastore/summaries"
                    )
                    log.info(
                        f"DailySummary exported — {report.total_events} events, "
                        f"paths={list(paths.values())}"
                    )
                except Exception as exp_exc:
                    log.warning(f"DailySummary export failed: {exp_exc}")

                # Persist to MemoryManager if available
                if MEMORY_ROUTER is not None:
                    try:
                        import dataclasses as _dc
                        payload = {
                            "date_label": report.date_label,
                            "total_events": report.total_events,
                            "highlights": report.highlights,
                            "insights": report.insights,
                            "anomalies": report.anomalies,
                        }
                        await MEMORY_ROUTER.remember(
                            content=str(payload),
                        )
                    except Exception as mr_exc:
                        log.debug(f"DailySummary → MemoryRouter failed (non-fatal): {mr_exc}")

                # Reset for next cycle
                DAILY_SUMMARY.reset()
            except Exception as exc:
                log.warning(f"DailySummary scheduler error (non-fatal): {exc}")

        await asyncio.sleep(INTERVAL_S)


async def _reflection_trigger_scheduler() -> None:
    """
    Background task: publishes a 'reflection.trigger' event every 2 hours
    so the ReflectionEngine (subscribed via EventBus in the full kernel path)
    runs a periodic reflection cycle independently of manual triggers.

    FIX: Guard added — only broadcast when at least one WebSocket client is
    connected, preventing a spurious broadcast error that was being logged
    every 2 h at startup (before any HUD client connected) and again whenever
    all clients disconnected.  The Ollama fallback tier then received an
    unexplained "error" state that caused it to be skipped unnecessarily.
    """
    INTERVAL_S = 2 * 3600.0
    await asyncio.sleep(300)         # 5-minute initial delay
    while True:
        if manager._clients:          # only broadcast when someone is listening
            try:
                await manager.broadcast({
                    "type": "reflection_trigger",
                    "ts": time.time(),
                    "source": "server.scheduler",
                    "interval_s": INTERVAL_S,
                })
                log.info("Reflection trigger broadcast sent")
            except Exception as exc:
                log.debug(f"Reflection trigger broadcast failed: {exc}")
        else:
            log.debug("Reflection trigger: no clients connected — skipping broadcast")
        await asyncio.sleep(INTERVAL_S)


async def on_startup():
    psutil.cpu_percent(interval=None)
    psutil.cpu_percent(interval=None, percpu=True)

    # ── Model router: initialize FIRST, with OLLAMA_HOST ───────────────────
    # get_router() is a lazy singleton — whoever calls it first decides the
    # ollama_url it's constructed with. Every other call site in this file
    # (call_ai(), the WS handlers, health checks, the orchestrator wiring)
    # calls get_router() with no arguments, so if nothing initializes the
    # singleton explicitly here, ModelRouter.__init__'s ollama_url default
    # ("http://localhost:11434") silently wins even when OLLAMA_HOST is set
    # to something else. This bit the HUD's Ollama model list before: the
    # discovery path and the router path could end up pointed at different
    # hosts depending on call order, and any custom OLLAMA_HOST was ignored
    # entirely. Doing it explicitly, first, here removes the ordering
    # dependency.
    try:
        from models.router.model_router import get_router
        get_router(ollama_url=OLLAMA_HOST)
        log.info(f"ModelRouter pre-initialized with ollama_url={OLLAMA_HOST}")
    except Exception as _router_exc:
        log.warning(f"ModelRouter pre-init failed (non-fatal, will lazy-init later): {_router_exc}")

    # ── Asyncio loop exception handler ────────────────────────────────────────
    # By default, an unhandled exception inside an asyncio.create_task() coroutine
    # is reported via the loop's exception handler — which on some uvicorn/Windows
    # versions terminates the server. Override it to log-and-continue instead.
    def _handle_task_exception(loop, context):
        exc = context.get("exception")
        msg = context.get("message", "unknown")
        if exc is not None:
            log.error(f"Unhandled background task exception (non-fatal): {exc!r} — {msg}")
        else:
            log.warning(f"Asyncio loop error (non-fatal): {msg}")

    asyncio.get_event_loop().set_exception_handler(_handle_task_exception)

    asyncio.create_task(_metrics_broadcaster())
    asyncio.create_task(_heartbeat())
    asyncio.create_task(_agent_metrics_broadcaster())
    asyncio.create_task(_prewarm_ollama())
    asyncio.create_task(_start_ngrok())
    asyncio.create_task(_daily_summary_scheduler())
    asyncio.create_task(_reflection_trigger_scheduler())

    # Security: warn loudly if no WebSocket auth token is configured
    if not SERVER_SECRET:
        log.warning(
            "JARVIS_SECRET is not set — WebSocket endpoint has NO authentication. "
            "Set JARVIS_SECRET=<random-token> in .env before exposing to a network."
        )

    # ── Tool Registry (browser.*, web.*, fs.*, code.*, system.*, apps.*, etc.) ──
    # ── Consolidated global declarations (all names assigned in this function) ──
    # Python global is function-scoped but processed at parse time. One block at the
    # top prevents the silent local-shadow bug if blocks are reordered in future edits.
    global TOOL_REGISTRY, MEMORY_ROUTER, TASK_PLANNER, _SERVER_BUS, STT_ENGINE, TTS_ENGINE, ORCHESTRATOR
    global ACTION_GUARD, HEALTH_MONITOR, METRICS_COLLECTOR
    global _browser_tools, EMBEDDING_SERVICE, DAILY_SUMMARY, ACKNOWLEDGEMENT_ENGINE
    global WAKE_WORD_MANAGER, VOICE_COORDINATOR, ACTIVITY_OBSERVER, VISION_PIPELINE
    try:
        from tools.registry.tool_registry import get_registry
        from tools.registry.tool_registry_registration import register_all_tools
        TOOL_REGISTRY = get_registry()
        registered = register_all_tools(TOOL_REGISTRY, event_bus=None)
        total = sum(len(v) for v in registered.values())
        log.info(f"ToolRegistry: {total} tools registered across {len(registered)} modules")
    except Exception as e:
        log.error(f"ToolRegistry init failed: {e}")
        TOOL_REGISTRY = None

    # ── Phase 1 — Safety & Action Layer ──────────────────────────────────────
    # PolicyEngine + PermissionManager + ActionGuard + TerminalManager +
    # FileManager.  Wired into ToolRegistry.invoke() via the SecurityIntegration
    # singleton — no second EventBus, no separate import chain.
    #
    # Ground-rule compliance:
    #   • Non-fatal: each component wrapped in try/except; server still boots.
    #   • One shared EventBus: _SERVER_BUS is passed in (created just above).
    #   • Env-var gated: JARVIS_ENABLE_ACTION_GUARD (default True).
    #   • Visible in /health: registers a HealthCheck below.
    #   • Deny-by-default for destructive actions, allow for safe reads.
    ACTION_GUARD = None
    if JARVIS_ENABLE_ACTION_GUARD:
        try:
            from actions.security.security_integration import init_security_integration
            ACTION_GUARD = await init_security_integration(event_bus=_SERVER_BUS)
            if ACTION_GUARD is not None:
                log.info(
                    "Phase 1: Safety & Action Layer online",
                    policy_engine=ACTION_GUARD.policy_engine is not None,
                    permission_manager=ACTION_GUARD.permission_manager is not None,
                    action_guard=ACTION_GUARD.action_guard is not None,
                    terminal_manager=ACTION_GUARD.terminal_manager is not None,
                    file_manager=ACTION_GUARD.file_manager is not None,
                )
                # Register Phase 1 health check so /health reflects it
                if HEALTH_MONITOR is not None:
                    from observability.health.health_monitor import HealthCheck as _HC1
                    def _check_action_guard() -> bool:
                        return (
                            ACTION_GUARD is not None
                            and ACTION_GUARD.action_guard is not None
                        )
                    HEALTH_MONITOR.register(_HC1(
                        name="action_guard",
                        check_fn=_check_action_guard,
                        critical=False,
                    ))
                    await HEALTH_MONITOR.check_all()
            else:
                log.warning("Phase 1: SecurityIntegration returned None — action guard not active")
        except Exception as _p1_exc:
            log.warning("Phase 1: Safety & Action Layer init failed (non-fatal): %s", _p1_exc)
            ACTION_GUARD = None
    else:
        log.info("Phase 1: Action Guard disabled (JARVIS_ENABLE_ACTION_GUARD=false)")

    # ── Memory Router (working/episodic/semantic/vector) ─────────────────────
    try:
        from memory.router.memory_router import MemoryRouter
        MEMORY_ROUTER = MemoryRouter()
        MEMORY_ROUTER.inject(event_bus=None, model_router=None)
        await MEMORY_ROUTER.start()
        log.info("MemoryRouter started")
    except Exception as e:
        log.error(f"MemoryRouter init failed: {e}")
        MEMORY_ROUTER = None

    # ── Shared in-process EventBus ────────────────────────────────────────────
    # Created once here so GoalManager, AcknowledgementEngine, STT_ENGINE,
    # TTS_ENGINE, and any other server-side component that needs event
    # publishing can share a single bus. FIXED: this used to be a function-
    # local variable (_server_bus) that silently went out of scope at the
    # end of on_startup(), so nothing outside this function could ever
    # actually reuse it despite the comment above claiming otherwise.
    _SERVER_BUS = None
    try:
        from kernel.event_bus.event_bus import EventBus
        _SERVER_BUS = EventBus()
        await _SERVER_BUS.start()
        log.info("Server EventBus started")
        # ── Relay agent workflow steps to WebSocket clients ───────────────────
        async def _on_workflow_step(event):
            try:
                payload = event.payload if hasattr(event, 'payload') else event
                await manager.broadcast({
                    "type":    "agent_workflow_step",
                    "agent":   payload.get("agent", ""),
                    "step_id": payload.get("step_id", ""),
                    "label":   payload.get("label", ""),
                    "status":  payload.get("status", "active"),
                    "detail":  payload.get("detail", ""),
                })
            except Exception:
                pass
        _SERVER_BUS.subscribe("agent.workflow.step", _on_workflow_step)
        log.info("Workflow step relay subscribed")
    except Exception as e:
        log.warning(f"Server EventBus init failed (non-fatal): {e}")

    # ── Health Monitor (Phase 0 — observability/health/health_monitor.py) ────
    # Backs /health with real subsystem checks instead of a static "ok".
    # Registered checks are deliberately cheap/synchronous-friendly — no
    # outbound network calls (e.g. NOT ModelRouter.health_check_all(), which
    # pings every provider's live API) since this runs on a 30s timer.
    HEALTH_MONITOR = None
    if JARVIS_ENABLE_HEALTH_MONITOR and _SERVER_BUS is not None:
        try:
            from observability.health.health_monitor import HealthMonitor, HealthCheck
            _health_cfg = CONFIG.config.health if CONFIG is not None else None
            HEALTH_MONITOR = HealthMonitor(
                bus=_SERVER_BUS,
                check_interval_s=(_health_cfg.check_interval_s if _health_cfg else 30),
                degraded_threshold=(_health_cfg.degraded_threshold if _health_cfg else 0.8),
                unhealthy_threshold=(_health_cfg.unhealthy_threshold if _health_cfg else 0.5),
                window_size=(_health_cfg.history_window if _health_cfg else 10),
            )

            def _check_event_bus() -> bool:
                return _SERVER_BUS is not None and bool(getattr(_SERVER_BUS, "_running", True))

            def _check_tool_registry() -> bool:
                return TOOL_REGISTRY is not None and len(TOOL_REGISTRY.list_tools(enabled_only=False)) > 0

            def _check_memory_router() -> bool:
                return MEMORY_ROUTER is not None

            def _check_model_router() -> bool:
                try:
                    from models.router.model_router import get_router
                    return len(get_router()._providers) > 0
                except Exception:
                    return False

            HEALTH_MONITOR.register(HealthCheck(
                name="event_bus", check_fn=_check_event_bus, critical=True,
            ))
            HEALTH_MONITOR.register(HealthCheck(
                name="tool_registry", check_fn=_check_tool_registry, critical=False,
            ))
            HEALTH_MONITOR.register(HealthCheck(
                name="memory_router", check_fn=_check_memory_router, critical=False,
            ))
            HEALTH_MONITOR.register(HealthCheck(
                name="model_router", check_fn=_check_model_router, critical=True,
            ))
            await HEALTH_MONITOR.start()
            await HEALTH_MONITOR.check_all()  # populate real status immediately, don't wait 30s
            log.info("HealthMonitor started with 4 checks (event_bus, tool_registry, memory_router, model_router)")
        except Exception as e:
            log.warning(f"HealthMonitor init failed (non-fatal, /health falls back to static ok): {e}")
            HEALTH_MONITOR = None
    elif JARVIS_ENABLE_HEALTH_MONITOR:
        log.warning("HealthMonitor skipped: EventBus unavailable (HealthMonitor requires a bus)")

    # ── Metrics Collector (Phase 0 — observability/metrics/metrics_collector.py) ─
    # Backs /metrics with real counters in addition to the existing CPU/RAM/
    # disk snapshot. get_metrics() below is left untouched; this is additive.
    METRICS_COLLECTOR = None
    if JARVIS_ENABLE_METRICS_COLLECTOR:
        try:
            from observability.metrics.metrics_collector import MetricsCollector
            METRICS_COLLECTOR = MetricsCollector.get()
            log.info("MetricsCollector ready")
        except Exception as e:
            log.warning(f"MetricsCollector init failed (non-fatal): {e}")
            METRICS_COLLECTOR = None

    # ── STT / TTS engines — the canonical implementations ─────────────────────
    # See the module-level comment near STT_ENGINE/TTS_ENGINE for why this
    # replaced server.py's previous hand-rolled Groq/edge-tts/faster-whisper/
    # Kokoro calls. Both engines work fine with bus=None (their request/
    # response methods used below — transcribe_blob()/synthesize_only() —
    # don't touch the EventBus at all), but we pass the real bus when
    # available so any future bus-based features (e.g. live status events)
    # work without further changes.
    try:
        from perception.speech.stt import STTEngine, STTConfig
        STT_ENGINE = STTEngine(
            bus=_SERVER_BUS,
            config=STTConfig(
                groq_api_key=GROQ_KEY,
                language="",  # "" → auto-detect (en/hi/ne/...) — do NOT force "en"
                local_model=FASTER_WHISPER_MODEL,
            ),
        )
        STT_ENGINE.start()
        log.info("STTEngine initialised (server.py)", groq_available=bool(GROQ_KEY))
    except Exception as e:
        log.error(f"STTEngine init failed: {e}")
        STT_ENGINE = None

    try:
        from perception.voice.tts import TTSEngine, TTSConfig
        TTS_ENGINE = TTSEngine(
            bus=_SERVER_BUS,
            config=TTSConfig(
                kokoro_model_path=KOKORO_MODEL,
                kokoro_voices_path=KOKORO_VOICES,
            ),
        )
        TTS_ENGINE.start()
        log.info("TTSEngine initialised (server.py)")
    except Exception as e:
        log.error(f"TTSEngine init failed: {e}")
        TTS_ENGINE = None

    # ── Task Planner (PlanningEngine + GoalManager) ───────────────────────────
    try:
        from cognition.planning.goal_manager import GoalManager
        from cognition.planning.task_planner import PlanningEngine
        gm = GoalManager()
        if _SERVER_BUS is not None:
            gm.inject(_SERVER_BUS)   # Fix #4: wire bus so goal events are published
        TASK_PLANNER = PlanningEngine(gm)
        log.info("TaskPlanner (PlanningEngine) initialised")
    except Exception as e:
        log.error(f"TaskPlanner init failed: {e}")
        TASK_PLANNER = None

    # ── Phase 2 — Kernel Orchestrator (cognition + multi-agent execution) ────
    # Wired only when JARVIS_ENABLE_ORCHESTRATOR=true.
    # Shares _SERVER_BUS, MEMORY_ROUTER, and TOOL_REGISTRY — no second copies.
    # The specialist agent classes (ResearchAgent, EngineeringAgent, …) are
    # instantiated inside Orchestrator._start_agents(); each registers itself
    # in the AgentRegistry and subscribes to its own EventBus topics.
    #
    # Bridge: agent.metrics.updated events are forwarded into the existing
    # AGENT_REGISTRY dict so the HUD UI keeps showing live agent stats
    # regardless of whether the orchestrator is enabled.
    ORCHESTRATOR = None
    if JARVIS_ENABLE_ORCHESTRATOR and _SERVER_BUS is not None and MEMORY_ROUTER is not None:
        try:
            from models.router.model_router import get_router as _get_model_router
            _model_router = _get_model_router()
        except Exception as _mr_exc:
            log.warning(f"Phase 2: could not get ModelRouter ({_mr_exc}) — orchestrator will run without LLM routing")
            _model_router = None

        try:
            from kernel.orchestrator.orchestrator import Orchestrator
            ORCHESTRATOR = Orchestrator(
                event_bus=_SERVER_BUS,
                model_router=_model_router,
                memory_router=MEMORY_ROUTER,
                tool_registry=TOOL_REGISTRY,
            )
            await ORCHESTRATOR.start()

            # ── Bridge: relay agent.metrics.updated → AGENT_REGISTRY ────────
            # Keeps the HUD agent cards (which read from AGENT_REGISTRY) alive
            # with real live data from the running agent classes.
            _AGENT_NAME_MAP: dict[str, str] = {
                # agent.name (set in super().__init__) → AGENT_REGISTRY key
                # These are the actual canonical names used inside each agent class:
                "athena":      "athena",      # ResearchAgent
                "vision_eng":  "vision_eng",  # EngineeringAgent
                "ashura":      "ashura",      # AnalysisAgent
                "herald":      "herald",      # CommunicationAgent
                "friday":      "friday",      # AutomationAgent
                "vision":      "vision_eng",  # VisionAgent (uses "vision", maps to "vision_eng" in AGENT_REGISTRY)
                "oracle":      "oracle",      # PlanningAgent
                "coordinator": "coordinator", # CoordinatorAgent
            }

            async def _on_agent_metrics(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    raw_name = p.get("agent_name", p.get("agent", ""))
                    reg_key = _AGENT_NAME_MAP.get(raw_name, raw_name)
                    if reg_key not in AGENT_REGISTRY:
                        return
                    rec = AGENT_REGISTRY[reg_key]
                    # MetricsPublisherMixin nests everything inside p["metrics"]:
                    #   {"agent_name": ..., "current_task": ..., "metrics": {"tasks_done": ..., "status": ..., ...}}
                    metrics = p.get("metrics", {})
                    # Sync status and task description
                    if "status" in metrics:
                        rec["status"] = metrics["status"]
                    if p.get("current_task"):
                        rec["current_task"] = p["current_task"][:60]
                    # Sync counters
                    if "tasks_done" in metrics:
                        rec["tasks_done"] = metrics["tasks_done"]
                    if "tasks_failed" in metrics:
                        rec["tasks_failed"] = metrics["tasks_failed"]
                    # Merge any other agent-specific keys into the nested metrics dict
                    for k, v in metrics.items():
                        if k not in ("tasks_done", "tasks_failed", "status", "uptime_s"):
                            rec["metrics"][k] = v
                except Exception:
                    pass

            _SERVER_BUS.subscribe("agent.metrics.updated", _on_agent_metrics)

            # ── Bridge: relay agent goal lifecycle → HUD workflow steps ─────
            async def _on_agent_goal_completed(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    raw_name = p.get("agent_name", p.get("agent", ""))
                    reg_key = _AGENT_NAME_MAP.get(raw_name, raw_name)
                    if reg_key in AGENT_REGISTRY:
                        AGENT_REGISTRY[reg_key]["status"] = "idle"
                        AGENT_REGISTRY[reg_key]["tasks_done"] += 1
                        AGENT_REGISTRY[reg_key]["current_task"] = ""
                except Exception:
                    pass

            async def _on_agent_goal_failed(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    raw_name = p.get("agent_name", p.get("agent", ""))
                    reg_key = _AGENT_NAME_MAP.get(raw_name, raw_name)
                    if reg_key in AGENT_REGISTRY:
                        AGENT_REGISTRY[reg_key]["status"] = "idle"
                        AGENT_REGISTRY[reg_key]["tasks_failed"] += 1
                        AGENT_REGISTRY[reg_key]["current_task"] = ""
                except Exception:
                    pass

            _SERVER_BUS.subscribe("agent.goal_completed", _on_agent_goal_completed)
            _SERVER_BUS.subscribe("agent.goal_failed", _on_agent_goal_failed)

            # Register a health check for the orchestrator so /health reflects it.
            if HEALTH_MONITOR is not None:
                from observability.health.health_monitor import HealthCheck as _HC
                def _check_orchestrator() -> bool:
                    return ORCHESTRATOR is not None and bool(ORCHESTRATOR.agents)
                HEALTH_MONITOR.register(_HC(
                    name="orchestrator",
                    check_fn=_check_orchestrator,
                    critical=False,
                ))
                await HEALTH_MONITOR.check_all()

            log.info(
                "Phase 2: Orchestrator started",
                agents=list(ORCHESTRATOR.agents.keys()),
            )
        except Exception as _orch_exc:
            log.warning(
                f"Phase 2: Orchestrator init failed (non-fatal, falling back to "
                f"pre-Phase-2 single-LLM routing): {_orch_exc}",
                exc_info=True,
            )
            ORCHESTRATOR = None
    elif JARVIS_ENABLE_ORCHESTRATOR:
        log.warning(
            "Phase 2: Orchestrator skipped — EventBus or MemoryRouter not available "
            "(Orchestrator requires both). Set JARVIS_ENABLE_ORCHESTRATOR=false to silence this."
        )

    # ── P-12: Browser Tools (Playwright) ─────────────────────────────────────
    # browser_tools.py manages its own PlaywrightEngine singleton via _get_engine().
    # We just import the module and call _get_engine() once to warm it up.
    # There is no BrowserTools class — all tools are module-level functions.
    try:
        from tools.browser_tools import browser_tools as _bt_module
        engine = _bt_module._get_engine()   # warm up; creates PlaywrightEngine
        # Only call start() if not already running (PlaywrightEngine has no guard)
        already_started = getattr(engine, "_playwright", None) is not None
        if not already_started and hasattr(engine, "start") and asyncio.iscoroutinefunction(engine.start):
            await engine.start()
        _browser_tools = _bt_module
        is_real = not isinstance(engine, _bt_module._StubEngine)
        if is_real:
            log.info("Browser tools: Playwright engine warmed up")
        else:
            log.warning("Browser tools: running in stub mode (Playwright not available)")
    except Exception as e:
        log.warning(f"Browser tools: init skipped ({type(e).__name__}: {e})")
        _browser_tools = None

    # ── Embedding Service (SentenceTransformers → OpenAI API → TF-IDF) ───────
    # Reuse the instance already registered by Bootstrap in the DI container
    # so all agents, ReasoningEngine, and the HTTP endpoints share one singleton
    # (one loaded model in memory, one LRU cache).  Fall back to creating a
    # fresh instance only if the DI container isn't available (e.g. server.py
    # is run standalone without Bootstrap).
    try:
        try:
            from boot.dependency_container import DependencyContainer
            _di = DependencyContainer.get_instance()
            EMBEDDING_SERVICE = _di.try_resolve("embedding_service")
        except Exception:
            EMBEDDING_SERVICE = None

        if EMBEDDING_SERVICE is None:
            from models.embeddings.embedding_service import EmbeddingService
            EMBEDDING_SERVICE = EmbeddingService()

        # Force lazy init now so the first embed() call isn't slow
        await EMBEDDING_SERVICE.embed("jarvis system ready")
        log.info(f"EmbeddingService ready — backend: {EMBEDDING_SERVICE.stats()['backend']}")
    except Exception as e:
        log.warning(f"EmbeddingService init failed (non-fatal): {e}")
        EMBEDDING_SERVICE = None

    # ── Daily Summary (event aggregator / intelligence compressor) ────────────
    try:
        from memory.summaries.daily_summary import DailySummary
        DAILY_SUMMARY = DailySummary()
        log.info("DailySummary initialized")
    except Exception as e:
        log.warning(f"DailySummary init failed (non-fatal): {e}")
        DAILY_SUMMARY = None

    # ── Acknowledgement Engine (backchannel filler phrases over TTS) ──────────
    # Reuses _server_bus created above — no second EventBus needed.
    # Windows note: perception.speech.acknowledgement needs project root on sys.path
    # which is now guaranteed by the top-of-file sys.path injection.
    try:
        import importlib as _il
        _ack_mod = _il.import_module("perception.speech.acknowledgement")
        AcknowledgementEngine = _ack_mod.AcknowledgementEngine
        AcknowledgementConfig = _ack_mod.AcknowledgementConfig
        # Use the shared _SERVER_BUS (module-level) — NOT a local variable.
        # Using a local "_server_bus" here silently created an orphaned second
        # EventBus that nothing else subscribed to, breaking ack engine events.
        _ack_bus = _SERVER_BUS
        if _ack_bus is None:
            from kernel.event_bus.event_bus import EventBus
            _ack_bus = EventBus()
            await _ack_bus.start()
            _SERVER_BUS = _ack_bus   # keep module ref consistent
        _ack_cfg = AcknowledgementConfig(enabled=True, probability=0.82)
        ACKNOWLEDGEMENT_ENGINE = AcknowledgementEngine(
            bus=_ack_bus,
            tts_router=None,   # server.py uses edge-tts directly
            config=_ack_cfg,
        )
        log.info("AcknowledgementEngine initialized")
    except Exception as e:
        log.warning(f"AcknowledgementEngine init failed (non-fatal): {type(e).__name__}: {e}")
        ACKNOWLEDGEMENT_ENGINE = None

    # ── Phase 3 — Always-listening wake-word pipeline ─────────────────────────
    # Ground-rule compliance:
    #   • Non-fatal: each component wrapped in try/except; server still boots.
    #   • One shared EventBus: _SERVER_BUS is passed everywhere.
    #   • Env-var gated: JARVIS_ENABLE_ALWAYS_LISTENING (default False).
    #   • Additive: existing push-to-talk (stt_audio WS message) is UNCHANGED.
    #   • Visible in /health: registers a HealthCheck when started.
    #
    # Architecture:
    #   MicrophoneEngine (audio source, manages its own internal audio_queue)
    #     ↓ _mic.audio_queue (primary) + subscribe_audio_queue() fanout
    #   HotwordDetector (reads _mic.audio_queue → fires HOTWORD_DETECTED)
    #   WakeListener    (reads _mic.audio_queue → IDLE→CANDIDATE→ARMED→LISTENING)
    #     ↓ LISTENING_ENDED event with raw PCM
    #   STTRouter → shared STT_ENGINE → STT_TRANSCRIPTION_FINAL event
    #   VoiceCoordinator → voice.utterance.received event
    #     ↓ [_handle_voice_utterance subscriber below]
    #     ↓ calls call_ai() → publishes voice.response.ready
    #   TTSRouter → shared TTS_ENGINE → audio playback

    WAKE_WORD_MANAGER = None
    VOICE_COORDINATOR = None

    if JARVIS_ENABLE_ALWAYS_LISTENING and _SERVER_BUS is not None:
        try:
            import queue as _queue_mod
            from perception.speech.microphone import MicrophoneEngine, MicConfig
            from perception.speech.noise_calibrator import NoiseCalibrator
            from perception.speech.hotword import HotwordDetector, HotwordConfig
            from perception.speech.wake_listener import WakeListener, WakeListenerConfig, VoiceMode
            from perception.speech.stt_router import STTRouter
            from perception.speech.tts_router import TTSRouter as _TTSRouter
            from perception.speech.interrupt_detector import InterruptDetector
            from perception.speech.voice_coordinator import VoiceCoordinator
            from wakeword.manager import WakeWordManager

            # ── Microphone ─────────────────────────────────────────────────
            # FIX 1: Constructor is (bus, config: MicConfig | None = None).
            # No audio_queue param — MicrophoneEngine owns its internal queue.
            # Config class is MicConfig (not MicrophoneConfig); has no chunk_ms field.
            _mic = MicrophoneEngine(
                bus=_SERVER_BUS,
                config=MicConfig(sample_rate=16_000),
            )

            # ── Noise calibration (one-shot at boot, non-blocking) ──────────
            # FIX 2: Constructor is (config: CalibratorConfig | None = None).
            # Method is .run() — no parameters. Duration is set in CalibratorConfig.
            try:
                _calibrator = NoiseCalibrator()
                _cal_result = _calibrator.run()
                log.info(
                    "Phase 3: noise calibration complete",
                    noise_floor=round(getattr(_cal_result, "noise_floor", 0.0), 4),
                    environment=getattr(_cal_result, "environment", "unknown"),
                )
            except Exception as _cal_exc:
                log.debug(f"Phase 3: noise calibration skipped ({_cal_exc})")

            # ── Hotword Detector ────────────────────────────────────────────
            # FIX 2: Pass _mic.audio_queue (the engine's real internal queue),
            # not a separately created _p3_audio_queue that was never wired in.
            _hotword = HotwordDetector(
                bus=_SERVER_BUS,
                audio_queue=_mic.audio_queue,
                config=HotwordConfig(use_livekit=True),
            )

            # ── Wake Listener ───────────────────────────────────────────────
            # FIX 3: WakeListener reads the primary queue for IDLE-phase ambient
            # listening. Pass _mic.audio_queue here, then also register its own
            # private _mic_audio_queue for fanout via subscribe_audio_queue().
            _wake_cfg = WakeListenerConfig(mode=VoiceMode.WAKE_WORD)
            _wake_listener = WakeListener(
                bus=_SERVER_BUS,
                audio_queue=_mic.audio_queue,
                config=_wake_cfg,
            )

            # Register WakeListener's own private queue for independent fanout —
            # this gives it every chunk without competing with HotwordDetector.
            if hasattr(_mic, "subscribe_audio_queue"):
                _mic.subscribe_audio_queue(_wake_listener._mic_audio_queue)

            # ── STT Router ──────────────────────────────────────────────────
            # Routes LISTENING_ENDED → shared STT_ENGINE → STT_TRANSCRIPTION_FINAL
            _stt_router = STTRouter(
                event_bus=_SERVER_BUS,
                engine=STT_ENGINE,
                groq_api_key=GROQ_KEY,
            )

            # ── TTS Router ──────────────────────────────────────────────────
            # FIX 4: kwarg is `default_engine`, not `engine`.
            _tts_router = _TTSRouter(
                event_bus=_SERVER_BUS,
                default_engine=TTS_ENGINE,
            )

            # ── Interrupt Detector ──────────────────────────────────────────
            _interrupt = InterruptDetector(event_bus=_SERVER_BUS)

            # ── Voice Coordinator ───────────────────────────────────────────
            VOICE_COORDINATOR = VoiceCoordinator(
                event_bus=_SERVER_BUS,
                tts_router=_tts_router,
                interrupt_detector=_interrupt,
            )

            # ── WakeWordManager (runtime enable/disable) ────────────────────
            WAKE_WORD_MANAGER = WakeWordManager(
                bus=_SERVER_BUS,
                mic=_mic,
                hotword_detector=_hotword,
                wake_listener=_wake_listener,
                config=CONFIG,
            )

            # ── Bridge: voice.utterance.received → call_ai() → voice.response.ready ──
            # VoiceCoordinator dispatches voice.utterance.received when STT completes.
            # This subscriber handles it: calls the existing call_ai() pipeline
            # (with memory context) and publishes voice.response.ready so
            # VoiceCoordinator drives TTS for the response.
            async def _handle_voice_utterance(event) -> None:
                payload = event.payload if hasattr(event, "payload") else event
                run_id  = payload.get("run_id", "")
                text    = payload.get("text", "").strip()
                lang    = payload.get("language", "en") or "en"
                if not text:
                    return
                try:
                    reply, provider = await call_ai("oracle", text)
                    log.info(f"Phase 3: voice AI response via {provider} ({len(reply)} chars)")
                    if METRICS_COLLECTOR is not None:
                        METRICS_COLLECTOR.increment("voice_pipeline_completions_total")
                    from kernel.event_bus.event_bus import Event as _Ev, Priority as _Pr
                    await _SERVER_BUS.publish(_Ev(
                        event_type="voice.response.ready",
                        source="server.voice_bridge",
                        payload={"run_id": run_id, "text": reply, "language": lang},
                        priority=_Pr.HIGH,
                    ))
                    # Also broadcast to any HUD WebSocket clients so the chat
                    # panel shows the voice conversation in real time.
                    await manager.broadcast({
                        "type": "chat_reply", "agent": "oracle",
                        "text": reply, "provider": provider,
                        "source": "voice_pipeline",
                    })
                    await manager.broadcast({
                        "type": "voice_utterance_ack",
                        "transcript": text, "reply": reply,
                        "language": lang, "provider": provider,
                    })
                except Exception as _ve:
                    log.warning(f"Phase 3: voice utterance handler error: {_ve}")

            _SERVER_BUS.subscribe("voice.utterance.received", _handle_voice_utterance)

            # ── Start everything ────────────────────────────────────────────
            await _stt_router.start()
            await _tts_router.start()
            await VOICE_COORDINATOR.start()

            # Start mic + hotword + wake listener via WakeWordManager
            _mic.start()
            WAKE_WORD_MANAGER.enable()

            # Register Phase 3 health check
            if HEALTH_MONITOR is not None:
                from observability.health.health_monitor import HealthCheck as _HC3
                def _check_voice_pipeline() -> bool:
                    return (
                        VOICE_COORDINATOR is not None
                        and getattr(VOICE_COORDINATOR, "_running", False)
                        and WAKE_WORD_MANAGER is not None
                        and WAKE_WORD_MANAGER.is_running()
                    )
                HEALTH_MONITOR.register(_HC3(
                    name="voice_pipeline",
                    check_fn=_check_voice_pipeline,
                    critical=False,
                ))
                await HEALTH_MONITOR.check_all()

            log.info(
                "Phase 3: always-listening voice pipeline online",
                hotword="hey jarvis",
                stt=STT_ENGINE.__class__.__name__ if STT_ENGINE else "None",
                tts=TTS_ENGINE.__class__.__name__ if TTS_ENGINE else "None",
            )

        except Exception as _p3_exc:
            log.warning(
                f"Phase 3: always-listening init failed (non-fatal, push-to-talk unaffected): {_p3_exc}",
                exc_info=True,
            )
            WAKE_WORD_MANAGER = None
            VOICE_COORDINATOR = None
    else:
        if JARVIS_ENABLE_ALWAYS_LISTENING:
            log.warning(
                "Phase 3: always-listening skipped — EventBus unavailable. "
                "Set JARVIS_ENABLE_ALWAYS_LISTENING=false to silence this."
            )
        else:
            log.info("Phase 3: always-listening disabled (JARVIS_ENABLE_ALWAYS_LISTENING=false)")

    # ── Phase 3 — VisionPipeline + ActivityObserver (feeds ProactiveEngine) ──
    # VisionPipeline captures screen frames and publishes perception.vision.*
    # events. ActivityObserver polls active windows, idle time, and processes;
    # publishes perception.activity.* events. ProactiveEngine (Phase 2) consumes
    # activity snapshots when the orchestrator is enabled. Both non-fatal standalone.
    ACTIVITY_OBSERVER = None
    VISION_PIPELINE = None

    if JARVIS_ENABLE_VISION_PIPELINE and _SERVER_BUS is not None:
        # ── VisionPipeline ─────────────────────────────────────────────────
        try:
            from perception.vision.vision_pipeline import VisionPipeline
            _model_router_for_vision = None
            try:
                from models.router.model_router import get_router as _get_mr_v
                _model_router_for_vision = _get_mr_v()
            except Exception:
                pass
            VISION_PIPELINE = VisionPipeline(
                event_bus=_SERVER_BUS,
                model_router=_model_router_for_vision,
                capture_interval=2.0,
                auto_capture=False,   # on-demand only; avoid continuous CPU load
            )
            await VISION_PIPELINE.start()

            if HEALTH_MONITOR is not None:
                from observability.health.health_monitor import HealthCheck as _HCV
                def _check_vision_pipeline() -> bool:
                    return VISION_PIPELINE is not None and getattr(VISION_PIPELINE, "_running", False)
                HEALTH_MONITOR.register(_HCV(
                    name="vision_pipeline",
                    check_fn=_check_vision_pipeline,
                    critical=False,
                ))
                await HEALTH_MONITOR.check_all()

            log.info("Phase 3: VisionPipeline started (auto_capture=False, on-demand only)")
        except Exception as _vp_exc:
            log.warning(f"Phase 3: VisionPipeline init failed (non-fatal): {_vp_exc}")
            VISION_PIPELINE = None

        # ── ActivityObserver ───────────────────────────────────────────────
        try:
            from perception.observation.activity_observer import ActivityObserver
            ACTIVITY_OBSERVER = ActivityObserver(
                event_bus=_SERVER_BUS,
                poll_interval=10.0,   # every 10 s — lightweight
                idle_threshold=60.0,
                track_processes=True,
            )
            await ACTIVITY_OBSERVER.start()

            # If ProactiveEngine is accessible via Orchestrator, subscribe it
            # to activity snapshots so it gets a live context signal.
            if ORCHESTRATOR is not None:
                try:
                    _proactive = getattr(ORCHESTRATOR, "_proactive_engine", None)
                    if _proactive is None:
                        _proactive = getattr(ORCHESTRATOR, "proactive_engine", None)

                    if _proactive is not None:
                        async def _on_activity_snapshot(event) -> None:
                            try:
                                payload = event.payload if hasattr(event, "payload") else event
                                _proactive.observe_decision(type("_D", (), {
                                    "score": 0.8, "confidence": "medium",
                                    "reasoning": str(payload.get("active_window", "")),
                                    "action": "activity_snapshot",
                                })())
                            except Exception:
                                pass
                        _SERVER_BUS.subscribe(
                            ActivityObserver.EVT_SNAPSHOT, _on_activity_snapshot
                        )
                        log.info("Phase 3: ActivityObserver → ProactiveEngine bridge active")
                except Exception as _pe_exc:
                    log.debug(f"Phase 3: ProactiveEngine bridge skipped ({_pe_exc})")

            log.info("Phase 3: ActivityObserver started (poll_interval=10s)")
        except Exception as _ao_exc:
            log.warning(f"Phase 3: ActivityObserver init failed (non-fatal): {_ao_exc}")
            ACTIVITY_OBSERVER = None
    prov: list[str] = []
    if GROQ_KEY:   prov.append("Groq ✓")
    if _qwen_openvino_enabled(): prov.append("Qwen-OpenVINO (local)")
    if GEMINI_KEY: prov.append("Gemini ✓")
    prov.append(f"Ollama/{OLLAMA_MODEL} (local fallback)")

    log.info("=" * 62)
    log.info("  J.A.R.V.I.S  HTML HUD  BACKEND  ONLINE")
    log.info(f"  WS/HTTP:   ws://{HOST}:{PORT}/ws")
    log.info(f"  AI:        {' → '.join(prov)}")
    log.info(f"  STT:       Groq Whisper → faster-whisper/{FASTER_WHISPER_MODEL}")
    log.info(f"  TTS:       edge-tts → Kokoro ONNX")
    log.info(f"  Memory:    {MEMORY_DB}")
    log.info("=" * 62)


# ── Phase 3 — Graceful shutdown (updated from Phase 2) ───────────────────────
async def on_shutdown():
    """
    Gracefully stop all phased subsystems on server exit.
    Phase 3 components (voice pipeline, vision, activity observer) are stopped
    first, then Phase 2 (Orchestrator), then Phase 1 (Action Guard).
    All subsystems are non-fatal — errors are logged and shutdown continues.
    """
    global ACTION_GUARD, ORCHESTRATOR
    global WAKE_WORD_MANAGER, VOICE_COORDINATOR, ACTIVITY_OBSERVER, VISION_PIPELINE

    # ── Phase 3: always-listening voice pipeline ─────────────────────────────
    if ACTIVITY_OBSERVER is not None:
        try:
            await ACTIVITY_OBSERVER.stop()
            log.info("Phase 3: ActivityObserver stopped")
        except Exception as exc:
            log.warning(f"Phase 3: ActivityObserver stop() raised (non-fatal): {exc}")
        ACTIVITY_OBSERVER = None

    if VISION_PIPELINE is not None:
        try:
            await VISION_PIPELINE.stop()
            log.info("Phase 3: VisionPipeline stopped")
        except Exception as exc:
            log.warning(f"Phase 3: VisionPipeline stop() raised (non-fatal): {exc}")
        VISION_PIPELINE = None

    if VOICE_COORDINATOR is not None:
        try:
            await VOICE_COORDINATOR.stop()
            log.info("Phase 3: VoiceCoordinator stopped")
        except Exception as exc:
            log.warning(f"Phase 3: VoiceCoordinator stop() raised (non-fatal): {exc}")
        VOICE_COORDINATOR = None

    if WAKE_WORD_MANAGER is not None:
        try:
            WAKE_WORD_MANAGER.disable()
            log.info("Phase 3: WakeWordManager disabled")
        except Exception as exc:
            log.warning(f"Phase 3: WakeWordManager disable() raised (non-fatal): {exc}")
        WAKE_WORD_MANAGER = None

    # ── Phase 1: Safety & Action Layer ───────────────────────────────────────
    # FIX 7: was missing the `if ACTION_GUARD is not None:` guard, which caused
    # a crash at shutdown when ACTION_GUARD was never initialised.
    if ACTION_GUARD is not None:
        try:
            await ACTION_GUARD.stop()
            log.info("Phase 1: Safety & Action Layer shut down cleanly")
        except Exception as exc:
            log.warning(f"Phase 1: ActionGuard stop() raised (non-fatal): {exc}")
        ACTION_GUARD = None

    # ── Phase 2: Orchestrator ─────────────────────────────────────────────────
    if ORCHESTRATOR is not None:
        try:
            await ORCHESTRATOR.stop()
            log.info("Phase 2: Orchestrator shut down cleanly")
        except Exception as exc:
            log.warning(f"Phase 2: Orchestrator stop() raised (non-fatal on shutdown): {exc}")
        ORCHESTRATOR = None


