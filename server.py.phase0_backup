def _env_flag(name: str, default: bool = True) -> bool:
    """Shared on/off switch for the optional Phase-0 subsystems below.
    Every new integration in this phase is gated by one of these so any
    piece can be disabled instantly (without a code change) if it
    misbehaves — set the named env var to "0"/"false"/"no" to turn it off.
    """
    raw = os.getenv(name)
    if raw is None:
        return default
    return raw.strip().lower() not in ("0", "false", "no")


