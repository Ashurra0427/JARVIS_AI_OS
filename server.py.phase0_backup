def apply_settings(settings: dict[str, Any]) -> None:
    """
    Apply settings pushed from the SettingsPanel.
    Persists to datastore/ui_settings.json and updates runtime knobs that
    server.py itself cares about (voice, default agent, TTS voice, etc.)
    """
    RUNTIME_SETTINGS.update(settings or {})
    try:
        SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS_PATH.write_text(json.dumps(RUNTIME_SETTINGS, indent=2), encoding="utf-8")
    except Exception as e:
        log.warning(f"Failed to persist settings: {e}")

    voice = (settings or {}).get("voice", {})
    if "tts_voice" in voice:
        # tts_voice is an explicit edge-tts voice id override (e.g.
        # "en-US-AndrewMultilingualNeural"). synthesize_speech() reads it
        # from RUNTIME_SETTINGS at call time and, if set, uses it instead
        # of the language-based automatic voice selection.
        pass

    # Settings panel's "Ollama → Fallback Model" picker maps directly to
    # ModelRouter's emergency_model tier (the safety-net used when both
    # Groq and Gemini fail — see model_router.py's v4.0 docstring). Make
    # the setting live instead of inert: push it straight to the router's
    # emergency provider. Scheduled as a background task (rather than
    # awaited here) because apply_settings() is called synchronously from
    # both a WS handler and a REST endpoint, and switch_model() can take
    # up to ~90s on a cold model load — that shouldn't block the settings
    # save/ack round-trip.
    ollama_settings = (settings or {}).get("ollama", {})
    fallback_model = (ollama_settings or {}).get("fallback_model", "")
    if fallback_model:
        async def _apply_emergency_model(model: str) -> None:
            try:
                from models.router.model_router import get_router
                router = get_router()
                if model == getattr(router, "_emergency_model", None):
                    return
                ok = await router._emergency_provider.switch_model(model)
                if ok:
                    router._emergency_model = model
                    log.info(f"Emergency model updated from settings: {model}")
                else:
                    log.warning(f"Emergency model switch failed (not pulled?): {model}")
            except Exception as exc:
                log.warning(f"Failed to apply emergency model setting: {exc}")

        try:
            asyncio.create_task(_apply_emergency_model(fallback_model))
        except RuntimeError:
            # No running event loop (e.g. called outside an async context) —
            # the setting is still persisted above; it'll take effect once
            # something else triggers a switch, or on next boot.
            log.debug("apply_settings: no running loop — emergency model update deferred")

    log.info(f"Settings updated: {list((settings or {}).keys())}")


