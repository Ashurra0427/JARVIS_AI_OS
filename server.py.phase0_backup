_net_prev    = psutil.net_io_counters()
_net_prev_ts = time.time()


def get_metrics() -> dict:
    global _net_prev, _net_prev_ts
    now = time.time()
    dt  = max(now - _net_prev_ts, 0.1)
    net_cur = psutil.net_io_counters()
    up_bps  = (net_cur.bytes_sent - _net_prev.bytes_sent) / dt
    dn_bps  = (net_cur.bytes_recv - _net_prev.bytes_recv) / dt
    _net_prev    = net_cur
    _net_prev_ts = now

    def fmt_speed(bps: float) -> str:
        if bps < 1024:    return f"{bps:.0f} B/s"
        if bps < 1024**2: return f"{bps/1024:.1f} KB/s"
        return f"{bps/1024**2:.1f} MB/s"

    cpu_pct = psutil.cpu_percent(interval=None)
    cpu_per = psutil.cpu_percent(interval=None, percpu=True)
    mem     = psutil.virtual_memory()
    disk    = psutil.disk_usage("/")
    temps   = {}
    try:
        t = psutil.sensors_temperatures()
        for key in ("coretemp", "cpu_thermal", "k10temp", "acpitz"):
            if key in t and t[key]:
                temps["cpu"] = t[key][0].current
                break
    except Exception:
        pass

    bat = None
    try:
        b = psutil.sensors_battery()
        if b:
            bat = {"percent": b.percent, "power_plugged": b.power_plugged}
    except Exception:
        pass

    cores = cpu_per[:4] if cpu_per else [cpu_pct] * 4
    while len(cores) < 4:
        cores.append(0.0)

    return {
        "cpu":       round(cpu_pct, 1),
        "cpu_cores": [round(c, 1) for c in cores],
        "ram_pct":   round(mem.percent, 1),
        "ram_used":  round(mem.used / 1024**3, 2),
        "ram_total": round(mem.total / 1024**3, 2),
        "disk_pct":  round(disk.percent, 1),
        "disk_used": round(disk.used / 1024**3, 1),
        "disk_total":round(disk.total / 1024**3, 1),
        "net_up":    fmt_speed(up_bps),
        "net_dn":    fmt_speed(dn_bps),
        "temp_cpu":  temps.get("cpu"),
        "battery":   bat,
        "ts":        now,
    }


def get_diagnostics() -> dict:
    # Phase 2: include orchestrator state so `curl /diagnostics` shows live agent info.
    _orch_info: dict = {"enabled": JARVIS_ENABLE_ORCHESTRATOR, "status": "not loaded"}
    if ORCHESTRATOR is not None:
        try:
            _orch_info["status"] = "online"
            _orch_info["agents"] = list(ORCHESTRATOR.agents.keys())
            _orch_info["agent_count"] = len(ORCHESTRATOR.agents)
        except Exception:
            _orch_info["status"] = "error"

    # Phase 1: action guard snapshot
    _p1_info: dict = {"enabled": JARVIS_ENABLE_ACTION_GUARD, "status": "not loaded"}
    if ACTION_GUARD is not None:
        try:
            _p1_info = ACTION_GUARD.health_snapshot()
            _p1_info["status"] = "online"
        except Exception:
            _p1_info["status"] = "error"

    return {
        "os":        platform.system() + " " + platform.release(),
        "hostname":  platform.node(),
        "python":    platform.python_version(),
        "cpu_name":  platform.processor() or "Unknown CPU",
        "cpu_count": psutil.cpu_count(logical=True),
        "uptime":    int(time.time() - psutil.boot_time()),
        "pid":       os.getpid(),
        "action_guard": _p1_info,
        "orchestrator": _orch_info,
    }


