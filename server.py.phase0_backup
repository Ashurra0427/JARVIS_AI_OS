# ═══════════════════════════════════════════════════════════════════════════════
# This used to be a second, independent implementation (Groq Whisper call +
# faster-whisper call, hand-rolled here). It's now a thin wrapper around the
# single shared STT_ENGINE instance created in on_startup() — see the
# module-level docstring near STT_ENGINE/TTS_ENGINE above for why.

async def transcribe_audio(audio_bytes: bytes, mime: str = "audio/webm") -> tuple[str, str]:
    """STT via the shared STTEngine. Returns (text, detected_language)."""
    if STT_ENGINE is None:
        log.error("STT_ENGINE not initialised — cannot transcribe")
        return "", "en"
    text, lang, _confidence = await asyncio.to_thread(
        STT_ENGINE.transcribe_blob, audio_bytes, mime
    )
    return text, lang


