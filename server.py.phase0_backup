def _install_shutdown_diagnostics():
    """
    Log exactly which OS signal triggered a shutdown, and dump all thread
    stacks at that instant. uvicorn's default signal handler just sets an
    internal should_exit flag and prints 'Shutting down' — it never tells
    you *why*. This wraps the handler so the cause is visible in the log
    instead of looking like a silent/unexplained exit.
    """
    import sys
    import signal as _signal
    import traceback as _traceback
    import faulthandler as _faulthandler

    _SIGNAL_NAMES = {
        getattr(_signal, n): n
        for n in dir(_signal)
        if n.startswith("SIG") and not n.startswith("SIG_")
    }

    def _handler(signum, frame):
        name = _SIGNAL_NAMES.get(signum, str(signum))
        log.warning(f"Shutdown signal received: {name} ({signum}) — dumping thread stacks for diagnosis")
        try:
            _faulthandler.dump_traceback(file=sys.stdout)
        except Exception:
            log.warning("Thread stack dump:\n" + "".join(_traceback.format_stack(frame)))
        # Re-raise the default behavior uvicorn/Python expects.
        raise KeyboardInterrupt()

    for sig in (_signal.SIGINT, _signal.SIGTERM):
        try:
            _signal.signal(sig, _handler)
        except (ValueError, OSError):
            pass  # not available on this platform/thread

    # CTRL_CLOSE_EVENT / CTRL_LOGOFF_EVENT / CTRL_SHUTDOWN_EVENT (Windows only):
    # these fire when the *console window* closes, the user logs off, or the
    # OS shuts down — none of which are a normal Ctrl+C. Windows delivers
    # these via a separate console control handler, not via signal.signal().
    if sys.platform == "win32":
        try:
            import ctypes

            _CTRL_NAMES = {
                0: "CTRL_C_EVENT",
                1: "CTRL_BREAK_EVENT",
                2: "CTRL_CLOSE_EVENT (console window closed)",
                5: "CTRL_LOGOFF_EVENT (user logged off)",
                6: "CTRL_SHUTDOWN_EVENT (OS shutting down)",
            }

            @ctypes.WINFUNCTYPE(ctypes.c_int, ctypes.c_uint)
            def _win_console_handler(ctrl_type):
                log.warning(
                    f"Windows console control event received: "
                    f"{_CTRL_NAMES.get(ctrl_type, ctrl_type)} — this is what is killing the process, "
                    f"not application code."
                )
                return False  # let default handling continue (don't block OS shutdown)

            ctypes.windll.kernel32.SetConsoleCtrlHandler(_win_console_handler, True)
            # Keep a reference alive so it isn't garbage-collected.
            _install_shutdown_diagnostics._win_handler_ref = _win_console_handler
        except Exception as exc:
            log.warning(f"Could not install Windows console control handler: {exc}")


if __name__ == "__main__":
    _install_shutdown_diagnostics()
    uvicorn.run(
        "server:app",
        host=HOST,
        port=PORT,
        log_level="info",
        reload=False,
    )