class MemoryStore:
    def __init__(self, path: Path):
        self.path = path
        self._data: dict[str, Any] = {"episodes": [], "semantic": {}}
        self._lock = asyncio.Lock()  # guards concurrent async writes
        self._load()

    def _load(self):
        if self.path.exists():
            try:
                self._data = json.loads(self.path.read_text())
            except Exception:
                pass

    def _save(self):
        # Write to a temp file then rename for atomic replacement
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self._data, indent=2))
        tmp.replace(self.path)

    async def add_episode(self, role: str, agent: str, content: str):
        async with self._lock:
            ep = {
                "id": str(uuid.uuid4())[:8],
                "ts": time.time(),
                "role": role,
                "agent": agent,
                "content": content[:400],
            }
            self._data["episodes"].append(ep)
            if len(self._data["episodes"]) > 200:
                self._data["episodes"] = self._data["episodes"][-200:]
            self._save()
            return ep

    async def store_semantic(self, key: str, value: str):
        async with self._lock:
            self._data["semantic"][key] = {"value": value, "ts": time.time()}
            self._save()

    def recall_recent(self, n: int = 10) -> list[dict]:
        return self._data["episodes"][-n:]

    def recall_semantic(self, query: str) -> list[tuple[str, str]]:
        q = query.lower()
        return [(k, v["value"]) for k, v in self._data["semantic"].items()
                if q in k.lower() or q in v["value"].lower()]

    def stats(self) -> dict:
        return {
            "episodes": len(self._data["episodes"]),
            "semantic": len(self._data["semantic"]),
        }


