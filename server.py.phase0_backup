@app.get("/security/audit")
async def security_audit_endpoint(
    requester: str = "",
    action_type: str = "",
    allowed: str = "",
    limit: int = 100,
):
    """
    Phase 1: Query the in-memory permission audit log.
    Optional filters: requester, action_type, allowed (true/false).
    """
    if ACTION_GUARD is None or ACTION_GUARD.permission_manager is None:
        return JSONResponse({"error": "PermissionManager not initialized"}, status_code=503)
    pm = ACTION_GUARD.permission_manager
    _allowed: bool | None = None
    if allowed.lower() == "true":
        _allowed = True
    elif allowed.lower() == "false":
        _allowed = False
    records = pm.get_audit_log(requester=requester or None, limit=limit)
    if _allowed is not None:
        records = [r for r in records if r.get("allowed") == _allowed]
    if action_type:
        records = [r for r in records if r.get("action_type") == action_type]
    return JSONResponse({"count": len(records), "records": records})


