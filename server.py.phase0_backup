@app.get("/api/model/presets")
async def model_presets_endpoint():
    """
    Phase 4: Local model presets for the HUD model picker.

    These are NOT separate router providers — the router owns exactly one
    OllamaProvider (see model_router.py design rule 3). Each preset is a
    tuned-defaults config (tag/temperature/timeout/description) for an
    Ollama tag the HUD can quick-select. Activating one is just:

        ModelSwitcher.switch("ollama", presets[name]["tag"])

    Returns the `local_model_presets` dict from config/models.yaml so the
    picker can render buttons without Ollama needing to be running yet.
    Falls back to reading the YAML directly if ConfigManager (Phase 0) is
    disabled or failed to load.
    """
    presets: dict = {}
    if CONFIG is not None:
        try:
            presets = CONFIG.get("local_model_presets", {}) or {}
        except Exception as exc:
            log.warning("model_presets: ConfigManager.get failed, falling back to YAML", error=str(exc))

    if not presets:
        try:
            import yaml
            with open("config/models.yaml") as fh:
                presets = (yaml.safe_load(fh) or {}).get("local_model_presets", {}) or {}
        except Exception as exc:
            return JSONResponse({"error": f"Could not load presets: {exc}"}, status_code=500)

    return JSONResponse({"presets": presets})

