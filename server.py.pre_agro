#!/usr/bin/env python3
# ── Ensure the project root is always on sys.path ─────────────────────────────
# Required on Windows (and some venv setups) where CWD is not automatically
# added to sys.path when running `python server.


from __future__ import annotations



import sys as _sys, pathlib as _pathlib
_PROJECT_ROOT = str(_pathlib.Path(__file__).resolve().parent)
if _PROJECT_ROOT not in _sys.path:
    _sys.path.insert(0, _PROJECT_ROOT)
# ──────────────────────────────────────────────────────────────────────────────

# ── Phase 2.6: fail-fast Python version check + 3.13 compat shim ──────────────
# Must run before any other JARVIS import: modules like wakeword/manager.py,
# perception/speech/hotword.py, and perception/speech/microphone.py import
# `audioop`, which Python 3.13 removed. start.py already enforces this same
# floor (3.10+, warn-and-shim on 3.13+) via its own check_python_version()/
# EnvCheck for the `python start.py` launch path; this block exists because
# server.py can also be launched directly (`python server.py` or
# `uvicorn server:app`), bypassing start.py's check entirely. It reuses the
# exact same compat shim start.py installs rather than inventing a second,
# competing implementation — see perception/speech/compat_313.py for what is
# and isn't covered.
if _sys.version_info < (3, 10):
    _v = _sys.version_info
    _sys.stderr.write(
        f"FATAL: JARVIS AI OS requires Python 3.10+ — found {_v.major}.{_v.minor}.{_v.micro}.\n"
        "Install Python 3.10, 3.11, or 3.12 (3.13+ also works, via an audioop/cgi "
        "compatibility shim) and re-run.\n"
    )
    _sys.exit(1)
elif _sys.version_info >= (3, 13):
    try:
        from perception.speech.compat_313 import install as _install_compat_313
        _install_compat_313()
    except ImportError:
        # Surface this loudly now rather than letting a much harder-to-
        # diagnose `ModuleNotFoundError: audioop` happen later, deep inside
        # a wakeword/STT import triggered by an unrelated user action.
        _v = _sys.version_info
        _sys.stderr.write(
            f"WARNING: Python {_v.major}.{_v.minor} detected and "
            "perception/speech/compat_313.py (audioop/cgi shim) could not be "
            "imported. Voice features that depend on the removed audioop "
            "module may fail.\n"
        )
# ──────────────────────────────────────────────────────────────────────────────
"""
J.A.R.V.I.S  HTML HUD  ─  Backend Server
==========================================
Architecture
------------
  ┌─────────────────────────────────┐
  │   jarvis.html  (HUD in browser) │
  └──────────┬──────────────────────┘
             │ WebSocket  ws://0.0.0.0:7788/ws
             │ HTTP       http://0.0.0.0:7788
  ┌──────────▼──────────────────────┐
  │   server.py  (THIS FILE)        │
  │   ─ FastAPI + uvicorn           │
  │   ─ Real-time system metrics    │
  │   ─ AI: Groq → Qwen-OVINO →     │
  │      Gemini → Ollama (4-tier)   │
  │      (qwen2.5:1.5b local)       │
  │   ─ STT: Groq Whisper →         │
  │      faster-whisper (local)     │
  │   ─ TTS: edge-tts →             │
  │      Kokoro ONNX (local)        │
  │   ─ Memory (JSON + in-proc)     │
  │   ─ File / terminal tools       │
  └─────────────────────────────────┘

Install
-------
  pip install fastapi "uvicorn[standard]" websockets psutil groq \
              google-generativeai edge-tts aiohttp python-dotenv \
              faster-whisper

  # For Kokoro ONNX TTS (optional local fallback):
  pip install kokoro-onnx soundfile numpy

  # Ollama must be running locally with the model pulled:
  #   ollama pull qwen2.5:1.5b

Environment (.env or shell)
---------------------------
  GROQ_API_KEY=...
  GEMINI_API_KEY=...
  JARVIS_PORT=7788        (optional, default 7788)
  OLLAMA_HOST=http://localhost:11434   (optional)
  KOKORO_MODEL=kokoro-v1.0.onnx      (optional, path or filename)
  KOKORO_VOICES=voices-v1.0.bin            (optional, path or filename)
  FASTER_WHISPER_MODEL=base           (optional: tiny/base/small/medium)
"""

import asyncio
import base64
import io
import json
import logging
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Any

# ── Windows UTF-8 fix ──────────────────────────────────────────────────────
# By default Windows opens stdout/stderr with the legacy console codepage
# (e.g. CP1252), which raises UnicodeEncodeError for any character outside
# that page (arrows, checkmarks, emoji). Setting PYTHONUTF8=1 at the
# process level and reconfiguring both streams here ensures all logging
# output (including daily_summary lines with '→') is encoded as UTF-8.
# This must happen before any logging is initialised.
if sys.platform == "win32":
    os.environ.setdefault("PYTHONUTF8", "1")
    for _stream in (sys.stdout, sys.stderr):
        if hasattr(_stream, "reconfigure"):
            try:
                _stream.reconfigure(encoding="utf-8", errors="backslashreplace")
            except Exception:
                pass
import psutil
import uvicorn
from contextlib import asynccontextmanager
from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse, FileResponse, HTMLResponse
from dotenv import load_dotenv

load_dotenv()


def _env_flag(name: str, default: bool = True) -> bool:
    """Shared on/off switch for the optional Phase-0 subsystems below.
    Every new integration in this phase is gated by one of these so any
    piece can be disabled instantly (without a code change) if it
    misbehaves — set the named env var to "0"/"false"/"no" to turn it off.
    """
    raw = os.getenv(name)
    if raw is None:
        return default
    return raw.strip().lower() not in ("0", "false", "no")


def _env_float(name: str, default: float) -> float:
    """Numeric counterpart to _env_flag, for tunable timeouts/limits."""
    raw = os.getenv(name)
    if raw is None:
        return default
    try:
        return float(raw)
    except ValueError:
        # Module-level `log` isn't configured yet this early in startup —
        # use stdlib logging directly rather than risk an AttributeError on
        # a still-None `log`.
        import logging as _stdlib_logging
        _stdlib_logging.getLogger("jarvis.server").warning(
            f"{name}={raw!r} is not a valid float — using default {default}"
        )
        return default


# ── Suppress noisy third-party library logs ───────────────────────────────────
# httpx logs every HEAD request SentenceTransformers makes to HuggingFace.
# transformers logs a benign "UNEXPECTED key" weight note on every ST load.
# These are normal and expected — suppress to WARNING to keep server output clean.
import logging as _logging
for _lib in (
    "httpx", "httpcore", "httpcore.http11",
    "sentence_transformers", "sentence_transformers.base.model",
    "transformers", "transformers.modeling_utils",
    "huggingface_hub", "huggingface_hub.file_download",
    "huggingface_hub.utils._validators",
    "filelock",
):
    _logging.getLogger(_lib).setLevel(_logging.WARNING)

# ── Centralized Config (Phase 0 — config/settings.py) ──────────────────────────
# ConfigManager layers config/*.yaml + JARVIS_SECTION__KEY env vars into one
# typed object. The existing os.getenv() constants further down in this file
# are LEFT ALONE on purpose (they're the provider keys / ports / model names
# that already work) — STATE.config is only consulted by the new Phase-0 pieces
# below (logging, health monitor) so nothing currently working can regress
# even if this fails to load.
JARVIS_ENABLE_CONFIG_MANAGER = _env_flag("JARVIS_ENABLE_CONFIG_MANAGER", True)
# Phase 0 — observability/health/health_monitor.py + observability/metrics/metrics_collector.py.
# Declared up here (with the other Phase-0 flags) even though they're only
# consumed inside on_startup(), so every subsystem flag for this phase lives
# in one place and .env.example stays easy to keep in sync.
JARVIS_ENABLE_HEALTH_MONITOR = _env_flag("JARVIS_ENABLE_HEALTH_MONITOR", True)
JARVIS_ENABLE_METRICS_COLLECTOR = _env_flag("JARVIS_ENABLE_METRICS_COLLECTOR", True)

# ── Phase 1 — Safety & Action Layer ───────────────────────────────────────────
# JARVIS_ENABLE_ACTION_GUARD=true  → wires PolicyEngine + PermissionManager +
#   ActionGuard as a mandatory checkpoint inside ToolRegistry.invoke(), so every
#   tool call (not just terminal/code ones) passes through a policy check before
#   executing.  Also starts TerminalManager (replaces raw subprocess.run in
#   system_tools) and FileManager (enforces path sandboxing for file_tools).
#   Deny-by-default for destructive actions; allow-by-default for safe reads.
#   Set to "false" to disable the entire layer; behaviour reverts to pre-Phase-1.
JARVIS_ENABLE_ACTION_GUARD: bool = _env_flag("JARVIS_ENABLE_ACTION_GUARD", True)

# ── Phase 2 — Cognition & Multi-Agent Execution ────────────────────────────────
# JARVIS_ENABLE_ORCHESTRATOR=true   → starts the Kernel Orchestrator with all
#   specialized agent classes (ResearchAgent, EngineeringAgent, …) and the
#   full cognition pipeline (ReasoningEngine → DecisionEngine → PlanningEngine).
#   Chat requests that match a specialist agent are routed through the real
#   agent rather than a prompt-engineered single LLM call.
#   Set to "false" (or leave unset) to keep pre-Phase-2 behaviour unchanged.
#
# Phase 3.6 — explicit decision: KEEP THIS OPT-IN (default False) for now.
#
# As of Phase 3.5, the bridge itself is no longer the problem: 3.1 fixed the
# event-name/payload mismatch, 3.2 fixed the session-isolation no-op and gave
# every "user.reply" a real session_id, 3.3 added a fast path so trivial
# messages don't pay the full-plan latency cost, 3.4 re-tuned the reply
# timeout against that fast path, and 3.5 confirmed the cognition layer's
# memory wiring (and fixed a real degraded-memory-router bug found along the
# way). The bridge is correct. That is necessary but not sufficient to flip
# a default that changes behaviour for every deployment of this server, not
# just one developer who opts in.
#
# Reasons it stays False by default:
#   1. Phase 8 (validate and harden all 7 specialist agents) has not run yet.
#      Enabling this flag by default puts ResearchAgent, EngineeringAgent,
#      AnalysisAgent, PlanningAgent, CommunicationAgent, AutomationAgent, and
#      VisionAgent into the default request path for every user before any
#      of them have been individually validated under this roadmap.
#   2. Phase 11 (test coverage) has not run yet either. There is currently no
#      regression test for the bridge this phase just fixed, no test per
#      specialist agent, and no test exercising concurrent-session isolation
#      end-to-end — only test_goal_manager.py exists in tests/ for any part
#      of this pipeline. A behavioural default this size should not ship
#      ahead of the tests that would catch a silent regression in it.
#   3. The full-plan path (anything _is_simple_qa() in coordinator_agent.py
#      decides isn't trivial) still runs ReasoningEngine → DecisionEngine →
#      PlanningEngine → N agent dispatches → plan completion before a reply
#      is emitted. That is strictly more moving parts, per request, than the
#      pre-Phase-2 single call_ai() completion it would replace by default —
#      an acceptable cost for an opt-in capability, not yet proven out as the
#      right default latency/reliability trade for 100% of traffic.
#
# What would flip this decision: Phase 8's hardening pass landing clean, plus
# Phase 11 adding the regression test for this bridge and a smoke test per
# specialist agent (both explicitly scoped in Phase 11's acceptance check).
# At that point flipping the default to True is the roadmap's stated end
# goal, not a re-open of this decision — re-evaluate then, not before.
JARVIS_ENABLE_ORCHESTRATOR = _env_flag("JARVIS_ENABLE_ORCHESTRATOR", False)

# JARVIS_ORCH_REPLY_TIMEOUT_S — how long server.py waits for a "user.reply"
# event before giving up on the orchestrator and falling back to call_ai().
#
# Phase 3.4 retune: previously hardcoded at 30.0s, tuned blind (the bridge
# was broken end-to-end at the time — see Phase 3.1/3.2 — so the old value
# was never actually exercised against real latency). Now that 3.1-3.3 land:
#   - Phase 3.3's fast path answers simple messages with a single completion
#     call and returns almost immediately — it does not depend on this
#     timeout at all, since it never goes through submit_intent()/wait_for().
#   - Requests that DO reach this wait are, by construction, the ones
#     _is_simple_qa() decided need full ReasoningEngine → DecisionEngine →
#     PlanningEngine → multi-agent execution. That path is inherently slower
#     than a single completion, so raising the ceiling (vs. the old 30s)
#     reduces false-timeout-into-call_ai() fallback for legitimately
#     multi-step requests, without slowing down simple ones (which no longer
#     hit this code path).
#   - 45.0s is a starting point, not a measured value — this sandbox has no
#     live orchestrator to profile. Re-tune against real observed plan
#     completion latency once this runs against production traffic; this is
#     explicitly called out as unfinished tuning, not a final number.
JARVIS_ORCH_REPLY_TIMEOUT_S = _env_float("JARVIS_ORCH_REPLY_TIMEOUT_S", 45.0)

# ── Phase 3 — Perception Expansion ────────────────────────────────────────────
# JARVIS_ENABLE_ALWAYS_LISTENING=true  → starts the always-on wake-word chain:
#   MicrophoneEngine → NoiseCalibrator → HotwordDetector → WakeListener →
#   VoiceCoordinator → STTRouter → TTSRouter + InterruptDetector.
#   Runs ALONGSIDE the existing push-to-talk path — PTT and text-chat are
#   UNCHANGED when this flag is off (default).  Set to "false" to keep
#   push-to-talk only and skip all mic hardware init.
JARVIS_ENABLE_ALWAYS_LISTENING = _env_flag("JARVIS_ENABLE_ALWAYS_LISTENING", False)

# JARVIS_ENABLE_VISION_PIPELINE=true  → wires the real VisionPipeline +
#   ActivityObserver. VisionPipeline publishes perception.vision.* events;
#   ActivityObserver polls active windows/idle/processes and feeds ProactiveEngine
#   when Phase 2 Orchestrator is active.
#   Default: true — vision tools already call perception.vision internally.
JARVIS_ENABLE_VISION_PIPELINE = _env_flag("JARVIS_ENABLE_VISION_PIPELINE", True)

# ── Centralized application state (Phase 2 — stability hardening, 2.2) ────────
# All subsystem singletons that used to be scattered module-level globals
# (STATE.tool_registry, STATE.memory_router, STATE.stt_engine, STATE.action_guard, STATE.orchestrator, etc.)
# now live as attributes on one AppState instance. Every later phase reads/
# writes shared state through STATE.<attr> instead of a `global X` statement,
# so there is exactly one place that defines "what subsystems exist and what
# state they're in."
#
# Mutating an attribute on STATE (e.g. `STATE.memory_router = router`) does
# NOT require a `global` declaration inside a function, because STATE itself
# is never reassigned — only its attributes are. This is what eliminates the
# dozen-plus `global X, Y, Z` boilerplate lines that used to open on_startup()
# and on_shutdown().
#
# Scope note: a handful of unrelated module-level globals (_qwen_ov_provider,
# _last_provider, _net_prev/_net_prev_ts, model_switcher, _ngrok_tunnel_url)
# are narrowly-scoped, single-function caches rather than cross-subsystem
# singletons, and are intentionally left as-is rather than folded into
# AppState — consolidating them here would not reduce the scattered-global
# problem this refactor targets.
class AppState:
    """Single owner of every cross-request subsystem singleton in server.py."""

    def __init__(self) -> None:
        # ── Centralized config (config/settings.py) ─────────────────────────
        self.config: Any = None  # ConfigManager instance, or None if disabled/failed to load

        # ── Tool Registry + MemoryRouter bridge ──────────────────────────────
        # These give the HUD real browser automation (browser.*/web.* tools) and
        # a real semantic/episodic/vector memory backend.
        self.tool_registry: Any = None
        self.memory_router: Any = None
        self.task_planner: Any = None
        self.browser_tools: Any = None  # P-12: Playwright BrowserTools singleton

        # ── New integrated subsystems ────────────────────────────────────────
        self.acknowledgement_engine: Any = None  # backchannel filler-phrase TTS
        self.daily_summary: Any = None           # daily event aggregator / compressor
        self.embedding_service: Any = None       # text embedding service (ST → API → TF-IDF)

        # ── Shared in-process EventBus + canonical voice engines ────────────
        # stt_engine / tts_engine are real instances of the canonical
        # perception/speech/stt.py + perception/voice/tts.py classes, created
        # once in on_startup() and shared by every WebSocket connection.
        self.server_bus: Any = None
        self.stt_engine: Any = None
        self.tts_engine: Any = None

        # ── Phase 5.3 — shared LiveSTT instance ──────────────────────────────
        # perception/speech/live_stt.py's LiveSTT — streaming partial
        # transcription for the chat-workspace mic button. ONE shared
        # instance for the whole process (see the instantiation site in
        # on_startup() for the explicit single-shared-instance vs.
        # per-connection decision and rationale — Phase 5.5).
        self.live_stt: Any = None

        # ── Phase 5.4 — active live-stt session + per-connection forwarders ──
        # Because STATE.live_stt is a SINGLE shared instance (Phase 5.5), its
        # audio buffer and emitted VoiceEvent.STT_TRANSCRIPTION_PARTIAL events
        # carry no session_id — LiveSTT itself has no notion of "whose audio
        # is this", since at most one connection's chunks are ever flowing
        # into it at a time by construction. live_stt_active_session tracks
        # which (ws, session_id) pair most recently sent "live_stt_start"
        # (and hasn't sent "live_stt_stop" or disconnected since) — the
        # forwarder below delivers partials ONLY to that connection. This
        # gives correct single-speaker isolation (exactly one connection
        # ever receives partials at a time) but is NOT genuine multi-user
        # isolation: if a second connection starts live STT while a first
        # is still active, the shared LiveSTT buffer mixes both speakers'
        # audio regardless of which connection partials get forwarded to.
        # live_stt_forwarders maps ws -> the exact handler closure subscribed
        # for that connection, so it can be unsubscribed by identity on stop
        # or disconnect (EventBus.unsubscribe compares handler identity).
        self.live_stt_active_session: tuple[Any, str] | None = None  # (ws, session_id) or None
        self.live_stt_forwarders: dict[Any, Any] = {}  # ws -> subscribed handler closure

        # ── Phase 0 observability ────────────────────────────────────────────
        self.health_monitor: Any = None     # observability/health/health_monitor.py — real /health checks
        self.metrics_collector: Any = None  # observability/metrics/metrics_collector.py — real /metrics counters

        # ── Phase 1 — Safety & Action Layer ──────────────────────────────────
        self.action_guard: Any = None  # actions/security/security_integration.py singleton

        # ── Phase 2 — Kernel Orchestrator (multi-agent cognitive layer) ──────
        # None when JARVIS_ENABLE_ORCHESTRATOR=false (default). When enabled,
        # this is the single Orchestrator instance that owns all specialist
        # agents. It shares server_bus, memory_router, tool_registry, and the
        # model router with the rest of server.py — no second copies of any.
        self.orchestrator: Any = None

        # ── Phase 3 — Perception Expansion ───────────────────────────────────
        # Always-listening voice pipeline components. All None when
        # JARVIS_ENABLE_ALWAYS_LISTENING=false (default). When enabled, they
        # share server_bus and stt_engine/tts_engine — no second copies.
        self.wake_word_manager: Any = None    # wakeword/manager.py — runtime enable/disable
        self.voice_coordinator: Any = None    # perception/speech/voice_coordinator.py
        # Phase 10.2: stored so the WS push-to-talk TTS path can call
        # begin_monitoring() / stop_monitoring() for barge-in support,
        # without needing the always-listening pipeline to be active.
        self.interrupt_detector: Any = None   # perception/speech/interrupt_detector.py
        self.activity_observer: Any = None    # perception/observation/activity_observer.py
        self.vision_pipeline: Any = None      # perception/vision/vision_pipeline.py

        # ── Phase 8.1 — Action dispatch / media / project intelligence ───────
        # Added by Phase 8.1's revival work but never actually wired into
        # on_startup() until Phase 8.2 — see PHASE8_STATUS.md. All three are
        # non-fatal: server still boots if any fails to construct.
        self.media_service: Any = None        # actions/media/media_service.py
        self.action_coordinator: Any = None   # actions/action_coordinator.py
        self.project_intelligence: Any = None  # cognition/intelligence/project_intelligence.py

    def is_subsystem_ready(self, *names: str) -> bool:
        """True only if every named attribute is set (not None). Convenience
        helper for the readiness checks scattered through chat/voice handlers,
        e.g. `if not STATE.is_subsystem_ready("memory_router"): ...`"""
        return all(getattr(self, n, None) is not None for n in names)


STATE = AppState()

# ---------------------------------------------------------------------------
# Module-level aliases — tests (test_server.py, test_daily_summary.py) patch
# these names directly on the module (e.g. `srv.DAILY_SUMMARY = fake`).
# The endpoint handlers read from these module globals so patches take effect.
# ---------------------------------------------------------------------------
DAILY_SUMMARY = None           # set during startup; also patched by tests
EMBEDDING_SERVICE = None       # set during startup; also patched by tests
ACKNOWLEDGEMENT_ENGINE = None  # set during startup; also patched by tests
MEMORY_ROUTER = None           # set during startup; also patched by tests

STATE.config = None
if JARVIS_ENABLE_CONFIG_MANAGER:
    try:
        from config.settings import ConfigManager
        STATE.config = ConfigManager()
        STATE.config.load()
    except Exception as _cfg_exc:
        print(f"[JARVIS] ConfigManager init failed (non-fatal, falling back to os.getenv defaults): {_cfg_exc}")
        STATE.config = None

# ── Logging ───────────────────────────────────────────────────────────────────
# P-09: Structured logging via structlog (matches the kernel's log format)
from logging.handlers import RotatingFileHandler

Path("logs").mkdir(exist_ok=True)

_file_handler = RotatingFileHandler(
    "logs/server.log", maxBytes=10 * 1024 * 1024, backupCount=3, encoding="utf-8"
)
_file_handler.setFormatter(
    logging.Formatter("%(asctime)s [JARVIS] %(levelname)s %(name)s — %(message)s")
)

# Bugfix: on Windows, sys.stdout is frequently opened with the legacy
# console codepage (cp1252), which raises UnicodeEncodeError on any log
# message containing non-ASCII characters such as '→', '✓', '▸', emoji,
# etc. (e.g. memory/summaries/daily_summary.py's "JSON exported → %s").
# This crashed the asyncio loop's exception handler and silently dropped
# the log line every time. observability/logging/logger.py's LoggerFactory
# already guards against this for "jarvis.*"-namespaced loggers, but plain
# `logging.getLogger(__name__)` calls (used throughout the codebase) go
# through this root basicConfig handler instead, so it needs the same
# protection.
_console_stream = sys.stdout
if hasattr(_console_stream, "reconfigure"):
    try:
        _console_stream.reconfigure(encoding="utf-8", errors="backslashreplace")
    except Exception:
        pass


class _SafeConsoleHandler(logging.StreamHandler):
    """
    logging.StreamHandler.emit() catches *all* non-RecursionError exceptions
    internally (via self.handleError()) before they can propagate to an
    overriding emit() that calls super().emit() — so a naive
    try/except UnicodeEncodeError around super().emit() never actually
    fires. Override the write step directly instead.
    """

    def emit(self, record: logging.LogRecord) -> None:
        try:
            msg = self.format(record)
            stream = self.stream
            try:
                stream.write(msg + self.terminator)
            except UnicodeEncodeError:
                safe = msg.encode("ascii", errors="backslashreplace").decode("ascii")
                stream.write(safe + self.terminator)
            self.flush()
        except RecursionError:
            raise
        except Exception:
            self.handleError(record)


logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [JARVIS] %(levelname)s  %(name)s — %(message)s",
    handlers=[_SafeConsoleHandler(_console_stream), _file_handler],
)

# Phase 0: route every "jarvis.*" logger — server.py's own plus anything else
# in the codebase that calls observability.logging.logger.get_logger()
# (memory_router.py and health_monitor.py already do) — through ONE
# consistently-formatted handler set that writes to the same logs/server.log
# file. Without this, those other modules silently auto-configure themselves
# with file_enabled=False the first time they're imported, and their log
# lines never reach the file at all — only server.py's own lines did. The
# root logging.basicConfig() above is left in place untouched: it's still
# the safety net for third-party libraries (uvicorn, httpx, etc.) that log
# under their own (non-"jarvis.") logger names.
JARVIS_ENABLE_STRUCTURED_LOGGING = _env_flag("JARVIS_ENABLE_STRUCTURED_LOGGING", True)
log = None
if JARVIS_ENABLE_STRUCTURED_LOGGING:
    try:
        from observability.logging.logger import LoggerFactory, get_logger as _get_jarvis_logger
        _log_cfg = STATE.config.config.logging if STATE.config is not None else None
        LoggerFactory.configure(
            level=(_log_cfg.level if _log_cfg else "INFO"),
            fmt=(_log_cfg.format if _log_cfg else "text"),
            file_enabled=True,
            # Deliberately NOT _log_cfg.file_path ("logs/jarvis.log") — keeps
            # writing to the file anyone already monitoring this server has
            # pointed at. Unifying the *path* across entry points is a
            # separate, explicit decision, not a side effect of this phase.
            file_path="logs/server.log",
            max_bytes=(_log_cfg.max_bytes if _log_cfg else 10 * 1024 * 1024),
            backup_count=(_log_cfg.backup_count if _log_cfg else 5),
            console=True,
        )
        log = _get_jarvis_logger("server")
        log.info("Structured logging active (observability.logging.LoggerFactory)")
    except Exception as _log_exc:
        print(f"[JARVIS] observability logging init failed (non-fatal): {_log_exc}")
        log = None

if log is None:
    # Fallback — unchanged from before Phase 0, in case the block above
    # failed or was disabled via JARVIS_ENABLE_STRUCTURED_LOGGING=false.
    try:
        import structlog

        structlog.configure(
            processors=[
                structlog.stdlib.add_log_level,
                structlog.stdlib.add_logger_name,
                structlog.processors.TimeStamper(fmt="%H:%M:%S", utc=False),
                structlog.processors.StackInfoRenderer(),
                structlog.dev.ConsoleRenderer(),
            ],
            context_class=dict,
            logger_factory=structlog.stdlib.LoggerFactory(),
        )
        log = structlog.get_logger("jarvis.server")
        log.info("Structured logging active", backend="structlog")
    except ImportError:
        log = logging.getLogger("jarvis.server")
        log.info("structlog not installed — using standard logging (pip install structlog)")


# ── Phase 2 (2.1) — shared error-logging helper ────────────────────────────────
# Replaces the ad-hoc mix of `except: pass`, bare `except Exception:` with no
# logging, and one-off `log.warning(f"...: {e}")` calls scattered through the
# chat/voice/tool/model call hot path. Every catch site in that path now goes
# through this one helper so every swallowed exception is guaranteed to record
# at minimum: which function caught it, the exception type, the message, and
# whatever request-identifying context (session_id, tool name, agent, etc.)
# the caller has on hand — satisfying the "no new except: pass; every catch
# logs exception type, function, and relevant ids" rule for this roadmap.
def log_exception(where: str, exc: BaseException, *, level: str = "warning", **context) -> None:
    """Log a caught exception with consistent shape: location, exception
    type/message, and arbitrary caller-supplied context (session_id, tool
    name, agent, path, etc.). `level` is "warning" (default, for recoverable/
    non-fatal paths) or "error" (for failures that degrade a user-facing
    response). Never raises — logging a failed exception must not itself
    crash the caller.
    """
    try:
        ctx_str = " ".join(f"{k}={v!r}" for k, v in context.items())
        msg = f"{where}: {type(exc).__name__}: {exc}"
        if ctx_str:
            msg = f"{msg} ({ctx_str})"
        log_fn = getattr(log, level, None) or log.warning
        log_fn(msg)
    except Exception:
        # Logging itself must never raise — fall back to print as a last resort.
        try:
            print(f"[JARVIS] log_exception failed while logging {where}: {exc}")
        except Exception:
            pass

