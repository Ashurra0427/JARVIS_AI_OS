#  MEMORY STORE
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# P1.2 ARCHIVED: server.py's MemoryStore has been superseded by MemoryRouter
# (memory/router/memory_router.py + episodic/semantic/vector backends).
# The implementation is preserved below as _LegacyMemoryStore for reference
# but is no longer the live memory path. All reads/writes now go through the
# _MemoryShim bridge which delegates to STATE.memory_router once it is initialised.
# See archive/legacy_memory/README.md for the rationale.
# ─────────────────────────────────────────────────────────────────────────────

class _LegacyMemoryStore:
    """ARCHIVED — kept for reference only. All live code now uses _MemoryShim."""
    def __init__(self, path: Path):
        self.path = path
        self._data: dict[str, Any] = {"episodes": [], "semantic": {}}
        self._lock = asyncio.Lock()
        self._load()

    def _load(self):
        if self.path.exists():
            try:
                self._data = json.loads(self.path.read_text())
            except Exception:
                pass

    def _save(self):
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self._data, indent=2))
        tmp.replace(self.path)

    async def add_episode(self, role: str, agent: str, content: str):
        async with self._lock:
            ep = {"id": str(uuid.uuid4())[:8], "ts": time.time(),
                  "role": role, "agent": agent, "content": content[:400]}
            self._data["episodes"].append(ep)
            if len(self._data["episodes"]) > 200:
                self._data["episodes"] = self._data["episodes"][-200:]
            self._save()
            return ep

    async def store_semantic(self, key: str, value: str):
        async with self._lock:
            self._data["semantic"][key] = {"value": value, "ts": time.time()}
            self._save()

    def recall_recent(self, n: int = 10) -> list[dict]:
        return self._data["episodes"][-n:]

    def recall_semantic(self, query: str) -> list[tuple[str, str]]:
        q = query.lower()
        return [(k, v["value"]) for k, v in self._data["semantic"].items()
                if q in k.lower() or q in v["value"].lower()]

    def stats(self) -> dict:
        return {"episodes": len(self._data["episodes"]),
                "semantic": len(self._data["semantic"])}


class _MemoryShim:
    """
    P1.2 — Bridge that makes all legacy `memory.*` call sites route through
    STATE.memory_router (the canonical MemoryRouter) once it is available, while
    providing a safe JSON-file fallback during early boot (before STATE.memory_router
    is initialised) so startup order does not matter.

    Session isolation: remember_turn / add_episode accept an optional
    session_id kwarg that is stored in episode metadata and passed to
    MemoryRouter so that per-connection history never crosses tab boundaries
    (fixes the "two browser tabs see each other's history" bug).
    """

    def __init__(self, path: Path) -> None:
        self._fallback = _LegacyMemoryStore(path)

    # ── episode / conversation writes ─────────────────────────────────────
    async def add_episode(
        self, role: str, agent: str, content: str, *, session_id: str = ""
    ):
        if STATE.memory_router is not None:
            try:
                from memory.episodic.episodic_memory import Episode, EpisodeOutcome
                # Bugfix: Episode has no agent_id/user_input/agent_response/
                # timestamp/metadata fields — it uses actors/title/summary/
                # context/started_at. The previous construction raised
                # TypeError on every call and silently fell through to the
                # legacy JSON-file fallback below.
                ep = Episode(
                    session_id=session_id or "default",
                    title=f"{role}:{agent}",
                    summary=content[:400],
                    actors=[agent],
                    outcome=EpisodeOutcome.SUCCESS,
                    context={"role": role, "agent": agent, "session_id": session_id},
                )
                await STATE.memory_router.record_episode(ep)
                return {"id": ep.episode_id, "ts": ep.started_at,
                        "role": role, "agent": agent, "content": content[:400]}
            except Exception as exc:
                log.warning("_MemoryShim.add_episode → MemoryRouter failed: %s", exc)
        return await self._fallback.add_episode(role, agent, content)

    # ── semantic / fact writes ────────────────────────────────────────────
    async def store_semantic(self, key: str, value: str, *, session_id: str = ""):
        if STATE.memory_router is not None:
            try:
                from memory.semantic.semantic_memory import Fact
                fact = Fact(
                    subject=key, predicate="value", object_=value,
                    source="user", confidence=1.0,
                )
                await STATE.memory_router.assert_fact(fact)
                return
            except Exception as exc:
                log.warning("_MemoryShim.store_semantic → MemoryRouter failed: %s", exc)
        await self._fallback.store_semantic(key, value)

    # ── reads ─────────────────────────────────────────────────────────────
    def recall_recent(self, n: int = 10, *, session_id: str = "") -> list[dict]:
        """
        Returns recent episodes. Session-scoped when session_id is provided
        and STATE.memory_router is available; falls back to shared legacy store.
        """
        if STATE.memory_router is not None:
            msgs = STATE.memory_router.recent_messages(n=n)
            if session_id:
                msgs = [m for m in msgs
                        if m.get("session_id", session_id) == session_id]
            return [
                {"role": m.get("role", ""), "agent": m.get("agent", "jarvis"),
                 "content": m.get("content", ""), "session_id": session_id}
                for m in msgs[-n:]
            ]
        return self._fallback.recall_recent(n)

    def recall_semantic(self, query: str) -> list[tuple[str, str]]:
        return self._fallback.recall_semantic(query)

    def stats(self) -> dict:
        if STATE.memory_router is not None:
            try:
                # stats() is async on MemoryRouter; return a lightweight sync dict.
                return {"episodes": "via MemoryRouter", "semantic": "via MemoryRouter"}
            except Exception:
                pass
        return self._fallback.stats()


memory = _MemoryShim(MEMORY_DB)

# ── Tool Registry + MemoryRouter bridge, integrated subsystems, EventBus,
# voice engines, observability, Action Layer, Orchestrator, and Perception
# Expansion singletons are now all declared as AppState attributes above
# (see STATE) rather than as module-level globals here. See Phase 2 (2.2).
# ═══════════════════════════════════════════════════════════════════════════════

SETTINGS_PATH = DATA_DIR / "ui_settings.json"
RUNTIME_SETTINGS: dict[str, Any] = {}


def _load_runtime_settings() -> dict[str, Any]:
    try:
        if SETTINGS_PATH.exists():
            return json.loads(SETTINGS_PATH.read_text(encoding="utf-8"))
    except Exception:
        pass
    return {}


def apply_settings(settings: dict[str, Any]) -> None:
    """
    Apply settings pushed from the SettingsPanel.
    Persists to datastore/ui_settings.json and updates runtime knobs that
    server.py itself cares about (voice, default agent, TTS voice, etc.)
    """
    RUNTIME_SETTINGS.update(settings or {})
    try:
        SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS_PATH.write_text(json.dumps(RUNTIME_SETTINGS, indent=2), encoding="utf-8")
    except Exception as e:
        log.warning(f"Failed to persist settings: {e}")

    voice = (settings or {}).get("voice", {})
    if "tts_voice" in voice:
        # tts_voice is an explicit edge-tts voice id override (e.g.
        # "en-US-AndrewMultilingualNeural"). synthesize_speech() reads it
        # from RUNTIME_SETTINGS at call time and, if set, uses it instead
        # of the language-based automatic voice selection.
        pass

    # Settings panel's "Ollama → Fallback Model" picker maps directly to
    # ModelRouter's emergency_model tier (the safety-net used when both
    # Groq and Gemini fail — see model_router.py's v4.0 docstring). Make
    # the setting live instead of inert: push it straight to the router's
    # emergency provider. Scheduled as a background task (rather than
    # awaited here) because apply_settings() is called synchronously from
    # both a WS handler and a REST endpoint, and switch_model() can take
    # up to ~90s on a cold model load — that shouldn't block the settings
    # save/ack round-trip.
    ollama_settings = (settings or {}).get("ollama", {})
    fallback_model = (ollama_settings or {}).get("fallback_model", "")
    if fallback_model:
        async def _apply_emergency_model(model: str) -> None:
            try:
                from models.router.model_router import get_router
                router = get_router()
                if model == getattr(router, "_emergency_model", None):
                    return
                ok = await router._emergency_provider.switch_model(model)
                if ok:
                    router._emergency_model = model
                    log.info(f"Emergency model updated from settings: {model}")
                else:
                    log.warning(f"Emergency model switch failed (not pulled?): {model}")
            except Exception as exc:
                log.warning(f"Failed to apply emergency model setting: {exc}")

        try:
            asyncio.create_task(_apply_emergency_model(fallback_model))
        except RuntimeError:
            # No running event loop (e.g. called outside an async context) —
            # the setting is still persisted above; it'll take effect once
            # something else triggers a switch, or on next boot.
            log.debug("apply_settings: no running loop — emergency model update deferred")

    log.info(f"Settings updated: {list((settings or {}).keys())}")


RUNTIME_SETTINGS = _load_runtime_settings()

from models.switcher.model_switcher import ModelSwitcher

# Module-level handle to the ModelSwitcher singleton, used by the
# model_switch / list_ollama_models / model_state / model_cycle WS
