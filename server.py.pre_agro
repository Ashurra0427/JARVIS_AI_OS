# the dependency is explicit rather than appearing for the first time
# hundreds of lines later. None until on_startup() (or the first handler
# that needs it) lazily calls ModelSwitcher.get_instance() — that lazy
# init is safe even if a WS message arrives before startup completes.
model_switcher: ModelSwitcher | None = None


