@app.post("/voice/activate")
async def voice_activate_endpoint():
    """
    Phase 3: Programmatically trigger a voice pipeline run (same as mic button).
    Useful for testing the full pipeline without speaking a wake word.
    """
    if STATE.voice_coordinator is None:
        return JSONResponse({"error": "VoiceCoordinator not initialized"}, status_code=503)
    try:
        run_id = await STATE.voice_coordinator.activate()
        return JSONResponse({"status": "ok", "run_id": run_id})
