def _agent_metrics_message(agent_id: str) -> dict:
    a = AGENT_REGISTRY[agent_id]
    # Phase 8.5: include success_rate_pct, avg_task_duration_ms, tool_call_count
    # when available (populated by the agent.metrics.updated bridge from
    # MetricsPublisherMixin._base_metrics() — None until at least one task runs).
    telemetry: dict = {}
    for k in ("success_rate_pct", "avg_task_duration_ms", "tool_call_count"):
        v = a["metrics"].get(k)
        if v is not None:
            telemetry[k] = v
    return {
        "type":         "agent_metrics",
        "agent_name":   agent_id,
        "agent_id":     a["agent_id"],
        "current_task": a["current_task"],
        "status":       a["status"],
        "metrics": {
            "tasks_done":   a["tasks_done"],
            "tasks_failed": a["tasks_failed"],
            **a["metrics"],
            **telemetry,  # ensure top-level visibility even if already in a["metrics"]
        },
    }


def _mark_agent_working(agent_id: str, task_desc: str = "") -> None:
    a = AGENT_REGISTRY.get(agent_id)
    if not a:
        return
    a["status"] = "working"
    a["current_task"] = task_desc[:60]


def _mark_agent_done(agent_id: str, success: bool = True) -> None:
    a = AGENT_REGISTRY.get(agent_id)
    if not a:
        return
    if success:
        a["tasks_done"] += 1
        a["status"] = "idle"
        # Nudge agent-specific metrics so the UI feels alive
        m = a["metrics"]
        if agent_id == "oracle":
            m["tasks_in_progress"] = max(0, m["tasks_in_progress"] - 0)
            m["tasks_queued"] = max(0, m["tasks_queued"])
        elif agent_id == "athena":
            m["sources_scanned"] += 1
            m["new_findings"] += 1
        elif agent_id == "vision_eng":
            m["files_analyzed"] += 1
            m["code_lines_written"] += 12
        elif agent_id == "herald":
            m["pages_visited"] += 1
            m["sessions"] += 1
        elif agent_id == "friday":
            m["runs_completed"] += 1
        elif agent_id == "ashura":
            m["memories_stored"] += 1
        elif agent_id == "coordinator":
            m["tasks_done"] = a["tasks_done"]
    else:
        a["tasks_failed"] += 1
        a["status"] = "error"
        if agent_id == "coordinator":
            a["metrics"]["tasks_failed"] = a["tasks_failed"]


# P-19: Last Groq usage — populated by _call_groq, read in chat reply to show cost
_groq_last_usage: dict[str, int] = {}


async def _call_groq(agent: str, messages: list[dict], system: str) -> str:
    import httpx
    from groq import AsyncGroq

    # ── Network/proxy hardening ─────────────────────────────────────────
    # A bare AsyncGroq(api_key=...) builds its own httpx.AsyncClient with
    # default timeouts (which can hang) and `trust_env=True`, so it WILL
    # pick up HTTP_PROXY / HTTPS_PROXY / NO_PROXY from the environment
    # automatically. If those vars point at a dead/unreachable proxy, or
    # a corporate proxy with a self-signed cert, every call fails fast
    # with the generic "Connection error." message and no detail.
    #
    # Optional .env overrides for this exact situation:
    #   GROQ_BASE_URL=https://api.groq.com          (custom endpoint/proxy)
    #   GROQ_HTTP_PROXY=http://user:pass@host:port  (force a specific proxy)
    #   GROQ_VERIFY_SSL=false                       (skip TLS verification
    #                                                 — corporate MITM proxy
    #                                                 with self-signed CA)
    base_url   = os.getenv("GROQ_BASE_URL") or None
    proxy_url  = os.getenv("GROQ_HTTP_PROXY") or os.getenv("HTTPS_PROXY") or os.getenv("HTTP_PROXY") or None
    verify_ssl = os.getenv("GROQ_VERIFY_SSL", "true").strip().lower() not in ("0", "false", "no")

    http_client = httpx.AsyncClient(
        proxy=proxy_url,
        verify=verify_ssl,
        timeout=httpx.Timeout(connect=10.0, read=30.0, write=10.0, pool=10.0),
        trust_env=True,
    )

    try:
        client = AsyncGroq(
            api_key=GROQ_KEY,
            base_url=base_url,
            timeout=30.0,
            max_retries=2,
            http_client=http_client,
        )
        resp = await client.chat.completions.create(
            model=GROQ_CHAT_MODEL,
            max_tokens=2048,
            messages=[{"role": "system", "content": system}] + messages,
        )
        # P-19: Capture token usage for cost tracking
        if resp.usage:
            _groq_last_usage["prompt"]     = resp.usage.prompt_tokens
            _groq_last_usage["completion"] = resp.usage.completion_tokens
            _groq_last_usage["total"]      = resp.usage.total_tokens
        else:
            _groq_last_usage.clear()
        return resp.choices[0].message.content
    except Exception as e:
        # The groq SDK collapses ALL httpx connection failures (DNS, TLS,
        # proxy refused, timeout, etc.) into the generic message
        # "Connection error." — the *real* reason is on __cause__.
        # Surface it so logs/UI show something actionable instead of a
        # one-line dead end.
        cause = e.__cause__ or e.__context__
        detail = f"{e} (cause: {type(cause).__name__}: {cause})" if cause and cause is not e else str(e)
        log.debug(f"GROQ raw error detail: {detail}")
        raise RuntimeError(f"GROQ {type(e).__name__}: {detail}") from e
    finally:
        await http_client.aclose()


async def _call_groq_streaming(
    agent: str, messages: list[dict], system: str, ws: "WebSocket"
) -> str:
    """
    P-10: Stream Groq response token-by-token over WebSocket.
    Sends {"type": "chat_stream", "delta": "...", "agent": agent} per chunk,
    then {"type": "chat_stream_end", "agent": agent} when done.
    Returns the full accumulated response text.
    """
    import httpx
    from groq import AsyncGroq

    base_url  = os.getenv("GROQ_BASE_URL") or None
    proxy_url = os.getenv("GROQ_HTTP_PROXY") or os.getenv("HTTPS_PROXY") or os.getenv("HTTP_PROXY") or None
    verify_ssl = os.getenv("GROQ_VERIFY_SSL", "true").strip().lower() not in ("0", "false", "no")

    http_client = httpx.AsyncClient(
        proxy=proxy_url,
        verify=verify_ssl,
        timeout=httpx.Timeout(connect=10.0, read=60.0, write=10.0, pool=10.0),
        trust_env=True,
    )
    full_text = ""
    try:
        client = AsyncGroq(
            api_key=GROQ_KEY,
            base_url=base_url,
            timeout=60.0,
            max_retries=1,
            http_client=http_client,
        )
        stream = await client.chat.completions.create(
            model=GROQ_CHAT_MODEL,
            max_tokens=2048,
            messages=[{"role": "system", "content": system}] + messages,
            stream=True,
        )
        async for chunk in stream:
            delta = chunk.choices[0].delta.content or ""
            if delta:
                full_text += delta
                await manager.send(ws, {"type": "chat_stream", "delta": delta, "agent": agent})
        await manager.send(ws, {"type": "chat_stream_end", "agent": agent})
        return full_text
    except Exception as e:
        cause = e.__cause__ or e.__context__
        detail = f"{e} (cause: {type(cause).__name__}: {cause})" if cause and cause is not e else str(e)
        log_exception("_call_groq_streaming", e, agent=agent, level="error")
        raise RuntimeError(f"GROQ streaming {type(e).__name__}: {detail}") from e
    finally:
        await http_client.aclose()
# models/local/qwen_openvino/qwen_openvino_provider.py + IR files in
# models/local/qwen_coder/. Lazily imported/constructed so that machines
# without optimum-intel/openvino installed (or without the IR files) don't
# pay any import cost and simply skip this tier via the normal
# provider-loop exception handling in call_ai().
_qwen_ov_provider: Any = None

# Cache Gemini GenerativeModel objects keyed by system-prompt hash.
# Avoids re-configuring the SDK and rebuilding connection pools on every call.
_gemini_models: dict[int, Any] = {}


def _get_qwen_openvino_provider():
    """Lazily construct the QwenOpenVINOProvider singleton.

    FIX: The default device changed from "AUTO" to "HETERO:GPU,CPU".

    "AUTO" lets OpenVINO decide at runtime but places the full model on
    whichever device it prefers (usually CPU-only on machines without a
    discrete dGPU driver), which hammers RAM and CPU threads and causes
    system sluggishness during inference.

    "HETERO:GPU,CPU" distributes layers: GPU (iGPU / dGPU) runs the
    compute-heavy attention blocks; CPU handles layers the GPU can't
    accelerate (e.g. unsupported ops).  This spreads the load, lowers
    per-core CPU utilisation, and reduces memory pressure because GPU VRAM
    absorbs the largest weight tensors.

    Override via:
      QWEN_OPENVINO_DEVICE=AUTO          (original behaviour)
      QWEN_OPENVINO_DEVICE=CPU           (CPU-only, no GPU)
      QWEN_OPENVINO_DEVICE=GPU           (GPU-only — needs full GPU support)
      QWEN_OPENVINO_DEVICE=HETERO:GPU,CPU  (default — GPU-primary + CPU spill)
      QWEN_OPENVINO_DEVICE=HETERO:CPU,GPU  (CPU-primary, lighter GPU use)
    """
    global _qwen_ov_provider
    if _qwen_ov_provider is None:
        from models.local.qwen_openvino.qwen_openvino_provider import QwenOpenVINOProvider

        models_cfg = RUNTIME_SETTINGS.get("models", {})
        device = (
            os.getenv("QWEN_OPENVINO_DEVICE")
            or models_cfg.get("qwen_local_device")
            or "HETERO:GPU,CPU"   # FIX: GPU-primary with CPU spill-over
        )

        # Also apply OpenVINO per-device thread caps so the model doesn't
        # monopolise every CPU core while GPU handles the heavy work.
        # These are passed as ov_config via an env-based override dict so
        # QwenOpenVINOProvider.load_model() picks them up automatically.
        ov_thread_env = os.getenv("QWEN_OPENVINO_CPU_THREADS")
        if ov_thread_env is None and "CPU" in device:
            import psutil as _psu
            # Leave at least 2 cores free for the FastAPI event loop
            cpu_threads = max(1, (_psu.cpu_count(logical=True) or 4) - 2)
            os.environ.setdefault("QWEN_OPENVINO_CPU_THREADS", str(cpu_threads))

        _qwen_ov_provider = QwenOpenVINOProvider(device=device)
    return _qwen_ov_provider


def _qwen_openvino_enabled() -> bool:
    """Allow disabling this tier via .env or the settings panel without
    touching the provider chain code.

    Defaults to ENABLED — this matches the documented 4-tier chain
    (Groq -> Qwen-OpenVINO -> Gemini -> Ollama) in this file's header and
    config/models.yaml's `llm_providers.qwen_local.enabled: true`. If the
    OpenVINO IR model files or optimum-intel/openvino packages are absent,
    _call_qwen_openvino() raises (via QwenOpenVINOProvider.complete()) and
    this tier is skipped exactly like any other unavailable provider —
    so enabling it by default is safe even on machines without the model.
    """
    models_cfg = RUNTIME_SETTINGS.get("models", {})
    env_val = os.getenv("QWEN_OPENVINO_ENABLED")
    if env_val is not None:
        return env_val.strip().lower() not in ("0", "false", "no")
    return bool(models_cfg.get("qwen_local_enabled", True))


async def _call_qwen_openvino(agent: str, messages: list[dict], system: str) -> str:
    """Call the local OpenVINO-IR Qwen2.5-Coder model (offline, no network)."""
    from models.providers.base_provider import ModelMessage, ModelRequest

    provider = _get_qwen_openvino_provider()

    model_messages = [ModelMessage(role="system", content=system)]
    for m in messages:
        model_messages.append(ModelMessage(role=m["role"], content=m["content"]))

    timeout_s = int(os.getenv("QWEN_OPENVINO_TIMEOUT_S", "60"))
    request = ModelRequest(
        messages=model_messages,
        model="qwen2.5-coder-openvino",
        max_tokens=1024,
        temperature=0.2,
        timeout_s=timeout_s,
    )
    response = await provider.complete(request)
    return response.content


async def _call_gemini(agent: str, messages: list[dict], system: str) -> str:
    # Uses the new google-genai SDK (pip install google-genai)
    # which replaces the deprecated google-generativeai package.
    from google import genai as _genai
    from google.genai import types as _gtypes

    client = _genai.Client(api_key=GEMINI_KEY)

    # Build the conversation contents list
    contents: list = []
    for m in messages:
        role = "user" if m["role"] == "user" else "model"
        contents.append(_gtypes.Content(
            role=role,
            parts=[_gtypes.Part.from_text(text=m["content"])],
        ))

    config = _gtypes.GenerateContentConfig(
        system_instruction=system,
        max_output_tokens=2048,
        temperature=0.7,
    )

    # Cache key still used to skip re-instantiating config objects
    key = hash(system)
    _gemini_models[key] = True  # sentinel — client is stateless in new SDK

    resp = await asyncio.to_thread(
        client.models.generate_content,
        model="gemini-2.5-flash",
        contents=contents,
        config=config,
    )
    return resp.text


async def _call_ollama(agent: str, messages: list[dict], system: str) -> str:
    """Call local Ollama (final fallback) via HTTP (no extra SDK needed).

    Now the LAST tier in the chain (Groq -> Qwen-OpenVINO -> Gemini -> Ollama).
    Default timeout is 90s, configurable via OLLAMA_TIMEOUT_S. A *cold* Ollama
    model load (qwen3:4b not yet resident in memory) can easily take 45-90s+
    on modest hardware before the first token — that's why this was timing
    out at the old 45s default. `_prewarm_ollama()` (called once at startup,
    fire-and-forget) sends a trivial request so the model is already loaded
    into memory by the time a real user message arrives — after that,
    requests are fast and well within this timeout.
    """
    import aiohttp
    url = f"{OLLAMA_HOST.rstrip('/')}/api/chat"
    payload = {
        "model": OLLAMA_MODEL,
        "stream": False,
        "messages": [{"role": "system", "content": system}] + messages,
    }
    timeout_s = int(os.getenv("OLLAMA_TIMEOUT_S", "90"))
    timeout = aiohttp.ClientTimeout(total=timeout_s)
    async with aiohttp.ClientSession(timeout=timeout) as session:
        async with session.post(url, json=payload) as resp:
            if resp.status != 200:
                body = await resp.text()
                raise RuntimeError(f"Ollama HTTP {resp.status}: {body[:200]}")
            data = await resp.json()
            # Ollama chat response format
            return data["message"]["content"]


async def _build_file_context(paths: list[str], max_chars_per_file: int = 4000,
                               max_total_chars: int = 12000) -> str:
    """
    Read attached files and format their content for inclusion in the LLM
    prompt. Text-like files are read directly; binary/unsupported files are
    listed by name/size only so the model still knows they were attached.
    """
    import os as _os

    _TEXT_EXTS = {
        ".txt", ".md", ".markdown", ".py", ".js", ".ts", ".tsx", ".jsx",
        ".json", ".yaml", ".yml", ".csv", ".tsv", ".html", ".css", ".xml",
        ".log", ".ini", ".cfg", ".toml", ".sh", ".bat", ".sql",
    }

    sections: list[str] = []
    total = 0

    for path in paths:
        try:
            name = _os.path.basename(path)
            ext = _os.path.splitext(path)[1].lower()
            if not _os.path.exists(path):
                sections.append(f"--- FILE: {name} ---\n[File not found: {path}]")
                continue

            size = _os.path.getsize(path)

            if ext in _TEXT_EXTS:
                try:
                    from tools.file_tools.file_tools import file_read
                    result = await asyncio.to_thread(file_read, path)
                    content = result.get("content", "")
                except Exception as e:
                    log_exception("_build_file_context.file_read", e, path=path)
                    sections.append(f"--- FILE: {name} ({size} bytes) ---\n[Could not read file: {e}]")
                    continue

                if len(content) > max_chars_per_file:
                    content = content[:max_chars_per_file] + "\n...[truncated]"

                remaining = max_total_chars - total
                if remaining <= 0:
                    sections.append(f"--- FILE: {name} ---\n[Skipped — total attachment size limit reached]")
                    continue
                if len(content) > remaining:
                    content = content[:remaining] + "\n...[truncated]"

                total += len(content)
                sections.append(f"--- FILE: {name} ---\n{content}")
            else:
                # Binary / unsupported — describe it so the model is aware
                sections.append(
                    f"--- FILE: {name} ({size} bytes) ---\n"
                    f"[Binary or unsupported file type '{ext}' — content not included. "
                    f"Path: {path}]"
                )
        except Exception as e:
            log_exception("_build_file_context", e, path=path)
            sections.append(f"--- FILE: {path} ---\n[Error reading file: {e}]")

    if not sections:
        return ""

    return "The user attached the following file(s):\n\n" + "\n\n".join(sections)


# ── Provider rate-limit cooldown cache ───────────────────────────────────────
# Groq (daily TPD limit) and Gemini (free-tier daily request limit) both
# return 429s that won't clear for minutes/hours. Without this, every chat
# message pays a full round-trip to a provider we already KNOW is exhausted
# before falling through to the next tier. Track a per-provider "don't try
# again until <ts>" cooldown, parsed from the error message when possible.
_provider_cooldowns: dict[str, float] = {}

_RETRY_DELAY_RE = re.compile(r"retry_delay\s*\{\s*seconds:\s*(\d+)", re.IGNORECASE)
_TRY_AGAIN_RE   = re.compile(r"try again in\s+(?:(\d+)\s*m)?\s*([\d.]+)\s*s", re.IGNORECASE)


def _is_rate_limit_error(exc: Exception) -> bool:
    s = f"{type(exc).__name__} {exc}".lower()
    return (
        "429" in s
        or "rate_limit" in s
        or "ratelimiterror" in s
        or "too many requests" in s
        or "quota" in s
        or "resourceexhausted" in s
    )


def _extract_retry_seconds(err: str) -> float | None:
    """Best-effort extraction of a provider-suggested retry delay."""
    m = _RETRY_DELAY_RE.search(err)          # Gemini: "retry_delay { seconds: 7 }"
    if m:
        return float(m.group(1))
    m = _TRY_AGAIN_RE.search(err)            # Groq: "Please try again in 13m14.016s"
    if m:
        minutes = float(m.group(1) or 0)
        seconds = float(m.group(2) or 0)
        return minutes * 60 + seconds
    return None


def _cooldown_remaining(name: str) -> float:
    until = _provider_cooldowns.get(name)
    if until is None:
        return 0.0
    remaining = until - time.time()
    return remaining if remaining > 0 else 0.0


def _maybe_set_cooldown(name: str, exc: Exception) -> None:
    if not _is_rate_limit_error(exc):
        return
    err = str(exc)
    retry_s = _extract_retry_seconds(err)
    if retry_s is None:
        retry_s = 60.0  # generic default if no retry hint found
    # Cap so a misparsed huge number (or a "per day" limit with no usable
    # retry hint) doesn't blackhole a provider for hours.
    retry_s = min(retry_s, 15 * 60)
    _provider_cooldowns[name] = time.time() + retry_s
    log.info(f"{name} rate-limited — cooling down for {retry_s:.0f}s")


async def call_ai(
    agent: str,
    user_msg: str,
    history: list[dict] | None = None,
    *,
    session_id: str = "default",
) -> AIReply:
    """
    Route through the v4.0 ModelRouter directly (no parallel provider chain
    here in server.py). The router handles user-selection-first routing,
    cloud fallback, the emergency local model, and the offline canned
    response internally — and populates its own telemetry (get_stats() /
    the /api/model/diagnostics endpoint) as it goes, which server.py's old
    standalone chain bypassed entirely.

    Returns an AIReply (Phase 6.4/7.1 — see its docstring for why this
    replaced the old bare (text, provider) tuple). `.text` / `.provider`
    cover the old call sites; `.fallback_occurred` / `.fallback_selected`
    are new and let the WS chat_reply payload show "answered by Groq —
    Ollama unavailable" instead of silently rendering as if Ollama answered.

    `history` — optional list of prior turns in OpenAI messages format
    ([{"role":..., "content":...}]) from MemoryRouter.recent_messages().
    Used to seed the per-agent history buffer when this agent has no
    in-process history yet (e.g. first message, or after a restart), giving
    the LLM real conversational context from the persistent conversation log.
    """
    global _last_provider
    from models.router.model_router import get_router
    router = get_router()

    agent = _resolve_agent(agent)
    # P1.2: History keyed by (session_id, agent) — prevents cross-tab crosstalk.
    _sess_hist = _histories.setdefault(session_id, {})
    hist = _sess_hist.setdefault(agent, [])

    # Seed from MemoryRouter conversation buffer if we have no in-process
    # history for this (session, agent) pair yet.
    if not hist and history:
        hist.extend(history)
        _sess_hist[agent] = hist

    hist.append({"role": "user", "content": user_msg})
    if len(hist) > 20:
        _sess_hist[agent] = hist[-20:]
        hist = _sess_hist[agent]

    system = AGENT_PROMPTS.get(agent, AGENT_PROMPTS["oracle"])

    recent = memory.recall_recent(3)
    if recent:
        ctx = "\n".join(f"[{r['agent'].upper()}] {r['role']}: {r['content']}" for r in recent)
        system += f"\n\nRecent context from memory:\n{ctx}"

    try:
        # Phase 6.4 / 7.1: read the user's selection *before* complete() runs.
        # complete() never mutates _active_provider itself (only
        # set_active_provider() does, awaited separately from a model_switch
        # WS message), so this is stable for the duration of this call and
        # safe to read as a local — no shared-mutable-state race even when
        # multiple call_ai() invocations are in flight concurrently (Phase 8).
        selected_provider = router.active_provider
        selected_model    = router.active_model

        # Phase 7.2 — pre-flight loading check.
        # If Ollama is selected and the model is still being loaded into
        # memory, broadcast a distinct "model_loading" status to all clients
        # immediately so the HUD shows "loading…" rather than a spinner with
        # no explanation.  We still proceed with complete() — the router will
        # wait up to the grace-extended timeout for the load to finish.
        if selected_provider == "ollama" and selected_model:
            try:
                _ollama_prov = router.get_provider("ollama")
                if _ollama_prov is not None:
                    _is_loading = await _ollama_prov.is_model_loading(selected_model)
                    if _is_loading:
                        log.info(
                            "Phase 7.2: Ollama model is still loading — "
                            "broadcasting model_loading status",
                            model=selected_model,
                        )
                        await manager.broadcast({
                            "type":    "model_loading",
                            "model":   selected_model,
                            "provider": "ollama",
                            "message": f"Model {selected_model!r} is loading into memory…",
                        })
            except Exception as _lce:
                log.debug("Phase 7.2: loading pre-check in call_ai failed (non-fatal)", error=str(_lce))

        response = await router.complete(user_msg, system_override=system)
        hist.append({"role": "assistant", "content": response.content})
        await memory.add_episode("assistant", agent, response.content, session_id=session_id)
        _last_provider = response.provider
        fallback_occurred = response.provider.lower() != selected_provider.lower()
        if fallback_occurred:
            log.info(
                f"AI fallback: selected={selected_provider} answered_by={response.provider} "
                f"({agent})"
            )
        else:
            log.info(f"AI via {response.provider} ({agent}): {len(response.content)} chars")
        return AIReply(
            text=response.content,
            provider=response.provider.upper(),
            fallback_occurred=fallback_occurred,
            fallback_selected=selected_provider.upper() if fallback_occurred else "",
        )
    except Exception as e:
        log.warning(f"call_ai: router.complete() raised unexpectedly: {e}")
        _last_provider = "NONE"
        return AIReply(text=f"[ERROR] {e}", provider="NONE")


# ═══════════════════════════════════════════════════════════════════════════════
#  STT  ─  delegates to the canonical STTEngine (perception/speech/stt.py)
# ═══════════════════════════════════════════════════════════════════════════════
# This used to be a second, independent implementation (Groq Whisper call +
# faster-whisper call, hand-rolled here). It's now a thin wrapper around the
# single shared STATE.stt_engine instance created in on_startup() — see the
# module-level docstring near STATE.stt_engine/STATE.tts_engine above for why.

async def transcribe_audio(audio_bytes: bytes, mime: str = "audio/webm") -> tuple[str, str]:
    """STT via the shared STTEngine. Returns (text, detected_language)."""
    if STATE.stt_engine is None:
        log.error("STATE.stt_engine not initialised — cannot transcribe")
        return "", "en"
    text, lang, _confidence = await asyncio.to_thread(
        STATE.stt_engine.transcribe_blob, audio_bytes, mime
    )
    return text, lang


# Phase 5.1 — raw-PCM decode for the streaming mic_chunk path.
#
# LiveSTT (perception/speech/live_stt.py) consumes VoiceEvent.MIC_AUDIO_CHUNK
# and does `np.frombuffer(audio_bytes, dtype=np.int16)` directly on the
# payload — it expects raw 16kHz mono signed-16-bit PCM, NOT a compressed
# container. The browser/mobile HUD instead streams short WebM/Opus blobs
# (1-2s each) over the WS "mic_chunk" message. This decodes one such blob to
# the exact PCM format LiveSTT expects, via an `ffmpeg` subprocess (no extra
# Python dependency required — ffmpeg is already invoked indirectly by
# faster-whisper for container input, and is required to be on PATH for
# that to work at all).
#
# This is intentionally separate from transcribe_audio() above: that
# function calls the heavyweight full-Whisper/Groq STT_ENGINE for complete
# utterances (the "stt_audio" message). This helper does no transcription
# at all — it only decodes audio bytes so LiveSTT's own lightweight
# streaming inference can run on them.
_LIVE_STT_PCM_SAMPLE_RATE = 16_000


def _decode_container_to_pcm16(audio_bytes: bytes, mime: str = "audio/webm") -> bytes:
    """
    Decode a compressed audio container (WebM/Opus, ogg, mp4, etc.) to raw
    16kHz mono signed-16-bit little-endian PCM bytes, via an ffmpeg
    subprocess. Runs synchronously — callers from async code should wrap
    this in `asyncio.to_thread`.

    Returns b"" on failure (logged by the caller) rather than raising, so a
    single malformed/truncated chunk during streaming can't take down the
    WS connection — the caller should treat empty bytes as "skip this chunk".
    """
    if not audio_bytes:
        return b""
    if shutil.which("ffmpeg") is None:
        log.error(
            "ffmpeg not found on PATH — cannot decode mic_chunk audio for LiveSTT. "
            "Install ffmpeg (e.g. `apt install ffmpeg` / `brew install ffmpeg`)."
        )
        return b""
    try:
        proc = subprocess.run(
            [
                "ffmpeg",
                "-hide_banner", "-loglevel", "error",
                "-i", "pipe:0",
                "-f", "s16le",            # raw PCM, signed 16-bit little-endian
                "-acodec", "pcm_s16le",
                "-ac", "1",                # mono
                "-ar", str(_LIVE_STT_PCM_SAMPLE_RATE),
                "pipe:1",
            ],
            input=audio_bytes,
            capture_output=True,
            timeout=5.0,
        )
    except subprocess.TimeoutExpired:
        log.warning("mic_chunk ffmpeg decode timed out — dropping this chunk")
        return b""
    except Exception as exc:
        log.error(f"mic_chunk ffmpeg decode failed to launch: {exc}", exc_info=True)
        return b""

    if proc.returncode != 0:
        # A single bad/truncated WebM chunk (common with MediaRecorder's
        # first chunk, which can lack a clean header) shouldn't be loud —
        # log at debug, not error, and let the caller just skip the chunk.
        log.debug(
            "mic_chunk ffmpeg decode returned non-zero",
            returncode=proc.returncode,
            stderr=proc.stderr.decode(errors="replace")[:300],
        )
        return b""

    return proc.stdout


# Phase 5.4 — forward VoiceEvent.STT_TRANSCRIPTION_PARTIAL back to the
# *originating* WS connection only, as {"type": "stt_partial", "text": ...,
# "language": ...}.
#
# Important constraint (see STATE.live_stt_active_session's docstring in
# AppState): because STATE.live_stt is a single shared instance (Phase 5.5),
# the STT_TRANSCRIPTION_PARTIAL events it emits carry no session_id at all
# — LiveSTT has no notion of which connection's audio produced a given
# partial. What we CAN guarantee correctly: at most one connection is ever
# registered as "active" at a time (STATE.live_stt_active_session), set on
# live_stt_start and cleared on live_stt_stop/disconnect, so partials are
# delivered to exactly that one connection and no other — this matches the
# single-speaker-at-a-time model. It does NOT protect against a second
# connection's audio being mixed into the shared buffer if it also starts
# live STT concurrently (see Phase 5.5 notes at the LiveSTT instantiation
# site for what genuine multi-user isolation would require).
async def _subscribe_live_stt_forwarder(ws: "WebSocket", session_id: str) -> None:
    """
    Register this connection as the active live-stt session and subscribe a
    forwarder for STT_TRANSCRIPTION_PARTIAL. If another connection was
    already active, its forwarder is unsubscribed first (last start() wins
    — matches the single-shared-LiveSTT-instance model where only one
    connection's audio is meaningfully being processed at a time anyway).
    """
    if STATE.server_bus is None:
        return

    # Tear down any previously-active connection's forwarder first so we
    # never have two forwarders both subscribed at once.
    await _unsubscribe_live_stt_forwarder(STATE.live_stt_active_session[0] if STATE.live_stt_active_session else None)

    async def _forward_partial(event) -> None:
        # No session_id on the event itself (see module-level note above) —
        # correctness here relies entirely on this closure only being
        # subscribed while this connection is STATE.live_stt_active_session.
        p = event.payload if hasattr(event, "payload") else event
        text = p.get("text", "")
        if not text:
            return
        try:
            await manager.send(ws, {
                "type": "stt_partial",
                "text": text,
                "language": p.get("language", RUNTIME_SETTINGS.get("voice", {}).get("language", "en")),
            })
        except Exception as exc:
            log.debug(f"stt_partial forward failed (connection likely closed): {exc}")

    from perception.speech.voice_events import VoiceEvent as _VE
    STATE.server_bus.subscribe(_VE.STT_TRANSCRIPTION_PARTIAL, _forward_partial)
    STATE.live_stt_forwarders[ws] = _forward_partial
    STATE.live_stt_active_session = (ws, session_id)
    log.debug("LiveSTT partial forwarder subscribed", session_id=session_id)


async def _unsubscribe_live_stt_forwarder(ws: "WebSocket | None") -> None:
    """
    Unsubscribe ws's forwarder (if any) and clear it as the active session
    if it currently is one. Safe to call with ws=None or for a ws that has
    no forwarder registered (no-op).
    """
    if ws is None:
        return
    handler = STATE.live_stt_forwarders.pop(ws, None)
    if handler is not None and STATE.server_bus is not None:
        try:
            from perception.speech.voice_events import VoiceEvent as _VE
            STATE.server_bus.unsubscribe(_VE.STT_TRANSCRIPTION_PARTIAL, handler)
        except Exception as exc:
            log.debug(f"LiveSTT forwarder unsubscribe failed (non-fatal): {exc}")
    if STATE.live_stt_active_session is not None and STATE.live_stt_active_session[0] is ws:
        STATE.live_stt_active_session = None


# ═══════════════════════════════════════════════════════════════════════════════
#  TTS  ─  edge-tts  →  Kokoro ONNX (local fallback)
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
#  TTS  ─  delegates to the canonical TTSEngine (perception/voice/tts.py)
# ═══════════════════════════════════════════════════════════════════════════════
# This used to be a second, independent implementation (separate edge-tts and
# Kokoro calls, hand-rolled here, that never resolved a language-specific
# voice correctly because the STT side always reported "en"). It's now a
# thin wrapper around the single shared STATE.tts_engine instance created in
# on_startup() — see the module-level docstring near STATE.stt_engine/STATE.tts_engine.

_REPLY_HEADER_RE = re.compile(
    r"^(?:#+\s*)?"                             # optional leading ### / ## / #
    r"(?:system\s*response|response|answer|output|result|reply|"
    r"assistant|jarvis\s*(?:response)?|agent\s*\w*\s*(?:response)?)"
    r"\s*[:\-–—]?\s*\n*",
    re.IGNORECASE | re.MULTILINE,
)
_LEADING_DIVIDER_RE = re.compile(r"^(?:---+|\*\*\*+|===+)\s*\n", re.MULTILINE)


def _clean_llm_reply(text: str) -> str:
    """
    Post-process LLM output to remove common artefacts:

    1. Strip leading 'System Response', '### Response:', etc. labels that
       some models emit despite instructions not to.
    2. Remove leading horizontal dividers (---) when they appear at the top.
    3. Collapse 3+ consecutive blank lines into two.

    This is a lightweight, regex-only pass — no heavy NLP required.
    """
    if not text:
        return text

    # Strip leading label up to two passes (some models nest them)
    for _ in range(2):
        stripped = _REPLY_HEADER_RE.sub("", text.lstrip(), count=1).lstrip()
        if stripped != text:
            text = stripped
        else:
            break

    # Remove a bare divider if it's literally the first non-blank content
    text = _LEADING_DIVIDER_RE.sub("", text.lstrip(), count=1)

    # Normalise excessive blank lines
    text = re.sub(r"\n{3,}", "\n\n", text)

    return text.strip()


def _truncate_for_tts(text: str, max_chars: int = 4000) -> str:
    """
    Sentence-boundary length cap so very long LLM replies don't produce
    multi-minute audio downloads in the browser. Pure length policy — markdown
    stripping etc. is handled centrally by TTSEngine.clean_text().
    """
    if len(text) <= max_chars:
        return text
    truncated = text[:max_chars]
    last_sentence = max(
        truncated.rfind(". "),
        truncated.rfind("! "),
        truncated.rfind("? "),
    )
    if last_sentence > max_chars // 2:
        truncated = truncated[: last_sentence + 1]
    return truncated


async def synthesize_speech(text: str, lang: str = "en") -> tuple[bytes, str]:
    """TTS via the shared TTSEngine. Returns (audio_bytes, mime_type)."""
    if STATE.tts_engine is None:
        log.error("STATE.tts_engine not initialised — cannot synthesise")
        return b"", "audio/mpeg"
    capped = _truncate_for_tts(text)
    voice_override = RUNTIME_SETTINGS.get("voice", {}).get("tts_voice", "")
    audio, mime = await asyncio.to_thread(
        STATE.tts_engine.synthesize_only, capped, lang, voice_override
    )
    if audio:
        log.info(f"TTS synthesised via {STATE.tts_engine.__class__.__name__}", language=lang, mime=mime)
    return audio, mime


def _measure_audio_duration_s(audio: bytes, mime: str) -> float | None:
    """
    Compute the real playback duration of TTS audio server-side.

    Why this exists: browsers (Chromium in particular) report
    `audio.duration` as Infinity for streamed/header-less MP3 blobs — which
    is exactly what edge-tts produces — until playback reaches the end.
    That breaks any client-side "reveal text in sync with the audio"
    logic, since currentTime / Infinity is always ~0 until the very last
    frame. Computing the duration here, where the real audio length is
    known, and sending it alongside the audio sidesteps the browser bug
    entirely instead of trying to work around it client-side.
    """
    try:
        import io
        from mutagen import File as MutagenFile

        f = MutagenFile(io.BytesIO(audio))
        if f is not None and f.info is not None and f.info.length:
            return float(f.info.length)
    except Exception as exc:
        log.debug(f"Could not measure TTS audio duration via mutagen: {exc}")

    # Fallback: WAV files carry duration in a plain header we can read
    # without any extra dependency.
    if "wav" in (mime or ""):
        try:
            import io as _io
            import wave

            with wave.open(_io.BytesIO(audio), "rb") as wf:
                frames = wf.getnframes()
                rate = wf.getframerate()
                if rate:
                    return frames / float(rate)
        except Exception as exc:
            log.debug(f"Could not measure WAV duration via wave module: {exc}")

    return None


# ═══════════════════════════════════════════════════════════════════════════════
#  SYSTEM METRICS
# ═══════════════════════════════════════════════════════════════════════════════

_net_prev    = psutil.net_io_counters()
_net_prev_ts = time.time()


def get_metrics() -> dict:
    global _net_prev, _net_prev_ts
    now = time.time()
    dt  = max(now - _net_prev_ts, 0.1)
    net_cur = psutil.net_io_counters()
    up_bps  = (net_cur.bytes_sent - _net_prev.bytes_sent) / dt
    dn_bps  = (net_cur.bytes_recv - _net_prev.bytes_recv) / dt
    _net_prev    = net_cur
    _net_prev_ts = now

    def fmt_speed(bps: float) -> str:
        if bps < 1024:    return f"{bps:.0f} B/s"
        if bps < 1024**2: return f"{bps/1024:.1f} KB/s"
        return f"{bps/1024**2:.1f} MB/s"

    cpu_pct = psutil.cpu_percent(interval=None)
    cpu_per = psutil.cpu_percent(interval=None, percpu=True)
    mem     = psutil.virtual_memory()
    disk    = psutil.disk_usage("/")
    temps   = {}
    try:
        t = psutil.sensors_temperatures()
        for key in ("coretemp", "cpu_thermal", "k10temp", "acpitz"):
            if key in t and t[key]:
                temps["cpu"] = t[key][0].current
                break
    except Exception as _temp_exc:
        # Debug, not warning: get_metrics() is polled every ~1-2s for the live
        # dashboard, and many systems (containers, some laptops/VMs) simply
        # have no exposed thermal sensors — this is expected, not a fault.
        log_exception("get_metrics.sensors_temperatures", _temp_exc, level="debug")

    bat = None
    try:
        b = psutil.sensors_battery()
        if b:
            bat = {"percent": b.percent, "power_plugged": b.power_plugged}
    except Exception as _bat_exc:
        # Same rationale as above — desktops/servers have no battery sensor.
        log_exception("get_metrics.sensors_battery", _bat_exc, level="debug")

    cores = cpu_per[:4] if cpu_per else [cpu_pct] * 4
    while len(cores) < 4:
        cores.append(0.0)

    return {
        "cpu":       round(cpu_pct, 1),
        "cpu_cores": [round(c, 1) for c in cores],
        "ram_pct":   round(mem.percent, 1),
        "ram_used":  round(mem.used / 1024**3, 2),
        "ram_total": round(mem.total / 1024**3, 2),
        "disk_pct":  round(disk.percent, 1),
        "disk_used": round(disk.used / 1024**3, 1),
        "disk_total":round(disk.total / 1024**3, 1),
        "net_up":    fmt_speed(up_bps),
        "net_dn":    fmt_speed(dn_bps),
        "temp_cpu":  temps.get("cpu"),
        "battery":   bat,
        "ts":        now,
    }


def get_diagnostics() -> dict:
    # Phase 2: include orchestrator state so `curl /diagnostics` shows live agent info.
    _orch_info: dict = {"enabled": JARVIS_ENABLE_ORCHESTRATOR, "status": "not loaded"}
    if STATE.orchestrator is not None:
        try:
            _orch_info["status"] = "online"
            _orch_info["agents"] = list(STATE.orchestrator.agents.keys())
            _orch_info["agent_count"] = len(STATE.orchestrator.agents)
        except Exception as _orch_exc:
            log_exception("get_diagnostics.orchestrator_snapshot", _orch_exc)
            _orch_info["status"] = "error"

    # Phase 1: action guard snapshot
    _p1_info: dict = {"enabled": JARVIS_ENABLE_ACTION_GUARD, "status": "not loaded"}
    if STATE.action_guard is not None:
        try:
            _p1_info = STATE.action_guard.health_snapshot()
            _p1_info["status"] = "online"
        except Exception as _p1_exc:
            log_exception("get_diagnostics.action_guard_snapshot", _p1_exc)
            _p1_info["status"] = "error"

    return {
        "os":        platform.system() + " " + platform.release(),
        "hostname":  platform.node(),
        "python":    platform.python_version(),
        "cpu_name":  platform.processor() or "Unknown CPU",
        "cpu_count": psutil.cpu_count(logical=True),
        "uptime":    int(time.time() - psutil.boot_time()),
        "pid":       os.getpid(),
        "action_guard": _p1_info,
        "orchestrator": _orch_info,
    }


# ═══════════════════════════════════════════════════════════════════════════════
#  TOOLS
# ═══════════════════════════════════════════════════════════════════════════════

SAFE_CMDS = {
    "ls", "pwd", "echo", "date", "whoami", "hostname",
    "df", "du", "free", "top", "ps", "uname", "cat",
    "head", "tail", "wc", "grep", "find", "which",
    "python", "python3", "pip", "git",
}

async def tool_run_command(cmd: str) -> str:
    # Security: parse with shlex so quoted args are handled correctly.
    # shell=False means the OS execs the binary directly — no shell expansion,
    # no semicolons, no backticks, no subshells. The SAFE_CMDS allowlist is the
    # only gate needed; the old denylist was security-theatre that shell=True made
    # trivially bypassable (e.g. "echo x; rm -rf /").
    import shlex
    try:
        parts = shlex.split(cmd)
    except ValueError as e:
        log_exception("tool_run_command.shlex_split", e, cmd=cmd)
        return f"[ERROR] Could not parse command: {e}"
    if not parts:
        return "Empty command."
    base = Path(parts[0]).name
    if base not in SAFE_CMDS:
        return f"[BLOCKED] '{base}' not in safe list."
    try:
        result = await asyncio.to_thread(
            subprocess.run,
            parts,          # list — shell=False, no interpolation
            shell=False,    # critical: prevents ; && || $() injection
            capture_output=True,
            text=True,
            timeout=15,
        )
        return ((result.stdout or "") + (result.stderr or ""))[:2000] or "(no output)"
    except subprocess.TimeoutExpired as e:
        log_exception("tool_run_command", e, cmd=cmd, level="warning")
        return "[TIMEOUT]"
    except Exception as e:
        log_exception("tool_run_command", e, cmd=cmd, level="error")
        return f"[ERROR] {e}"


def tool_list_dir(path: str = ".") -> str:
    # P0.1: Route through FilePermissions sandbox — no direct disk access.
    try:
        from actions.filesystem.file_permissions import FilePermissions
        fp = FilePermissions()
        result = fp.check(path, operation="read", requester="tool.list_dir")
        if not result.allowed:
            log.warning(
                "tool_list_dir DENIED path=%r reason=%r requester=tool.list_dir",
                path, result.reason,
            )
            return f"[DENIED] {result.reason}"
        p = Path(path).expanduser().resolve()
        entries = sorted(p.iterdir(), key=lambda x: (x.is_file(), x.name))
        lines = []
        for e in entries[:50]:
            kind = "DIR" if e.is_dir() else "FILE"
            size = ""
            if e.is_file():
                try:
                    sz = e.stat().st_size
                    size = f"  {sz:,} B" if sz < 1024 else f"  {sz//1024:,} KB"
                except Exception as _stat_exc:
                    # Debug only: a single entry's stat() can race with deletion
                    # mid-listing; doesn't affect the rest of the directory listing.
                    log_exception("tool_list_dir.stat_entry", _stat_exc, entry=str(e), level="debug")
            lines.append(f"[{kind}] {e.name}{size}")
        return "\n".join(lines) or "(empty)"
    except Exception as e:
        log.exception("tool_list_dir error path=%r", path)
        return f"[ERROR] {e}"


async def tool_read_file(path: str, max_chars: int = 3000) -> str:
    # P0.1: Route through FilePermissions sandbox — no direct disk access.
    try:
        from actions.filesystem.file_permissions import FilePermissions
        fp = FilePermissions()
        result = fp.check(path, operation="read", requester="tool.read_file")
        if not result.allowed:
            log.warning(
                "tool_read_file DENIED path=%r reason=%r requester=tool.read_file",
                path, result.reason,
            )
            return f"[DENIED] {result.reason}"
        p = Path(path).expanduser().resolve()
        if not p.exists():
            return f"[ERROR] File not found: {path}"
        if p.is_dir():
            return tool_list_dir(path)
        file_content = p.read_text(errors="replace")
        if len(file_content) > max_chars:
            file_content = file_content[:max_chars] + f"\n... (truncated, {len(file_content)} total chars)"
        return file_content
    except Exception as e:
        log.exception("tool_read_file error path=%r", path)
        return f"[ERROR] {e}"


import re as _re_top

# Matches: "open notepad", "launch chrome", "start spotify", "close vscode",
# "quit firefox", "exit notepad", "kill chrome"
_OPEN_RE  = _re_top.compile(r"^\s*(?:open|launch|start|run)\s+(.+?)\s*$", _re_top.IGNORECASE)
_CLOSE_RE = _re_top.compile(r"^\s*(?:close|quit|exit|kill|terminate)\s+(.+?)\s*$", _re_top.IGNORECASE)
_MINIMIZE_RE = _re_top.compile(r"^\s*minimi[sz]e\s+(?:the\s+)?(.+?)\s*(?:window)?\s*$", _re_top.IGNORECASE)
_MAXIMIZE_RE = _re_top.compile(r"^\s*(?:maximi[sz]e|full\s*screen)\s+(?:the\s+)?(.+?)\s*(?:window)?\s*$", _re_top.IGNORECASE)
_FOCUS_RE    = _re_top.compile(r"^\s*(?:focus(?:\s+on)?|switch\s+to|bring\s+up)\s+(?:the\s+)?(.+?)\s*(?:window)?\s*$", _re_top.IGNORECASE)
_CLOSEWIN_RE = _re_top.compile(r"^\s*close\s+(?:the\s+)?(.+?)\s+window\s*$", _re_top.IGNORECASE)

# ── Browser / media automation intents (bypass LLM, dispatch to web.* tools) ──
# Shared "on/in/via/from youtube" or "on/in yt" suffix — YouTube mention
# (in some form) is required to avoid false-positives on generic
# "play ..." chat messages that say nothing about YouTube.
_YT_SUFFIX = r"(?:on|in|via|from)\s+you\s*tube|(?:on|in)\s+yt"

# "play <query> on/in/via/from youtube" / "play <query> on/in yt"
_YT_PLAY_RE = _re_top.compile(
    rf"^\s*play\s+(.+?)\s+(?:{_YT_SUFFIX})\s*$", _re_top.IGNORECASE
)
# "search <query> on/in/via/from youtube", "youtube search <query>", "search youtube for <query>"
_YT_SEARCH_RE = _re_top.compile(
    rf"^\s*(?:search\s+(?:for\s+)?(.+?)\s+(?:{_YT_SUFFIX})|"
    r"you\s*tube\s+search\s+(?:for\s+)?(.+?)|"
    r"search\s+you\s*tube\s+for\s+(.+?))\s*$",
    _re_top.IGNORECASE,
)
# "play the Nth/2nd/3rd result/video for <query> on/in/via/from youtube (or on/in yt)"
_YT_PLAY_INDEX_RE = _re_top.compile(
    rf"^\s*play\s+(?:the\s+)?(\d+)(?:st|nd|rd|th)?\s+(?:result|video)\s+(?:for\s+)?(.+?)"
    rf"(?:\s+(?:{_YT_SUFFIX}))?\s*$",
    _re_top.IGNORECASE,
)


async def _try_app_command(text: str) -> str | None:
    """
    Lightweight intent detector for 'open X' / 'close X' style commands.
    Bypasses the LLM and dispatches directly to apps.open / apps.close via
    the ToolRegistry. Returns a reply string if handled, else None.
    """
    if STATE.tool_registry is None:
        return None

    # ── YouTube play/search intents (bypass LLM — actually drive the browser) ──
    m = _YT_PLAY_INDEX_RE.match(text)
    if m:
        idx = int(m.group(1))
        query = m.group(2).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("web.youtube_play", query=query, index=idx)
        if result.success:
            val = result.value or {}
            return (f"▶️ {val.get('message')}" if val.get("success")
                    else f"⚠️ {val.get('message', 'Could not play that result.')}")
        return f"⚠️ {result.error}"

    m = _YT_SEARCH_RE.match(text)
    if m:
        query = next((g for g in m.groups() if g), "").strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("web.youtube_search", query=query)
        if result.success:
            val = result.value or {}
            count = val.get("result_count", 0)
            return f"🔍 Searched YouTube for \"{query}\" — found {count} result(s)."
        return f"⚠️ {result.error}"

    m = _YT_PLAY_RE.match(text)
    if m:
        query = m.group(1).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("web.youtube_play", query=query, index=1)
        if result.success:
            val = result.value or {}
            return (f"▶️ {val.get('message')}" if val.get("success")
                    else f"⚠️ {val.get('message', 'Could not play that.')}")
        return f"⚠️ {result.error}"

    # Window commands checked first (more specific patterns)
    m = _CLOSEWIN_RE.match(text)
    if m:
        title = m.group(1).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("window.close", title=title)
        if result.success:
            val = result.value or {}
            return (f"✅ {val.get('message')}" if val.get("success")
                    else f"⚠️ {val.get('message')}")
        return f"⚠️ {result.error}"

    m = _MINIMIZE_RE.match(text)
    if m:
        title = m.group(1).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("window.minimize", title=title)
        if result.success:
            val = result.value or {}
            return (f"✅ {val.get('message')}" if val.get("success")
                    else f"⚠️ {val.get('message')}")
        return f"⚠️ {result.error}"

    m = _MAXIMIZE_RE.match(text)
    if m:
        title = m.group(1).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("window.maximize", title=title)
        if result.success:
            val = result.value or {}
            return (f"✅ {val.get('message')}" if val.get("success")
                    else f"⚠️ {val.get('message')}")
        return f"⚠️ {result.error}"

    m = _FOCUS_RE.match(text)
    if m:
        title = m.group(1).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("window.focus", title=title)
        if result.success:
            val = result.value or {}
            return (f"✅ {val.get('message')}" if val.get("success")
                    else f"⚠️ {val.get('message')}")
        return f"⚠️ {result.error}"

    m = _OPEN_RE.match(text)
    if m:
        target = m.group(1).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("apps.open", name=target)
        if result.success:
            val = result.value or {}
            if val.get("success"):
                return f"✅ {val.get('message', f'Opened {target}.')}"
            return f"⚠️ {val.get('message', f'Could not open {target}.')}"
        return f"⚠️ {result.error}"

    m = _CLOSE_RE.match(text)
    if m:
        target = m.group(1).strip().rstrip(".!?")
        result = await STATE.tool_registry.invoke("apps.close", name=target)
        if result.success:
            val = result.value or {}
            if val.get("success"):
                return f"✅ {val.get('message', f'Closed {target}.')}"
            return f"⚠️ {val.get('message', f'Could not close {target}.')}"
        return f"⚠️ {result.error}"

    return None


async def dispatch_tool(name: str, args: dict) -> str:
    # Phase 0 metrics: count every tool invocation through this single funnel
    # regardless of which branch below actually handles it. Non-fatal if the
    # collector isn't loaded (STATE.metrics_collector is None).
    _t0 = time.monotonic()
    if STATE.metrics_collector is not None:
        STATE.metrics_collector.increment("tool_invocations_total")
        STATE.metrics_collector.increment(f"tool_invocations.{name}")
    try:
        return await _dispatch_tool_impl(name, args)
    finally:
        if STATE.metrics_collector is not None:
            STATE.metrics_collector.record_latency("tool_invocation", (time.monotonic() - _t0) * 1000)


async def _dispatch_tool_impl(name: str, args: dict) -> str:
    if name == "run_command":  return await tool_run_command(args.get("cmd", ""))
    if name == "list_dir":     return tool_list_dir(args.get("path", "."))
    if name == "read_file":    return await tool_read_file(args.get("path", ""))
    if name == "system_info":
        return json.dumps({**get_metrics(), **get_diagnostics()}, indent=2)
    if name == "memory_stats":
        return json.dumps(memory.stats(), indent=2)

    # P-12 / P0.2: Browser tools via Playwright — must pass STATE.action_guard first.
    if name.startswith("browser_") or name in ("browser_navigate", "browser_extract",
                                                 "browser_interact", "browser_screenshot"):
        # Gate every browser call through ActionGuard / PolicyEngine.
        if STATE.action_guard is not None:
            from actions.action_events import ActionRequest
            req = ActionRequest(
                request_id=__import__("uuid").uuid4().hex,
                requester="tool.browser",
                action_type="browser",
                action_name=name,
                parameters=args,
            )
            guard_result = await STATE.action_guard.evaluate(req)
            if not guard_result.approved:
                log.warning(
                    "browser tool DENIED name=%r reason=%r", name, guard_result.reason
                )
                return f"[DENIED] Browser action blocked by policy: {guard_result.reason}"
        if STATE.browser_tools is not None:
            try:
                return await STATE.browser_tools.dispatch(name, args)
            except Exception as e:
                log.exception("browser tool dispatch error name=%r", name)
                return f"[ERROR] Browser tool {name}: {e}"
        return "Browser tools not available (Playwright not installed — run: playwright install chromium)"

    # ── Fallback: full ToolRegistry (browser.*, web.*, fs.*, code.*, etc.) ──
    if STATE.tool_registry is not None:
        result = await STATE.tool_registry.invoke(name, **args)
        if result.success:
            try:
                return json.dumps(result.value, indent=2, default=str)
            except Exception:
                return str(result.value)
        return f"[ERROR] {result.error}"

    return f"[ERROR] Unknown tool: {name}"


# ═══════════════════════════════════════════════════════════════════════════════
#  WEBSOCKET MANAGER
# ═══════════════════════════════════════════════════════════════════════════════

class ConnectionManager:
    # P-06: Per-connection rate-limit settings (configurable via RUNTIME_SETTINGS)
    _RATE_LIMIT_MSGS: int = 30     # max messages
    _RATE_LIMIT_WINDOW: float = 10.0  # seconds

    def __init__(self):
        self._clients: set[WebSocket] = set()
        # P-06: {ws: {"msg_times": deque(maxlen=30)}}
        self._states: dict[WebSocket, dict] = {}

    async def connect(self, ws: WebSocket):
        await ws.accept()
        self._clients.add(ws)
        from collections import deque
        self._states[ws] = {"msg_times": deque(maxlen=self._RATE_LIMIT_MSGS)}
        log.info(f"HUD connected ({len(self._clients)} clients)")

    def disconnect(self, ws: WebSocket):
        self._clients.discard(ws)
        self._states.pop(ws, None)
        log.info(f"HUD disconnected ({len(self._clients)} clients)")

    def is_rate_limited(self, ws: WebSocket) -> bool:
        """Return True if this connection has exceeded the rate limit."""
        state = self._states.get(ws)
        if state is None:
            return False
        now = time.time()
        times = state["msg_times"]
        times.append(now)
        # Count messages within the window
        limit = RUNTIME_SETTINGS.get("rate_limit_msgs", self._RATE_LIMIT_MSGS)
        window = RUNTIME_SETTINGS.get("rate_limit_window", self._RATE_LIMIT_WINDOW)
        recent = sum(1 for t in times if now - t <= window)
        return recent > limit

    async def broadcast(self, msg: dict):
        dead = set()
        for ws in self._clients:
            try:
                await ws.send_text(json.dumps(msg))
            except Exception:
                dead.add(ws)
        for ws in dead:
            self._clients.discard(ws)

    async def send(self, ws: WebSocket, msg: dict):
        await ws.send_text(json.dumps(msg))
        # P-11: Keep a short replay buffer per connection (last 5 messages)
        state = self._states.get(ws)
        if state is not None:
            buf = state.setdefault("replay_buf", [])
            buf.append(msg)
            if len(buf) > 5:
                buf.pop(0)


manager = ConnectionManager()


# ═══════════════════════════════════════════════════════════════════════════════
#  WEBSOCKET ENDPOINT
# ═══════════════════════════════════════════════════════════════════════════════

@app.websocket("/ws")
async def ws_endpoint(ws: WebSocket):
    # Auth: if JARVIS_SECRET is configured, require ?token=<secret> in the URL.
    # The HUD client must append the token when opening the WebSocket connection.
    if SERVER_SECRET:
        token = ws.query_params.get("token", "")
        if token != SERVER_SECRET:
            await ws.close(code=4401, reason="Unauthorized")
            log.warning("WebSocket rejected — invalid or missing token")
            return

    await manager.connect(ws)
    diag      = get_diagnostics()
    mem_stats = memory.stats()
    # P-28: Include recent chat history in the boot message so the UI can
    # display previous session context without a separate round-trip.
    # P1.2: Serve recent history from MemoryRouter (canonical); fallback to shim.
    _boot_session_id = ws.query_params.get("session_id", "default") or "default"
    if STATE.memory_router is not None:
        recent_history = STATE.memory_router.recent_messages(n=20)
    else:
        recent_history = memory.recall_recent(20, session_id=_boot_session_id)
    mem_stats = (
        await STATE.memory_router.stats()
        if STATE.memory_router is not None
        else memory.stats()
    )
    await manager.send(ws, {
        "type":        "boot",
        "tunnel_url":  _ngrok_tunnel_url,
        "diagnostics": diag,
        "memory_stats": mem_stats,
        "recent_history": recent_history,   # P-28 / P1.2
        "providers": {
            "groq":   bool(GROQ_KEY),
            "qwen_openvino": _qwen_openvino_enabled(),
            "gemini": bool(GEMINI_KEY),
            "ollama": True,   # always available as local fallback
        },
        "agents": {aid: _agent_metrics_message(aid) for aid in AGENT_REGISTRY},
        "settings": RUNTIME_SETTINGS,
    })
    try:
        while True:
            raw = await ws.receive_text()
            msg = json.loads(raw)
            # P-11: Handle reconnect handshake — replay buffered messages
            if msg.get("type") == "reconnect":
                state = manager._states.get(ws, {})
                replay = state.get("replay_buf", [])
                for buffered_msg in replay:
                    try:
                        await ws.send_text(json.dumps(buffered_msg))
                    except Exception:
                        break
                # Phase 10.3: reconnect boot payload must include model state
                # and fallback stats so a dropped connection doesn't leave the
                # HUD showing a stale model name or hiding fallback history.
                _reconnect_model_state: dict = {}
                _reconnect_fallback: dict = {}
                try:
                    from models.switcher.model_switcher import ModelSwitcher as _MSR
                    _reconnect_model_state = _MSR.get_instance().get_state()
                except Exception:
                    pass
                try:
                    _reconnect_fallback = _compute_fallback_stats()
                except Exception:
                    pass
                await manager.send(ws, {
                    "type": "boot", "reconnected": True,
                    "diagnostics": diag, "memory_stats": memory.stats(),
                    "recent_history": memory.recall_recent(20),
                    "agents": {aid: _agent_metrics_message(aid) for aid in AGENT_REGISTRY},
                    "settings": RUNTIME_SETTINGS,
                    # Phase 10.3 additions:
                    "model_state":    _reconnect_model_state,
                    "fallback_stats": _reconnect_fallback,
                })
                continue
            try:
                await _handle_message(ws, msg)
            except WebSocketDisconnect:
                raise
            except Exception as exc:
                # FIXED: previously any uncaught error from a single message
                # (e.g. the missing-synthesize_only crash) propagated up to
                # the outer except below and disconnected the whole session.
                # Isolate per-message failures so the connection — and the
                # rest of the conversation — survives one bad message.
                log.error(
                    f"Message handler error (type={msg.get('type')}): {exc}",
                    exc_info=True,
                )
                try:
                    await manager.send(ws, {"type": "status", "text": "▸ READY"})
                except Exception:
                    pass
    except WebSocketDisconnect:
        manager.disconnect(ws)
        # Phase 5.4: a dropped connection that had live STT active would
        # otherwise leave its forwarder subscribed forever — every future
        # partial would try to manager.send() on a dead ws (caught/logged,
        # but a permanent leaked subscription + busywork on every partial).
        await _unsubscribe_live_stt_forwarder(ws)
    except Exception as e:
        log.error(f"WS error: {e}")
        manager.disconnect(ws)
        await _unsubscribe_live_stt_forwarder(ws)


async def _handle_message(ws: WebSocket, msg: dict):
    global model_switcher
    mtype = msg.get("type", "")

    # P-06: Per-connection rate limiting (drop if >30 msgs / 10s)
    if manager.is_rate_limited(ws):
        await manager.send(ws, {"type": "error", "text": "Rate limit exceeded. Slow down."})
        return

    # ── AI chat ────────────────────────────────────────────────────────────────
    if mtype == "chat":
        agent = _resolve_agent(msg.get("agent", "oracle"))
        text  = msg.get("text", "").strip()

        # P-06: Input sanitization
        if len(text) > 8000:
            await manager.send(ws, {"type": "status", "text": "▸ Message truncated to 8000 chars."})
            text = text[:8000]
        if text and not text.strip():
            return  # only whitespace

        files = msg.get("files") or []
        if not text and not files:
            return

        # ── Read attached files and fold their content into the prompt ─────
        file_context = ""
        if files:
            file_context = await _build_file_context(files)
            if not text:
                text = "Please review the attached file(s)."

        _ws_session_id = msg.get("session_id", "default") or "default"
        await memory.add_episode(
            "user", agent, text if not files else f"{text}  [files: {', '.join(files)}]",
            session_id=_ws_session_id,
        )
        # Push to the rolling conversation buffer (OpenAI-format) so call_ai()
        # can include recent history in the LLM prompt.
        if STATE.memory_router is not None:
            STATE.memory_router.remember_turn(
                "user", text,
                session_id=msg.get("session_id", "default") or "default",
            )
        await manager.send(ws, {"type": "status",   "text": f"▸ {agent.upper()} PROCESSING..."})
        await manager.send(ws, {"type": "thinking", "agent": agent})

        _mark_agent_working(agent, text)
        await manager.broadcast(_agent_metrics_message(agent))

        # ── App open/close intent shortcut (bypasses LLM) ───────────────────
        app_reply = await _try_app_command(text) if not files else None
        if app_reply is not None:
            await memory.add_episode("assistant", agent, app_reply, session_id=_ws_session_id)
            _mark_agent_done(agent, success=True)
            await manager.broadcast(_agent_metrics_message(agent))
            await manager.send(ws, {
                "type": "chat_reply", "agent": agent, "text": app_reply, "provider": "TOOL",
            })
            await manager.send(ws, {"type": "status", "text": "▸ READY"})
            await manager.send(ws, {"type": "memory_stats", **memory.stats()})
            return

        # Build the message actually sent to the LLM, including file content
        llm_input = text
        if file_context:
            llm_input = f"{text}\n\n{file_context}"

        # Pull recent conversation turns to include as history context.
        prior_turns = (
            STATE.memory_router.recent_messages(n=10) if STATE.memory_router is not None else []
        )

        # P-10: Streaming — only when client requests it AND the selected provider
        # is Groq (streaming is only implemented for Groq in server.py).
        # If the user switched to Gemini/Ollama, fall through to call_ai() which
        # handles those providers correctly.
        try:
            from models.switcher.model_switcher import ModelSwitcher as _MS2
            _active_prov = _MS2.get_instance().current_provider.lower()
        except Exception:
            _active_prov = "groq"
        want_stream = msg.get("stream", False) and bool(GROQ_KEY) and _active_prov == "groq"
        t_start = time.monotonic()

        # Phase 6.4 / 6.5 — initialized here, before the want_stream branch
        # splits execution, so reply_payload's later unconditional reads of
        # these are always defined regardless of which branch ran (streaming/
        # Groq never touches the orchestrator or call_ai()'s AIReply, so it
        # has nothing to report for either — that's a real "no" answer, not
        # an unset variable).
        _orch_reply: str | None = None
        _orch_agent: str | None = None
        _orch_fallback_occurred = False    # Phase 8.3
        _orch_fallback_details: list = []  # Phase 8.3
        _fallback_occurred = False
        _fallback_selected = ""

        try:
            if want_stream:
                # Build system + messages the same way call_ai() does
                # P1.2: Use session-scoped history to prevent cross-tab crosstalk.
                _agent_id = _resolve_agent(agent)
                _sess_id = msg.get("session_id", "default") or "default"
                _sess_hist_s = _histories.setdefault(_sess_id, {})
                _hist = _sess_hist_s.setdefault(_agent_id, [])
                if not _hist and prior_turns:
                    _hist.extend(prior_turns)
                _hist.append({"role": "user", "content": llm_input})
                if len(_hist) > 20:
                    _sess_hist_s[_agent_id] = _hist[-20:]
                    _hist = _sess_hist_s[_agent_id]
                _system = AGENT_PROMPTS.get(_agent_id, AGENT_PROMPTS["oracle"])
                recent = memory.recall_recent(3)
                if recent:
                    ctx = "\n".join(f"[{r['agent'].upper()}] {r['role']}: {r['content']}" for r in recent)
                    _system += f"\n\nRecent context from memory:\n{ctx}"
                _groq_last_usage.clear()
                reply = await _call_groq_streaming(_agent_id, list(_hist), _system, ws)
                _hist.append({"role": "assistant", "content": reply})
                await memory.add_episode("assistant", agent, reply, session_id=_sess_id)
                provider = "GROQ"
                _last_provider = provider
                _mark_agent_done(agent, success=True)
            else:
                # ── Orchestrator path (Phase 3 bridge fix applied) ──────────
                # When JARVIS_ENABLE_ORCHESTRATOR=true and the orchestrator is
                # running, submit the intent through the Coordinator Agent so the
                # real specialist agents execute.  The orchestrator publishes
                # agent.workflow.step events which the existing _on_workflow_step
                # relay already broadcasts to HUD clients.
                #
                # The orchestrator is event-driven and does not return a reply
                # synchronously. We wait up to JARVIS_ORCH_REPLY_TIMEOUT_S for
                # a "user.reply" event on the bus (Phase 3.1 fix — previously
                # listened for events that were never published); if nothing
                # comes back in time we fall through to the regular call_ai()
                # path so the user never sees a timeout with no answer.
                # Phase 3.3 added a fast path inside CoordinatorAgent for
                # simple messages — those reply almost immediately and never
                # stress this timeout. Requests that do reach this wait are,
                # by construction, the ones that needed full planning, so the
                # timeout (Phase 3.4) was raised accordingly — see the
                # JARVIS_ORCH_REPLY_TIMEOUT_S definition above for the full
                # rationale and its current un-measured status.
                _orch_provider: str = "STATE.orchestrator"
                if STATE.orchestrator is not None and not files:
                    try:
                        import asyncio as _aio
                        _reply_ready: _aio.Event = _aio.Event()
                        _orch_result: dict = {}

                        _orch_session_id = msg.get("session_id", "") or "default"

                        async def _capture_orch_reply(event) -> None:
                            p = event.payload if hasattr(event, "payload") else event
                            # Phase 3.2: real session isolation check (no more `or True`
                            # no-op). user.reply now always carries session_id (propagated
                            # from the original user.intent submission via base_agent.py /
                            # coordinator_agent.py), so this comparison is meaningful.
                            if p.get("session_id", "") == _orch_session_id:
                                # Phase 3.1: CoordinatorAgent publishes "user.reply" with
                                # payload key "text" (not content/reply/result).
                                content = p.get("text", "")
                                if content:
                                    _orch_result["reply"] = str(content)
                                    _orch_result["agent"] = p.get("agent", agent)
                                    _orch_result["fallback_occurred"] = bool(p.get("fallback_occurred"))
                                    _orch_result["fallback_details"] = p.get("fallback_details") or []
                                    _reply_ready.set()

                        # Phase 3.1: subscribe to the event CoordinatorAgent actually
                        # publishes. "agent.response" / "orchestrator.response" are never
                        # published anywhere in the codebase — that mismatch was the root
                        # cause of the 100%-fallback-to-call_ai() bug.
                        STATE.server_bus.subscribe("user.reply", _capture_orch_reply)

                        await STATE.orchestrator.submit_intent(
                            text=llm_input,
                            session_id=_orch_session_id,
                            metadata={"agent_hint": agent, "ws_client": True},
                        )

                        try:
                            await _aio.wait_for(_reply_ready.wait(), timeout=JARVIS_ORCH_REPLY_TIMEOUT_S)
                            _orch_reply = _orch_result.get("reply")
                            # Phase 6.5: this was already captured into _orch_result
                            # by _capture_orch_reply above (coordinator_agent.py's
                            # "user.reply" carries the real specialist name(s), e.g.
                            # "engineering_agent", or a comma-joined list for a
                            # multi-agent plan) but was previously discarded here —
                            # nothing downstream ever read _orch_result["agent"].
                            _orch_agent = _orch_result.get("agent")
                            # Phase 8.3: surface fallback events recorded by the
                            # specialist agent(s) that produced this orchestrator
                            # reply — previously discarded here (see note below).
                            _orch_fallback_occurred = bool(_orch_result.get("fallback_occurred"))
                            _orch_fallback_details = _orch_result.get("fallback_details") or []
                        except _aio.TimeoutError:
                            log.warning(
                                f"Phase 3: orchestrator did not reply within "
                                f"{JARVIS_ORCH_REPLY_TIMEOUT_S}s — falling back to call_ai()"
                            )
                        finally:
                            # Always clean up — use the public unsubscribe() API
                            try:
                                STATE.server_bus.unsubscribe("user.reply", _capture_orch_reply)
                            except Exception:
                                pass
                    except Exception as _oe:
                        log.warning(f"Phase 3: orchestrator routing error ({_oe}) — falling back to call_ai()")
                        _orch_reply = None

                # Phase 8.3: the orchestrator path doesn't go through
                # ModelRouter.complete() in a way this wrapper observes
                # directly, but CoordinatorAgent / BaseAgent.complete() now
                # records any fallback the specialist agent(s) hit and
                # threads it back through "user.reply" -> _orch_result above.
                if _orch_fallback_occurred:
                    _fallback_occurred = True
                    _fallback_selected = ", ".join(
                        d.get("selected", "") for d in _orch_fallback_details if d.get("selected")
                    ) or "unknown"

                if _orch_reply is not None:
                    reply = _orch_reply
                    provider = _orch_provider
                    _mark_agent_done(agent, success=True)
                else:
                    _ai_reply: AIReply = await call_ai(
                        agent, llm_input, history=prior_turns,
                        session_id=msg.get("session_id", "default") or "default",
                    )
                    reply    = _ai_reply.text
                    provider = _ai_reply.provider
                    _fallback_occurred = _ai_reply.fallback_occurred
                    _fallback_selected = _ai_reply.fallback_selected
                    _mark_agent_done(agent, success=(provider != "NONE"))
        except Exception as e:
            reply, provider = f"[ERROR] {e}", "NONE"
            _orch_agent = None
            _fallback_occurred = False
            _fallback_selected = ""
            _mark_agent_done(agent, success=False)

        latency_s = round(time.monotonic() - t_start, 2)
        await manager.broadcast(_agent_metrics_message(agent))

        # ── Post-process: strip LLM label artefacts ("System Response" etc.) ──
        reply = _clean_llm_reply(reply)

        # Push assistant reply into conversation buffer for next turn's history.
        if STATE.memory_router is not None and not reply.startswith("[ERROR]"):
            STATE.memory_router.remember_turn("assistant", reply)

        # ── DailySummary: ingest this interaction as a decision event ─────────
        if STATE.daily_summary is not None:
            import time as _time
            try:
                STATE.daily_summary.aggregate_events([{
                    "category": "decision",
                    "timestamp": _time.time(),
                    "source": f"agent.{agent}",
                    "action": text[:80],
                    "score": 0.8 if not reply.startswith("[ERROR]") else 0.2,
                    "confidence": "high" if provider not in ("NONE",) else "low",
                }])
            except Exception as _ds_exc:
                log.debug(f"DailySummary ingest failed: {_ds_exc}")

        # P-19: Build usage + cost payload for the reply
        _usage = None
        _cost  = None
        if provider == "GROQ" and _groq_last_usage:
            _usage = {
                "prompt":     _groq_last_usage.get("prompt", 0),
                "completion": _groq_last_usage.get("completion", 0),
                "total":      _groq_last_usage.get("total", 0),
            }
            # Groq pricing ~$0.59 per 1M tokens (llama-3.3-70b-versatile, 2026)
            _cost = round(_usage["total"] * 0.00000059, 6)

        reply_payload: dict = {
            "type":     "chat_reply",
            "agent":    agent,
            "text":     reply,
            "provider": provider,
            "latency_s": latency_s,
        }
        if _usage:
            reply_payload["usage"] = _usage
        if _cost is not None:
            reply_payload["cost_usd"] = _cost

        # Phase 6.4 / 7.1 — fallback visibility. Only present when a fallback
        # actually happened, so existing/old clients that don't check for
        # these keys see no behavior change, and new clients can render
        # "answered by Groq — Ollama unavailable" instead of a silently
        # mislabeled reply.
        if _fallback_occurred:
            reply_payload["fallback_occurred"] = True
            reply_payload["fallback_selected"] = _fallback_selected
            reply_payload["answered_by"] = provider
            if _orch_fallback_details:  # Phase 8.3
                reply_payload["fallback_details"] = _orch_fallback_details

        # Phase 6.5 — specialist attribution. Only present when this reply
        # actually came from the orchestrator path, so the frontend can show
        # which of the 7 registered specialists (or which combination, for a
        # multi-agent plan) produced the answer.
        if _orch_reply is not None:
            reply_payload["via_orchestrator"] = True
            reply_payload["answered_by_agent"] = _orch_agent or agent

        # ── TTS SYNC FIX ─────────────────────────────────────────────────────
        # Synthesise TTS BEFORE sending chat_reply so both messages go out in
        # the same network burst.  The client (jarvisV3.html _holdReplyForVoiceSync)
        # holds the text bubble until tts_audio arrives; if we sent chat_reply
        # first the user saw text appear 1-3 s before audio started — visible
        # de-sync.  By synthesising first we pay the latency server-side (the
        # user sees the "PROCESSING..." spinner a little longer) but the moment
        # the bubble appears it is already accompanied by audio.
        tts_enabled = RUNTIME_SETTINGS.get("voice", {}).get("tts_enabled", True)
        tts_payload: dict | None = None
        if msg.get("tts", False) and tts_enabled:
            lang = RUNTIME_SETTINGS.get("voice", {}).get("language", "en")
            try:
                audio, mime = await synthesize_speech(reply, lang)
                if audio:
                    b64 = base64.b64encode(audio).decode()
                    duration_s = _measure_audio_duration_s(audio, mime)
                    tts_payload = {
                        "type": "tts_audio", "b64": b64, "mime": mime,
                        "duration_s": duration_s,
                    }
                    log.info("TTS pre-synthesised (%d bytes, %.1fs) — sending with reply",
                             len(audio), duration_s or 0)
            except Exception as exc:
                # Keep the WS session alive — TTS failure must not kill the
                # chat connection (see earlier bug where this crashed the WS).
                log.error(f"TTS synthesis failed: {exc}", exc_info=True)

        # Send reply first, then TTS immediately after — both hit the client in
        # the same TCP window so the gap is sub-millisecond on localhost.
        await manager.send(ws, reply_payload)
        if tts_payload is not None:
            await manager.send(ws, tts_payload)
            # Phase 10.2: TTS audio is now on its way to the client.
            # Tell InterruptDetector to start monitoring the mic so the user
            # can barge in while JARVIS is speaking.  Only fires when the
            # always-listening pipeline (and therefore STATE.interrupt_detector)
            # is active; the WS push-to-talk path keeps working unchanged if it
            # isn't (graceful no-op via the None guard).
            if STATE.interrupt_detector is not None:
                _tts_session_id = f"ptt_{uuid.uuid4().hex[:8]}"
                try:
                    await STATE.interrupt_detector.begin_monitoring(_tts_session_id)
                    # Schedule stop_monitoring for when the audio duration elapses.
                    # duration_s may be 0 or None if measurement failed — use 30s cap.
                    _dur = (tts_payload.get("duration_s") or 0.0)
                    _dur = max(1.0, min(_dur + 1.5, 30.0))  # +1.5s buffer, 30s cap
                    async def _stop_ptt_monitor(_sid=_tts_session_id) -> None:
                        import asyncio as _aio
                        await _aio.sleep(_dur)
                        if STATE.interrupt_detector is not None:
                            try:
                                await STATE.interrupt_detector.stop_monitoring()
                            except Exception:
                                pass
                    asyncio.ensure_future(_stop_ptt_monitor())
                except Exception as _barge_exc:
                    log.debug("Phase 10.2: barge-in begin_monitoring failed (non-fatal): %s", _barge_exc)
        await manager.send(ws, {"type": "status", "text": "▸ READY"})
        await manager.send(ws, {"type": "memory_stats", **memory.stats()})

    # ── STT audio (batch: record → send full blob) ─────────────────────────
    elif mtype == "stt_audio":
        b64  = msg.get("data", "")
        mime = msg.get("mime", "audio/webm")
        if not b64:
            return
        audio_bytes = base64.b64decode(b64)
        await manager.send(ws, {"type": "status", "text": "▸ TRANSCRIBING..."})
        try:
            transcript, lang = await transcribe_audio(audio_bytes, mime)
        except Exception as exc:
            log.error(f"STT transcription failed: {exc}", exc_info=True)
            transcript = ""
            lang = RUNTIME_SETTINGS.get("voice", {}).get("language", "en")
            await manager.send(ws, {"type": "status", "text": "▸ TRANSCRIPTION FAILED"})
        await manager.send(ws, {"type": "stt_result", "transcript": transcript, "language": lang})
        RUNTIME_SETTINGS.setdefault("voice", {})["language"] = lang
        await manager.send(ws, {"type": "status",     "text": "▸ READY"})

    # ── Live STT toggle ────────────────────────────────────────────────────
    # Sent by the mic-toggle button in the HUD.
    # {"type": "live_stt_start"}  → server signals back "listening" status
    # {"type": "live_stt_stop"}   → server signals back "ready" status
    #
    # Phase 5.2: previously this only sent a WS ack back to the client —
    # nothing was ever published on STATE.server_bus, so LiveSTT's
    # _on_live_stt_start/_on_live_stt_stop handlers (which exist and are
    # subscribed — see perception/speech/live_stt.py) never actually fired.
    # Real VoiceEvent.LIVE_STT_START/STOP are now published so LiveSTT
    # activates/deactivates its streaming session correctly.
    #
    # Phase 5.4: also registers/tears down this connection's session-scoped
    # stt_partial forwarder — see _subscribe_live_stt_forwarder()'s
    # docstring above for what session-scoping does and doesn't guarantee
    # given the single-shared-LiveSTT-instance model (Phase 5.5).
    elif mtype == "live_stt_start":
        log.info("Live STT started (client mic toggle ON)")
        _sess_id = msg.get("session_id", "default") or "default"
        if STATE.server_bus is not None:
            try:
                from perception.speech.voice_events import live_stt_start_event
                await STATE.server_bus.publish(live_stt_start_event(session_id=_sess_id))
                await _subscribe_live_stt_forwarder(ws, _sess_id)
            except Exception as exc:
                log.error(f"Failed to publish LIVE_STT_START: {exc}", exc_info=True)
        else:
            log.warning("live_stt_start received but STATE.server_bus is None — LiveSTT will not activate")
        await manager.send(ws, {"type": "status", "text": "▸ LISTENING..."})
        await manager.send(ws, {"type": "live_stt_ack", "active": True})

    elif mtype == "live_stt_stop":
        log.info("Live STT stopped (client mic toggle OFF)")
        _sess_id = msg.get("session_id", "default") or "default"
        if STATE.server_bus is not None:
            try:
                from perception.speech.voice_events import live_stt_stop_event
                await STATE.server_bus.publish(live_stt_stop_event(session_id=_sess_id))
            except Exception as exc:
                log.error(f"Failed to publish LIVE_STT_STOP: {exc}", exc_info=True)
        else:
            log.warning("live_stt_stop received but STATE.server_bus is None — LiveSTT will not deactivate")
        await _unsubscribe_live_stt_forwarder(ws)
        await manager.send(ws, {"type": "status", "text": "▸ READY"})
        await manager.send(ws, {"type": "live_stt_ack", "active": False})

    # ── Streaming mic chunk (partial Live-STT path) ────────────────────────
    # The frontend can stream 1-2s audio blobs as {"type": "mic_chunk",
    # "data": "<b64>", "mime": "audio/webm"} while recording for real-time
    # partial transcription feedback.
    #
    # Phase 5.1: previously each chunk was sent through transcribe_audio()
    # — the heavyweight full-Whisper/Groq STT_ENGINE path meant for complete
    # utterances, not 1-2s streaming partials. That's expensive (a full
    # model call every ~1-2s) and bypasses LiveSTT entirely.
    #
    # Now: decode the WebM/Opus blob to raw 16kHz mono PCM and publish it as
    # a VoiceEvent.MIC_AUDIO_CHUNK on STATE.server_bus. LiveSTT
    # (perception/speech/live_stt.py) already subscribes to that event and
    # runs its own lightweight streaming inference (faster-whisper tiny.en,
    # 750ms stride) — it publishes VoiceEvent.STT_TRANSCRIPTION_PARTIAL
    # itself when it has something to say. This handler no longer calls
    # STT_ENGINE/transcribe_audio() at all for partials.
    #
    # Phase 5.4: the resulting partials ARE now forwarded back to the
    # connection that called live_stt_start, as {"type": "stt_partial", ...}
    # — see _subscribe_live_stt_forwarder() above, wired in the
    # live_stt_start/live_stt_stop handlers. This mic_chunk handler itself
    # doesn't need a session_id, since correctness comes from which
    # forwarder is currently subscribed, not from tagging individual chunks.
    elif mtype == "mic_chunk":
        b64  = msg.get("data", "")
        mime = msg.get("mime", "audio/webm")
        if not b64:
            return
        try:
            audio_bytes = base64.b64decode(b64)
        except Exception as exc:
            log.debug(f"mic_chunk: invalid base64 payload, dropping chunk: {exc}")
            return

        if STATE.server_bus is None:
            log.warning("mic_chunk received but STATE.server_bus is None — cannot reach LiveSTT")
            return

        try:
            pcm_bytes = await asyncio.to_thread(_decode_container_to_pcm16, audio_bytes, mime)
        except Exception as exc:
            log.debug(f"mic_chunk: PCM decode failed, dropping chunk: {exc}")
            return

        if not pcm_bytes:
            # Decode failure or empty chunk already logged inside the
            # decoder — just skip this chunk rather than raising, since WS
            # mic streaming will keep sending more chunks regardless.
            return

        try:
            from perception.speech.voice_events import mic_chunk_event
            await STATE.server_bus.publish(
                mic_chunk_event(pcm_bytes, sample_rate=_LIVE_STT_PCM_SAMPLE_RATE)
            )
        except Exception as exc:
            log.error(f"Failed to publish MIC_AUDIO_CHUNK: {exc}", exc_info=True)

    # ── Tool ─────────────────────────────────────────────────────────────────
    elif mtype == "tool":
        tool_name = msg.get("tool", "")
        args      = msg.get("args", {})
        await manager.send(ws, {"type": "status", "text": f"▸ TOOL: {tool_name.upper()}"})
        result = await dispatch_tool(tool_name, args)
        # P-12: browser_screenshot may return raw bytes — base64-encode them for the UI
        if tool_name == "browser_screenshot" and isinstance(result, bytes):
            b64_img = base64.b64encode(result).decode()
            await manager.send(ws, {
                "type": "tool_result", "tool": tool_name,
                "image_b64": b64_img, "mime": "image/png",
            })
        else:
            await manager.send(ws, {"type": "tool_result", "tool": tool_name, "result": result})
        await manager.send(ws, {"type": "status", "text": "▸ READY"})

    # ── Memory store ──────────────────────────────────────────────────────────
    elif mtype == "memory_store":
        # P1.2: Route exclusively through MemoryRouter (canonical); _MemoryShim
        # falls back to the JSON file if STATE.memory_router is not yet ready.
        key = msg.get("key", "")
        val = msg.get("value", "")
        _store_sess = msg.get("session_id", "default") or "default"
        if key and val:
            await memory.store_semantic(key, val, session_id=_store_sess)
            _mstats = (
                await STATE.memory_router.stats()
                if STATE.memory_router is not None
                else memory.stats()
            )
            await manager.send(ws, {
                "type": "memory_ack", "action": "stored", "key": key,
                **_mstats,
            })

    # ── Memory recall ─────────────────────────────────────────────────────────
    elif mtype == "memory_recall":
        # P1.2: MemoryRouter is the single source of truth for all recall.
        # Legacy memory.recall_semantic kept as a fallback when STATE.memory_router
        # is not yet initialised.
        query = msg.get("query", "")
        _recall_sess = msg.get("session_id", "default") or "default"
        if STATE.memory_router is not None:
            try:
                from memory.router.memory_router import MemoryQuery
                hits = await STATE.memory_router.search(MemoryQuery(text=query))
                router_results = [
                    {"text": getattr(h, "content", str(h)), "score": getattr(h, "score", None)}
                    for h in hits
                ]
                recent = STATE.memory_router.recent_messages(n=5)
                results = []  # semantic covered by router search
            except Exception as exc:
                log.warning("memory_recall via MemoryRouter failed: %s", exc)
                results = memory.recall_semantic(query)
                recent  = memory.recall_recent(5, session_id=_recall_sess)
                router_results = []
        else:
            results = memory.recall_semantic(query)
            recent  = memory.recall_recent(5, session_id=_recall_sess)
            router_results = []
        await manager.send(ws, {
            "type":     "memory_results",
            "semantic": results,
            "recent":   recent,
            "router":   router_results,
        })

    # ── Task planner ─────────────────────────────────────────────────────────
    elif mtype == "task_create":
        intent = msg.get("text", "").strip()
        if not intent:
            return
        if STATE.task_planner is None:
            await manager.send(ws, {"type": "task_error", "error": "Task planner not available"})
            return
        try:
            plan = await STATE.task_planner.plan(intent, session_id=msg.get("session_id", ""))
            await manager.send(ws, {
                "type": "task_created",
                "plan_id": plan.plan_id,
                "intent": plan.intent,
                "root_goal": {
                    "goal_id": plan.root_goal.goal_id,
                    "title": plan.root_goal.title,
                    "status": str(plan.root_goal.status),
                },
                "sub_goals": [
                    {
                        "goal_id": g.goal_id,
                        "title": g.title,
                        "description": g.description,
                        "assigned_to": g.assigned_to,
                        "status": str(g.status),
                    }
                    for g in plan.sub_goals
                ],
            })
        except Exception as e:
            log.error(f"task_create failed: {e}")
            await manager.send(ws, {"type": "task_error", "error": str(e)})

    elif mtype == "task_list":
        if STATE.task_planner is None:
            await manager.send(ws, {"type": "task_list_result", "plans": []})
            return
        plans = []
        for plan in STATE.task_planner._plans.values():
            plans.append({
                "plan_id": plan.plan_id,
                "intent": plan.intent,
                "root_goal": {
                    "goal_id": plan.root_goal.goal_id,
                    "title": plan.root_goal.title,
                    "status": str(plan.root_goal.status),
                },
                "sub_goals": [
                    {"goal_id": g.goal_id, "title": g.title,
                     "assigned_to": g.assigned_to, "status": str(g.status)}
                    for g in plan.sub_goals
                ],
            })
        await manager.send(ws, {"type": "task_list_result", "plans": plans})

    # ── Settings update ─────────────────────────────────────────────────────────
    elif mtype == "settings_update":
        settings = msg.get("settings", {})
        apply_settings(settings)
        await manager.send(ws, {"type": "settings_ack", "settings": settings})

    # ── Settings get ─────────────────────────────────────────────────────────
    elif mtype == "settings_get":
        await manager.send(ws, {"type": "settings_data", "settings": RUNTIME_SETTINGS})

    # ── Ping ─────────────────────────────────────────────────────────────────
    elif mtype == "ping":
        await manager.send(ws, {"type": "pong", "ts": time.time()})

    # ── Model Switcher ────────────────────────────────────────────────────────
    # Mobile HUD sends {"type": "model_switch", "model": <name>, "kind": "cloud"|"ollama"}.
    # "kind" maps to the switcher's provider argument: "cloud" means `model`
    # IS the provider name (groq/gemini/openvino), "ollama" means `model` is
    # an Ollama tag and provider is always "ollama".
    elif mtype == "model_switch":
        kind = msg.get("kind", "").lower().strip()
        raw_model = msg.get("model", "")
        if kind == "ollama":
            provider = "ollama"
            model = raw_model
        elif kind == "local":
            # Local non-Ollama provider (e.g. OpenVINO).
            # The provider key comes from msg["provider"], not msg["model"].
            provider = msg.get("provider", raw_model).lower().strip()
            model = None
        elif kind == "cloud":
            provider = raw_model.lower().strip()
            model = None
        else:
            # Back-compat: older callers send {"provider": ..., "model": ...} directly
            provider = msg.get("provider", "groq").lower().strip()
            model = msg.get("model")

        if model_switcher is None:
            model_switcher = ModelSwitcher.get_instance()
        success = await model_switcher.switch(provider, model)
        state = model_switcher.get_state()
        if success:
            await manager.send(ws, {
                "type": "model_switched", "success": True,
                "model": state["model"], "kind": kind or ("ollama" if provider == "ollama" else "cloud"),
                "state": state,
            })
        else:
            await manager.send(ws, {
                "type": "model_switch_error",
                "error": f"Could not switch to {provider}" + (f"/{model}" if model else ""),
                "state": state,
            })

    # ── Ollama model discovery (for HUD model-sheet + Settings fallback picker) ──
    elif mtype == "list_ollama_models":
        if model_switcher is None:
            model_switcher = ModelSwitcher.get_instance()
        try:
            models = await model_switcher.list_ollama_models()
        except Exception as exc:
            models = []
            log.warning("list_ollama_models failed: %s", exc)
        await manager.send(ws, {"type": "ollama_models", "models": models})

    elif mtype == "model_state":
        if model_switcher is None:
            model_switcher = ModelSwitcher.get_instance()
        state = model_switcher.get_state()
        await manager.send(ws, {"type": "model_state", "state": state})

    elif mtype == "model_cycle":
        if model_switcher is None:
            model_switcher = ModelSwitcher.get_instance()
        success = await model_switcher.cycle_to_next()
        state = model_switcher.get_state()
        await manager.send(ws, {"type": "model_cycled", "success": success, "state": state})



# ═══════════════════════════════════════════════════════════════════════════════
#  NGROK TUNNEL HELPERS
# ═══════════════════════════════════════════════════════════════════════════════

async def _start_ngrok() -> None:
    """
    Fire-and-forget: open an ngrok tunnel so the HTML HUD can be accessed
    remotely (phone, tablet, remote PC) without port-forwarding.

    Priority order:
      1. NGROK_STATIC_URL in .env  — use as-is (your custom/paid static domain)
      2. NGROK_AUTHTOKEN in .env   — start a dynamic tunnel via pyngrok
      3. Neither                   — skip, local-only mode

    The public URL is stored in _ngrok_tunnel_url and served via
    GET /config/ws_url so the web HUD can auto-discover it.
    """
    global _ngrok_tunnel_url

    if NGROK_STATIC_URL:
        _ngrok_tunnel_url = NGROK_STATIC_URL
        log.info(f"Ngrok static URL configured: {_ngrok_tunnel_url}")
        return

    if not NGROK_AUTHTOKEN:
        log.info("Ngrok disabled (no NGROK_AUTHTOKEN or NGROK_STATIC_URL in .env)")
        return

    try:
        from pyngrok import ngrok as _ngrok, conf as _ngrok_conf
        _ngrok_conf.get_default().auth_token = NGROK_AUTHTOKEN
        tunnel = await asyncio.to_thread(
            _ngrok.connect, PORT, "http", bind_tls=True
        )
        # Convert http URL → ws URL for the HUD
        public_url = tunnel.public_url.replace("https://", "wss://").replace("http://", "ws://")
        _ngrok_tunnel_url = public_url.rstrip("/") + "/ws"
        log.info(f"Ngrok tunnel active: {_ngrok_tunnel_url}")
        # Broadcast tunnel URL to any already-connected clients
        await manager.broadcast({"type": "tunnel_url", "url": _ngrok_tunnel_url})
    except ImportError:
        log.warning("pyngrok not installed — remote tunnel unavailable. Run: pip install pyngrok")
    except Exception as e:
        log.warning(f"Ngrok tunnel failed to start: {e}")


# ═══════════════════════════════════════════════════════════════════════════════
#  REST ENDPOINTS
# ═══════════════════════════════════════════════════════════════════════════════

@app.get("/health")
def health():
    """
    Phase 0: backed by observability/health/health_monitor.py when it loaded
    successfully at startup. Falls back to the original static "ok" response
    if HealthMonitor is disabled or failed to initialize — same shape callers
    have always gotten, just with a "degraded"/"starting" possibility added
    (existing tests already accept those values).
    """
    base = {"status": "ok", "uptime": int(time.time() - _start_time)}
    if STATE.health_monitor is None:
        base["health_monitor"] = "not loaded"
        return base
    snapshot = STATE.health_monitor.status_snapshot()
    # "healthy" -> "ok" keeps this endpoint backward compatible with anything
    # already polling /health and checking status == "ok"; degraded/unhealthy
    # are new information this endpoint never reported before Phase 0.
    base["status"] = "ok" if snapshot["system"] == "healthy" else snapshot["system"]
    base["components"] = {
        name: {"status": c["status"], "pass_rate": c["pass_rate"]}
        for name, c in snapshot["components"].items()
    }
    return base


@app.get("/config/ws_url")
def ws_url_config():
    """
    Returns the best WebSocket URL(s) for this server.
    The HTML HUD fetches this on load to auto-discover local + ngrok URLs
    without any hardcoding.  Response shape:
      {
        "local":  "ws://localhost:7788/ws",
        "remote": "wss://xxxx.ngrok-free.app/ws"  // or "" if no tunnel
      }
    The HUD tries local first; falls back to remote; falls back to offline.
    """
    local_url = f"ws://localhost:{PORT}/ws"
    return JSONResponse({
        "local":  local_url,
        "remote": _ngrok_tunnel_url,
    })


@app.get("/status", response_class=HTMLResponse)
async def status_dashboard():
    """P-31: Human-readable health dashboard at /status — auto-refreshes every 10s."""
    m  = get_metrics()
    d  = get_diagnostics()
    ms = memory.stats()
    uptime_s = time.time() - _start_time
    uptime_h = int(uptime_s // 3600)
    uptime_m = int((uptime_s % 3600) // 60)
    groq_ok   = bool(GROQ_KEY)
    gemini_ok = bool(GEMINI_KEY)
    browser_ok = STATE.browser_tools is not None
    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta http-equiv="refresh" content="10">
<title>JARVIS Status</title>
<style>
  body{{background:#050d1a;color:#d8eeff;font-family:monospace;padding:24px;margin:0}}
  h1{{color:#00c8ff;margin-bottom:4px}}h2{{color:#00c8ff;font-size:1em;margin:18px 0 6px}}
  .ok{{color:#00ff88}}.warn{{color:#ff8c00}}.bad{{color:#ff4040}}
  .card{{background:#0a1628;border:1px solid #1a3a5c;border-radius:6px;
         padding:12px 18px;margin-bottom:10px;display:inline-block;min-width:160px;vertical-align:top}}
  .row{{display:flex;flex-wrap:wrap;gap:10px}}
  a{{color:#00c8ff}}p{{margin:3px 0}}
</style></head>
<body>
<h1>🤖 J.A.R.V.I.S&nbsp;&nbsp;Status</h1>
<p style="color:#5a7a9a">Auto-refreshes every 10s &nbsp;·&nbsp; <a href="/docs">API Docs</a> &nbsp;·&nbsp;
  <a href="/metrics">Raw Metrics</a></p>
<p>Uptime: {uptime_h}h {uptime_m}m &nbsp;|&nbsp;
   WS connections: {len(manager._clients)} &nbsp;|&nbsp; PID: {d['pid']}</p>
<h2>AI Providers</h2>
<div class="row">
  <div class="card"><b>Groq</b><br>
    <span class="{'ok' if groq_ok else 'bad'}">{'✓ ONLINE' if groq_ok else '✗ NO KEY'}</span></div>
  <div class="card"><b>Gemini</b><br>
    <span class="{'ok' if gemini_ok else 'bad'}">{'✓ ONLINE' if gemini_ok else '✗ NO KEY'}</span></div>
  <div class="card"><b>Qwen-OpenVINO</b><br>
    <span class="{'ok' if _qwen_openvino_enabled() else 'warn'}">
      {'✓ ENABLED' if _qwen_openvino_enabled() else '○ DISABLED'}</span></div>
  <div class="card"><b>Ollama</b><br><span class="ok">✓ LOCAL FALLBACK</span></div>
</div>
<h2>System</h2>
<div class="row">
  <div class="card"><b>CPU</b><br>{m['cpu']}%</div>
  <div class="card"><b>RAM</b><br>{m['ram_used']} / {m['ram_total']} GB ({m['ram_pct']}%)</div>
  <div class="card"><b>Disk</b><br>{m['disk_used']} / {m['disk_total']} GB ({m['disk_pct']}%)</div>
  <div class="card"><b>Network</b><br>↑ {m['net_up']} &nbsp;↓ {m['net_dn']}</div>
</div>
<h2>Memory Store</h2>
<div class="row">
  <div class="card"><b>Episodes</b><br>{ms['episodes']}</div>
  <div class="card"><b>Semantic Facts</b><br>{ms['semantic']}</div>
</div>
<h2>Services</h2>
<div class="row">
  <div class="card"><b>Browser Tools</b><br>
    <span class="{'ok' if browser_ok else 'warn'}">
      {'✓ Playwright ready' if browser_ok else '○ Not initialized'}</span></div>
  <div class="card"><b>Task Planner</b><br>
    <span class="{'ok' if STATE.task_planner else 'warn'}">
      {'✓ Ready' if STATE.task_planner else '○ Not initialized'}</span></div>
  <div class="card"><b>Action Guard (Phase 1)</b><br>
    <span class="{'ok' if STATE.action_guard and STATE.action_guard.action_guard else ('warn' if JARVIS_ENABLE_ACTION_GUARD else '')}">
      {'✓ Online — PolicyEngine + PermissionManager + ActionGuard + TerminalManager + FileManager' if STATE.action_guard and STATE.action_guard.action_guard else ('⚠ Enabled but partially loaded' if JARVIS_ENABLE_ACTION_GUARD and STATE.action_guard else ('⚠ Enabled but failed to start' if JARVIS_ENABLE_ACTION_GUARD else '○ Disabled (JARVIS_ENABLE_ACTION_GUARD=false)'))}</span></div>
  <div class="card"><b>Orchestrator (Phase 2)</b><br>
    <span class="{'ok' if STATE.orchestrator else ('warn' if JARVIS_ENABLE_ORCHESTRATOR else '')}">
      {'✓ Online — ' + str(len(STATE.orchestrator.agents)) + ' agents' if STATE.orchestrator else ('⚠ Enabled but failed to start' if JARVIS_ENABLE_ORCHESTRATOR else '○ Disabled (JARVIS_ENABLE_ORCHESTRATOR=false)')}</span></div>
  <div class="card"><b>Memory Router</b><br>
    <span class="{'ok' if STATE.memory_router else 'warn'}">
      {'✓ Ready' if STATE.memory_router else '○ Not initialized'}</span></div>
  <div class="card"><b>Embedding Service</b><br>
    <span class="{'ok' if STATE.embedding_service else 'warn'}">
      {'✓ ' + STATE.embedding_service.stats()['backend'] if STATE.embedding_service else '○ Not initialized'}</span></div>
  <div class="card"><b>Daily Summary</b><br>
    <span class="{'ok' if STATE.daily_summary else 'warn'}">
      {'✓ Active' if STATE.daily_summary else '○ Not initialized'}</span></div>
  <div class="card"><b>Acknowledgement</b><br>
    <span class="{'ok' if STATE.acknowledgement_engine else 'warn'}">
      {'✓ Running' if STATE.acknowledgement_engine else '○ Not initialized'}</span></div>
  <div class="card"><b>Voice Pipeline (Phase 3)</b><br>
    <span class="{'ok' if STATE.voice_coordinator and getattr(STATE.voice_coordinator, '_running', False) else ('warn' if JARVIS_ENABLE_ALWAYS_LISTENING else '')}">
      {'✓ Online — wake-word active' if STATE.wake_word_manager and STATE.wake_word_manager.is_running() else ('⚠ Enabled but not started' if JARVIS_ENABLE_ALWAYS_LISTENING else '○ Disabled (JARVIS_ENABLE_ALWAYS_LISTENING=false)')}</span></div>
  <div class="card"><b>Vision Pipeline (Phase 3)</b><br>
    <span class="{'ok' if STATE.vision_pipeline and getattr(STATE.vision_pipeline, '_running', False) else ('warn' if JARVIS_ENABLE_VISION_PIPELINE else '')}">
      {'✓ Online' if STATE.vision_pipeline and getattr(STATE.vision_pipeline, '_running', False) else ('⚠ Enabled but not started' if JARVIS_ENABLE_VISION_PIPELINE else '○ Disabled (JARVIS_ENABLE_VISION_PIPELINE=false)')}</span></div>
  <div class="card"><b>Activity Observer (Phase 3)</b><br>
    <span class="{'ok' if STATE.activity_observer else ('warn' if JARVIS_ENABLE_VISION_PIPELINE else '')}">
      {'✓ Polling (10s)' if STATE.activity_observer else ('⚠ Enabled but not started' if JARVIS_ENABLE_VISION_PIPELINE else '○ Disabled')}</span></div>
</div>
<h2>Host</h2>
<p>OS: {d['os']} &nbsp;|&nbsp; Python {d['python']} &nbsp;|&nbsp; {d['cpu_count']} logical CPUs</p>
<p style="color:#2a4a6a;margin-top:24px">J.A.R.V.I.S AI OS — server.py</p>
</body></html>"""

@app.get("/metrics")
def metrics_endpoint():
    """
    Returns the original CPU/RAM/disk/network snapshot (get_metrics(), used
    by the HUD dashboard) plus, when available:
      - "counters": Phase 0 observability/metrics/metrics_collector.py —
        tool invocation counts/latency, recorded directly in dispatch_tool().
      - "model_fallback_events"/"model_emergency_uses": pulled from
        ModelRouter's own existing telemetry (models/hud_diagnostics.py) —
        NOT re-counted here, since the router already tracks this and a
        second counter would drift from the source of truth.
    Shape is additive: anything already parsing this response for
    cpu/ram/disk/net_* fields is unaffected.
    """
    payload = get_metrics()
    if STATE.metrics_collector is not None:
        payload["counters"] = STATE.metrics_collector.snapshot()
    try:
        from models.hud_diagnostics import get_routing_diagnostics
        _routing = get_routing_diagnostics()
        payload["model_fallback_events"] = _routing.get("telemetry", {}).get("fallback_events")
        payload["model_emergency_uses"] = _routing.get("telemetry", {}).get("emergency_model_uses")
    except Exception:
        pass  # ModelRouter not initialized yet — omit rather than fail the whole endpoint
    return JSONResponse(payload)

@app.get("/security/status")
def security_status_endpoint():
    """
    Phase 1: Returns the current state of the Safety & Action Layer.
    Components: PolicyEngine, PermissionManager, ActionGuard, TerminalManager,
    FileManager. Stats: evaluated/approved/blocked/passthrough counts.
    """
    if STATE.action_guard is None:
        return JSONResponse({
            "enabled": JARVIS_ENABLE_ACTION_GUARD,
            "status": "not loaded",
            "reason": "ActionGuard disabled or failed to initialize — see startup logs",
        })
    return JSONResponse(STATE.action_guard.health_snapshot())


@app.get("/security/audit")
async def security_audit_endpoint(
    requester: str = "",
    action_type: str = "",
    allowed: str = "",
    limit: int = 100,
):
    """
    Phase 1: Query the in-memory permission audit log.
    Optional filters: requester, action_type, allowed (true/false).
    """
    if STATE.action_guard is None or STATE.action_guard.permission_manager is None:
        return JSONResponse({"error": "PermissionManager not initialized"}, status_code=503)
    pm = STATE.action_guard.permission_manager
    _allowed: bool | None = None
    if allowed.lower() == "true":
        _allowed = True
    elif allowed.lower() == "false":
        _allowed = False
    records = pm.get_audit_log(requester=requester or None, limit=limit)
    if _allowed is not None:
        records = [r for r in records if r.get("allowed") == _allowed]
    if action_type:
        records = [r for r in records if r.get("action_type") == action_type]
    return JSONResponse({"count": len(records), "records": records})


@app.get("/security/policy")
def security_policy_endpoint():
    """
    Phase 1: List active PolicyEngine rules (name, effect, priority, requesters).
    """
    if STATE.action_guard is None or STATE.action_guard.policy_engine is None:
        return JSONResponse({"error": "PolicyEngine not initialized"}, status_code=503)
    return JSONResponse({
        "rule_count": len(STATE.action_guard.policy_engine._rules),
        "default_allow": STATE.action_guard.policy_engine._default_allow,
        "rules": STATE.action_guard.policy_engine.list_rules(),
    })


@app.get("/voice/status")
def voice_status_endpoint():
    """
    Phase 3: Returns current state of the always-listening voice pipeline.
    Components: WakeWordManager, VoiceCoordinator, VisionPipeline, ActivityObserver.
    """
    if STATE.wake_word_manager is None and STATE.voice_coordinator is None:
        return JSONResponse({
            "enabled": JARVIS_ENABLE_ALWAYS_LISTENING,
            "status": "not loaded",
            "reason": "Always-listening disabled or failed to initialize — see startup logs",
        })
    ww_status = STATE.wake_word_manager.status() if STATE.wake_word_manager is not None else {}
    vc_stats = STATE.voice_coordinator.stats() if STATE.voice_coordinator is not None else {}
    return JSONResponse({
        "enabled": JARVIS_ENABLE_ALWAYS_LISTENING,
        "status": "online",
        "wake_word_manager": ww_status,
        "voice_coordinator": {
            "running": getattr(STATE.voice_coordinator, "_running", False),
            "active_run": bool(getattr(STATE.voice_coordinator, "_current_run", None)),
            **vc_stats,
        },
        "activity_observer": {"running": STATE.activity_observer is not None},
        "vision_pipeline": {"running": STATE.vision_pipeline is not None and getattr(STATE.vision_pipeline, "_running", False)},
    })


@app.post("/voice/wake-word/enable")
async def voice_wakeword_enable():
