from agents.agent_prompts import AGENT_PROMPTS, AGENT_ALIASES, resolve_agent as _resolve_agent


# P1.2 — _histories is now keyed by (session_id, agent) not just agent,
# so concurrent browser tabs never share conversation context.
# Format: {session_id: {agent: [{"role":..,"content":..}]}}
_histories: dict[str, dict[str, list[dict]]] = {}

# Track which provider served the last request (for UI badge)
_last_provider: str = "NONE"


# Phase 6.4 / 7.1 — call_ai()'s structured result.
#
# call_ai() used to return a bare (text, provider) tuple. Phase 7.1 asks for
# fallback_occurred / fallback_reason / answered_by to be threaded through to
# the WS chat_reply payload — but reaching for module-level globals to smuggle
# that out (the way _last_provider above does) is exactly the kind of mutable
# shared state that breaks once concurrent requests are in flight, which is
# precisely what Phase 8's 7-specialist-agents-at-once and Phase 9/10's
# concurrent-session work will introduce. Two overlapping call_ai() calls
# writing into the same global would silently cross-contaminate, the same
# class of bug Phase 3.2 had to fix for the orchestrator's session_id check.
#
# AIReply is the fix: a small typed result object, returned directly (not
# stashed on a global), so it's correct under concurrency by construction.
# It's also deliberately a dataclass rather than a wider tuple — Phase 8
# will likely want to attach more per-reply metadata later (tool calls made,
# task duration, agent name for non-orchestrator paths, etc.); with a
# dataclass those become new fields with defaults, not new tuple positions
# that break every existing call site's unpacking order.
@dataclass
class AIReply:
    text:               str
    provider:           str
    fallback_occurred:  bool = False
    fallback_selected:  str  = ""   # provider the user had selected, if different from `provider`
    # Room for future phases — e.g. Phase 8: tool_calls, agent_name, task_duration_s.


