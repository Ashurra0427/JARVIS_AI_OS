# ── FastAPI app ───────────────────────────────────────────────────────────────
@asynccontextmanager
async def lifespan(app: FastAPI):
    """Replaces deprecated @app.on_event('startup') / @app.on_event('shutdown')."""
    await on_startup()
    yield
    await on_shutdown()


app = FastAPI(title="JARVIS HUD Backend", lifespan=lifespan)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"], allow_methods=["*"], allow_headers=["*"],
)


@app.middleware("http")
async def _phase0_request_counter(request, call_next):
    """
    Phase 0 metrics: counts every HTTP request served, regardless of route.
    STATE.metrics_collector is module-level and only populated once on_startup()
    runs, so this is a no-op (and harmless) for any request that somehow
    arrives before startup completes.
    """
    response = await call_next(request)
    if STATE.metrics_collector is not None:
        STATE.metrics_collector.increment("http_requests_total")
    return response

