# ═══════════════════════════════════════════════════════════════════════════════
#  BACKGROUND TASKS
# ═══════════════════════════════════════════════════════════════════════════════

_start_time = time.time()


async def _metrics_broadcaster():
    while True:
        await asyncio.sleep(1.0)
        if not manager._clients:
            continue
        try:
            await manager.broadcast({"type": "metrics", **get_metrics()})
        except Exception as e:
            log.debug(f"Metrics broadcast error: {e}")


async def _heartbeat():
    while True:
        try:
            await asyncio.sleep(10)
            if not manager._clients:
                continue
            await manager.broadcast({
                "type":   "heartbeat",
                "uptime": int(time.time() - _start_time),
                "ts":     time.time(),
            })
        except asyncio.CancelledError:
            break
        except Exception as e:
            log.debug(f"Heartbeat error (non-fatal): {e}")


async def _agent_metrics_broadcaster():
    """Periodically push per-agent metrics so AgentWorkspace roster cards
    and detail panel stay in sync, even when an agent is idle."""
    while True:
        await asyncio.sleep(3.0)
        if not manager._clients:
            continue
        for agent_id in AGENT_REGISTRY:
            try:
                await manager.broadcast(_agent_metrics_message(agent_id))
            except Exception as e:
                log.debug(f"Agent metrics broadcast error: {e}")


def _compute_fallback_stats() -> dict:
    """Phase 10.3 bugfix: shared helper for fallback/emergency/last-answered-by
    stats, used both by the periodic ``model_status`` broadcaster and by the
    reconnect handshake.

    ``models.hud_diagnostics.get_routing_diagnostics()`` nests the relevant
    counters under ``telemetry`` (``fallback_events`` / ``emergency_model_uses``)
    and has no ``last_answered_by`` field at all — that value is derived here
    from ``ModelRouter.get_stats()``'s per-provider request/success table,
    exactly as the ``model_status`` broadcaster already did.

    Returns:
        {"fallback_count": int, "emergency_uses": int, "last_answered_by": str}
    """
    from models.router.model_router import get_router
    router = get_router()
    stats = router.get_stats()

    # Determine last_answered_by: whichever provider has the most
    # recent success in the per-provider table (highest request count
    # that is also > 0 successes).
    providers = stats.get("providers", {})
    last_answered = router.active_provider  # fallback = currently selected
    best_reqs = 0
    for pname, pdata in providers.items():
        if pname in ("emergency_local", "offline"):
            continue
        r = pdata.get("requests", 0)
        if r > best_reqs and pdata.get("successes", 0) > 0:
            best_reqs = r
            last_answered = pname

    return {
        "fallback_count":   stats.get("fallback_events", 0),
        "emergency_uses":   stats.get("emergency_model_uses", 0),
        "last_answered_by": last_answered,
    }


async def _model_status_broadcaster():
    """Phase 7.5 — periodic model_status WS broadcast (every 12 s).

    Reuses ``get_stats()`` / ``get_routing_diagnostics()`` — no second
    telemetry path.  Pushes:
        {
          "type":            "model_status",
          "selected":        "<provider>",          # what the user chose
          "selected_model":  "<tag or None>",       # specific model tag
          "last_answered_by": "<provider>",         # what actually answered last
          "fallback_count":  <int>,                 # cumulative fallback events
          "emergency_uses":  <int>,                 # emergency model invocations
          "ts":              <float>,               # epoch timestamp
        }

    Clients that don't handle this type ignore it (it has a unique "type"
    key so it doesn't collide with "metrics" or "heartbeat").
    Sends only when at least one client is connected.
    """
    while True:
        try:
            await asyncio.sleep(12)
            if not manager._clients:
                continue

            from models.router.model_router import get_router
            router = get_router()

            _fallback_stats = _compute_fallback_stats()

            payload = {
                "type":             "model_status",
                "selected":         router.active_provider,
                "selected_model":   router.active_model,
                "last_answered_by": _fallback_stats["last_answered_by"],
                "fallback_count":   _fallback_stats["fallback_count"],
                "emergency_uses":   _fallback_stats["emergency_uses"],
                "ts":               time.time(),
            }
            await manager.broadcast(payload)

        except asyncio.CancelledError:
            break
        except Exception as exc:
            log.debug(f"Phase 7.5: model_status broadcast error (non-fatal): {exc}")


async def _prewarm_ollama() -> None:
    """Fire-and-forget: send a trivial request to Ollama at boot so the
    user's actually-selected model is loaded into memory *before* the
    first real chat message needs it. Without this, the first request to
    Ollama pays the full model-load cost (often 45-90s+ for a 4B model) on
    top of whatever timeout the router allows.

    v4.0 note: the router's Ollama instance starts with NO model loaded —
    ModelSwitcher decides what's active. Prewarming the OLLAMA_MODEL env
    var unconditionally would warm a model that may not even be the one
    the user selected, while leaving their actual selection cold. So this
    only prewarms when Ollama is the user's active provider, and warms
    exactly the tag ModelSwitcher reports as current.
    """
    from models.switcher.model_switcher import ModelSwitcher
    switcher = ModelSwitcher.get_instance()
    if switcher.current_provider != "ollama":
        log.debug("Ollama pre-warm skipped — active provider is not Ollama")
        return

    model_to_warm = switcher.current_model
    if not model_to_warm:
        log.debug("Ollama pre-warm skipped — no model tag set")
        return

    import aiohttp
    url = f"{OLLAMA_HOST.rstrip('/')}/api/chat"
    payload = {
        "model": model_to_warm,
        "stream": False,
        "messages": [{"role": "user", "content": "hi"}],
        "options": {"num_predict": 1},
    }
    try:
        timeout = aiohttp.ClientTimeout(total=180)  # cold load can be slow
        async with aiohttp.ClientSession(timeout=timeout) as session:
            t0 = time.monotonic()
            async with session.post(url, json=payload) as resp:
                await resp.read()
                if resp.status == 200:
                    log.info(f"Ollama pre-warmed ({model_to_warm}) in {time.monotonic()-t0:.1f}s")
                else:
                    log.warning(f"Ollama pre-warm got HTTP {resp.status} (model: {model_to_warm})")
    except Exception as e:
        log.info(f"Ollama pre-warm skipped (not running?): {e}")


async def _daily_summary_scheduler() -> None:
    """
    Background task: runs DailySummary every 6 hours and exports to disk.
    Also feeds the aggregated report into MemoryManager as a REFLECTION entry
    so the ReflectionEngine can consume it on the next cycle.
    Interval is 6 h (not midnight) so long-running server sessions get at
    least one mid-session summary without having to wait until day rollover.
    """
    INTERVAL_S = 6 * 3600.0
    await asyncio.sleep(60)          # short initial delay so startup is clean
    while True:
        if DAILY_SUMMARY is not None:
            try:
                report = DAILY_SUMMARY.generate_summary()
                # Export to disk
                try:
                    paths = DAILY_SUMMARY.export_summary(
                        report, output_dir="datastore/summaries"
                    )
                    log.info(
                        f"DailySummary exported — {report.total_events} events, "
                        f"paths={list(paths.values())}"
                    )
                except Exception as exp_exc:
                    log.warning(f"DailySummary export failed: {exp_exc}")

                # Persist to MemoryManager if available
                if MEMORY_ROUTER is not None:
                    try:
                        import dataclasses as _dc
                        payload = {
                            "date_label": report.date_label,
                            "total_events": report.total_events,
                            "highlights": report.highlights,
                            "insights": report.insights,
                            "anomalies": report.anomalies,
                        }
                        await MEMORY_ROUTER.remember(
                            content=str(payload),
                        )
                    except Exception as mr_exc:
                        log.debug(f"DailySummary → MemoryRouter failed (non-fatal): {mr_exc}")

                # Reset for next cycle
                DAILY_SUMMARY.reset()
            except Exception as exc:
                log.warning(f"DailySummary scheduler error (non-fatal): {exc}")

        await asyncio.sleep(INTERVAL_S)


async def _reflection_trigger_scheduler() -> None:
    """
    Background task: publishes a 'reflection.trigger' event every 2 hours
    so the ReflectionEngine (subscribed via EventBus in the full kernel path)
    runs a periodic reflection cycle independently of manual triggers.

    FIX: Guard added — only broadcast when at least one WebSocket client is
    connected, preventing a spurious broadcast error that was being logged
    every 2 h at startup (before any HUD client connected) and again whenever
    all clients disconnected.  The Ollama fallback tier then received an
    unexplained "error" state that caused it to be skipped unnecessarily.
    """
    INTERVAL_S = 2 * 3600.0
    await asyncio.sleep(300)         # 5-minute initial delay
    while True:
        if manager._clients:          # only broadcast when someone is listening
            try:
                await manager.broadcast({
                    "type": "reflection_trigger",
                    "ts": time.time(),
                    "source": "server.scheduler",
                    "interval_s": INTERVAL_S,
                })
                log.info("Reflection trigger broadcast sent")
            except Exception as exc:
                log.debug(f"Reflection trigger broadcast failed: {exc}")
        else:
            log.debug("Reflection trigger: no clients connected — skipping broadcast")
        await asyncio.sleep(INTERVAL_S)


async def on_startup():
    psutil.cpu_percent(interval=None)
    psutil.cpu_percent(interval=None, percpu=True)

    # ── Model router: initialize FIRST, with OLLAMA_HOST ───────────────────
    # get_router() is a lazy singleton — whoever calls it first decides the
    # ollama_url it's constructed with. Every other call site in this file
    # (call_ai(), the WS handlers, health checks, the orchestrator wiring)
    # calls get_router() with no arguments, so if nothing initializes the
    # singleton explicitly here, ModelRouter.__init__'s ollama_url default
    # ("http://localhost:11434") silently wins even when OLLAMA_HOST is set
    # to something else. This bit the HUD's Ollama model list before: the
    # discovery path and the router path could end up pointed at different
    # hosts depending on call order, and any custom OLLAMA_HOST was ignored
    # entirely. Doing it explicitly, first, here removes the ordering
    # dependency.
    try:
        from models.router.model_router import get_router
        get_router(ollama_url=OLLAMA_HOST)
        log.info(f"ModelRouter pre-initialized with ollama_url={OLLAMA_HOST}")
    except Exception as _router_exc:
        log.warning(f"ModelRouter pre-init failed (non-fatal, will lazy-init later): {_router_exc}")

    # ── Asyncio loop exception handler ────────────────────────────────────────
    # By default, an unhandled exception inside an asyncio.create_task() coroutine
    # is reported via the loop's exception handler — which on some uvicorn/Windows
    # versions terminates the server. Override it to log-and-continue instead.
    def _handle_task_exception(loop, context):
        exc = context.get("exception")
        msg = context.get("message", "unknown")
        if exc is not None:
            log.error(f"Unhandled background task exception (non-fatal): {exc!r} — {msg}")
        else:
            log.warning(f"Asyncio loop error (non-fatal): {msg}")

    asyncio.get_event_loop().set_exception_handler(_handle_task_exception)

    asyncio.create_task(_metrics_broadcaster())
    asyncio.create_task(_heartbeat())
    asyncio.create_task(_agent_metrics_broadcaster())
    asyncio.create_task(_model_status_broadcaster())   # Phase 7.5
    asyncio.create_task(_prewarm_ollama())
    asyncio.create_task(_start_ngrok())
    asyncio.create_task(_daily_summary_scheduler())
    asyncio.create_task(_reflection_trigger_scheduler())

    # P0.5: Refuse to bind on non-localhost interfaces without JARVIS_SECRET.
    if not SERVER_SECRET:
        if HOST not in ("127.0.0.1", "::1", "localhost"):
            raise RuntimeError(
                "FATAL: JARVIS_SECRET is not set and HOST is not localhost (\'%s\').\n"
                "Set JARVIS_SECRET=<random-token> in .env before binding to a network interface.\n"
                "To allow localhost-only dev mode without auth, set HOST=127.0.0.1." % HOST
            )
        log.warning(
            "JARVIS_SECRET is not set — WebSocket endpoint has NO authentication. "
            "Listening on localhost only. Set JARVIS_SECRET in .env before any network exposure."
        )

    # ── Tool Registry (browser.*, web.*, fs.*, code.*, system.*, apps.*, etc.) ──
    # All subsystem singletons assigned below now live on STATE (AppState) —
    # no `global` declarations needed since STATE itself is never reassigned.
    try:
        from tools.registry.tool_registry import get_registry
        from tools.registry.tool_registry_registration import register_all_tools
        STATE.tool_registry = get_registry()
        registered = register_all_tools(STATE.tool_registry, event_bus=None)
        total = sum(len(v) for v in registered.values())
        log.info(f"ToolRegistry: {total} tools registered across {len(registered)} modules")
    except Exception as e:
        log.error(f"ToolRegistry init failed: {e}")
        STATE.tool_registry = None

    # ── Phase 1 — Safety & Action Layer ──────────────────────────────────────
    # PolicyEngine + PermissionManager + ActionGuard + TerminalManager +
    # FileManager.  Wired into ToolRegistry.invoke() via the SecurityIntegration
    # singleton — no second EventBus, no separate import chain.
    #
    # Ground-rule compliance:
    #   • Non-fatal: each component wrapped in try/except; server still boots.
    #   • One shared EventBus: STATE.server_bus is passed in (created just above).
    #   • Env-var gated: JARVIS_ENABLE_ACTION_GUARD (default True).
    #   • Visible in /health: registers a HealthCheck below.
    #   • Deny-by-default for destructive actions, allow for safe reads.
    STATE.action_guard = None
    if JARVIS_ENABLE_ACTION_GUARD:
        try:
            from actions.security.security_integration import init_security_integration
            STATE.action_guard = await init_security_integration(event_bus=STATE.server_bus)
            if STATE.action_guard is not None:
                log.info(
                    "Phase 1: Safety & Action Layer online",
                    policy_engine=STATE.action_guard.policy_engine is not None,
                    permission_manager=STATE.action_guard.permission_manager is not None,
                    action_guard=STATE.action_guard.action_guard is not None,
                    terminal_manager=STATE.action_guard.terminal_manager is not None,
                    file_manager=STATE.action_guard.file_manager is not None,
                )
                # Register Phase 1 health check so /health reflects it
                if STATE.health_monitor is not None:
                    from observability.health.health_monitor import HealthCheck as _HC1
                    def _check_action_guard() -> bool:
                        return (
                            STATE.action_guard is not None
                            and STATE.action_guard.action_guard is not None
                        )
                    STATE.health_monitor.register(_HC1(
                        name="action_guard",
                        check_fn=_check_action_guard,
                        critical=False,
                    ))
                    await STATE.health_monitor.check_all()
            else:
                log.warning("Phase 1: SecurityIntegration returned None — action guard not active")
        except Exception as _p1_exc:
            log.warning("Phase 1: Safety & Action Layer init failed (non-fatal): %s", _p1_exc)
            STATE.action_guard = None
    else:
        log.info("Phase 1: Action Guard disabled (JARVIS_ENABLE_ACTION_GUARD=false)")

    # ── Memory Router (working/episodic/semantic/vector) ─────────────────────
    # Phase 3.5 fix: previously injected with event_bus=None AND
    # model_router=None unconditionally — model_router didn't need to be None
    # here; get_router() was already pre-initialized at the very top of
    # on_startup() (see "Model router: initialize FIRST" above), so it's
    # resolvable right now. event_bus genuinely isn't constructed yet at this
    # point in startup (STATE.server_bus comes next, below) — that half gets
    # corrected a few lines down, unconditionally, right after server_bus
    # exists (search "Phase 3.5: re-wire MemoryRouter").
    try:
        from memory.router.memory_router import MemoryRouter
        from models.router.model_router import get_router as _get_router_for_memory_init
        STATE.memory_router = MemoryRouter()
        globals()['MEMORY_ROUTER'] = STATE.memory_router
        try:
            _model_router_for_memory_init = _get_router_for_memory_init()
        except Exception:
            _model_router_for_memory_init = None
        STATE.memory_router.inject(event_bus=None, model_router=_model_router_for_memory_init)
        await STATE.memory_router.start()
        log.info("MemoryRouter started")
    except Exception as e:
        log.error(f"MemoryRouter init failed: {e}")
        STATE.memory_router = None
        globals()['MEMORY_ROUTER'] = None

    # ── Shared in-process EventBus ────────────────────────────────────────────
    # Created once here so GoalManager, AcknowledgementEngine, STATE.stt_engine,
    # STATE.tts_engine, and any other server-side component that needs event
    # publishing can share a single bus. FIXED: this used to be a function-
    # local variable (_server_bus) that silently went out of scope at the
    # end of on_startup(), so nothing outside this function could ever
    # actually reuse it despite the comment above claiming otherwise.
    STATE.server_bus = None
    try:
        from kernel.event_bus.event_bus import EventBus
        STATE.server_bus = EventBus()
        await STATE.server_bus.start()
        log.info("Server EventBus started")
        # ── Relay agent workflow steps to WebSocket clients ───────────────────
        async def _on_workflow_step(event):
            try:
                payload = event.payload if hasattr(event, 'payload') else event
                await manager.broadcast({
                    "type":    "agent_workflow_step",
                    "agent":   payload.get("agent", ""),
                    "step_id": payload.get("step_id", ""),
                    "label":   payload.get("label", ""),
                    "status":  payload.get("status", "active"),
                    "detail":  payload.get("detail", ""),
                })
            except Exception:
                pass
        STATE.server_bus.subscribe("agent.workflow.step", _on_workflow_step)
        log.info("Workflow step relay subscribed")
    except Exception as e:
        log.warning(f"Server EventBus init failed (non-fatal): {e}")

    # ── Phase 3.5: re-wire MemoryRouter now that EventBus exists ─────────────
    # MemoryRouter was constructed above, before STATE.server_bus existed, so
    # it could only be injected with event_bus=None at that point. Previously,
    # NOTHING ever called .inject() again to fix that — UNLESS
    # JARVIS_ENABLE_ORCHESTRATOR=true, in which case Orchestrator.start() did
    # its own re-inject as a side effect of cognition-layer startup. That
    # meant in the *default* config (orchestrator disabled — JARVIS's actual
    # out-of-the-box behaviour today), STATE.memory_router ran its entire
    # process lifetime with event_bus=None. Combined with the model_router
    # gap fixed above, this previously meant memory.* events never published
    # AND (in the window before this fix) vectorisation silently never ran —
    # no exception anywhere, no warning, just memory that quietly never got
    # embedded or broadcast. Re-inject here, unconditionally, every boot, so
    # this can't regress into "only works when a different subsystem happens
    # to also be enabled" again.
    if STATE.memory_router is not None:
        try:
            from models.router.model_router import get_router as _get_router_for_memory_rewire
            STATE.memory_router.inject(
                event_bus=STATE.server_bus,
                model_router=_get_router_for_memory_rewire(),
            )
            log.info("MemoryRouter re-wired with live EventBus + ModelRouter (Phase 3.5)")
        except Exception as _mem_rewire_exc:
            log.warning(f"MemoryRouter post-EventBus rewire failed (non-fatal): {_mem_rewire_exc}")

    # ── Health Monitor (Phase 0 — observability/health/health_monitor.py) ────
    # Backs /health with real subsystem checks instead of a static "ok".
    # Registered checks are deliberately cheap/synchronous-friendly — no
    # outbound network calls (e.g. NOT ModelRouter.health_check_all(), which
    # pings every provider's live API) since this runs on a 30s timer.
    STATE.health_monitor = None
    if JARVIS_ENABLE_HEALTH_MONITOR and STATE.server_bus is not None:
        try:
            from observability.health.health_monitor import HealthMonitor, HealthCheck
            _health_cfg = STATE.config.config.health if STATE.config is not None else None
            STATE.health_monitor = HealthMonitor(
                bus=STATE.server_bus,
                check_interval_s=(_health_cfg.check_interval_s if _health_cfg else 30),
                degraded_threshold=(_health_cfg.degraded_threshold if _health_cfg else 0.8),
                unhealthy_threshold=(_health_cfg.unhealthy_threshold if _health_cfg else 0.5),
                window_size=(_health_cfg.history_window if _health_cfg else 10),
            )

            def _check_event_bus() -> bool:
                return STATE.server_bus is not None and bool(getattr(STATE.server_bus, "_running", True))

            def _check_tool_registry() -> bool:
                return STATE.tool_registry is not None and len(STATE.tool_registry.list_tools(enabled_only=False)) > 0

            def _check_memory_router() -> bool:
                return STATE.memory_router is not None

            def _check_model_router() -> bool:
                try:
                    from models.router.model_router import get_router
                    return len(get_router()._providers) > 0
                except Exception:
                    return False

            STATE.health_monitor.register(HealthCheck(
                name="event_bus", check_fn=_check_event_bus, critical=True,
            ))
            STATE.health_monitor.register(HealthCheck(
                name="tool_registry", check_fn=_check_tool_registry, critical=False,
            ))
            STATE.health_monitor.register(HealthCheck(
                name="memory_router", check_fn=_check_memory_router, critical=False,
            ))
            STATE.health_monitor.register(HealthCheck(
                name="model_router", check_fn=_check_model_router, critical=True,
            ))
            await STATE.health_monitor.start()
            await STATE.health_monitor.check_all()  # populate real status immediately, don't wait 30s
            log.info("HealthMonitor started with 4 checks (event_bus, tool_registry, memory_router, model_router)")
        except Exception as e:
            log.warning(f"HealthMonitor init failed (non-fatal, /health falls back to static ok): {e}")
            STATE.health_monitor = None
    elif JARVIS_ENABLE_HEALTH_MONITOR:
        log.warning("HealthMonitor skipped: EventBus unavailable (HealthMonitor requires a bus)")

    # ── Metrics Collector (Phase 0 — observability/metrics/metrics_collector.py) ─
    # Backs /metrics with real counters in addition to the existing CPU/RAM/
    # disk snapshot. get_metrics() below is left untouched; this is additive.
    STATE.metrics_collector = None
    if JARVIS_ENABLE_METRICS_COLLECTOR:
        try:
            from observability.metrics.metrics_collector import MetricsCollector
            STATE.metrics_collector = MetricsCollector.get()
            log.info("MetricsCollector ready")
        except Exception as e:
            log.warning(f"MetricsCollector init failed (non-fatal): {e}")
            STATE.metrics_collector = None

    # ── STT / TTS engines — the canonical implementations ─────────────────────
    # See the module-level comment near STATE.stt_engine/STATE.tts_engine for why this
    # replaced server.py's previous hand-rolled Groq/edge-tts/faster-whisper/
    # Kokoro calls. Both engines work fine with bus=None (their request/
    # response methods used below — transcribe_blob()/synthesize_only() —
    # don't touch the EventBus at all), but we pass the real bus when
    # available so any future bus-based features (e.g. live status events)
    # work without further changes.
    try:
        from perception.speech.stt import STTEngine, STTConfig
        STATE.stt_engine = STTEngine(
            bus=STATE.server_bus,
            config=STTConfig(
                groq_api_key=GROQ_KEY,
                language="",  # "" → auto-detect (en/hi/ne/...) — do NOT force "en"
                local_model=FASTER_WHISPER_MODEL,
            ),
        )
        STATE.stt_engine.start()
        log.info("STTEngine initialised (server.py)", groq_available=bool(GROQ_KEY))
    except Exception as e:
        log.error(f"STTEngine init failed: {e}")
        STATE.stt_engine = None

    try:
        from perception.voice.tts import TTSEngine, TTSConfig
        STATE.tts_engine = TTSEngine(
            bus=STATE.server_bus,
            config=TTSConfig(
                kokoro_model_path=KOKORO_MODEL,
                kokoro_voices_path=KOKORO_VOICES,
            ),
        )
        STATE.tts_engine.start()
        log.info("TTSEngine initialised (server.py)")
    except Exception as e:
        log.error(f"TTSEngine init failed: {e}")
        STATE.tts_engine = None

    # ── LiveSTT — shared streaming-partial transcription instance (Phase 5.3) ──
    # Same construct-once/reuse lifecycle pattern as STT_ENGINE/TTS_ENGINE
    # above. Previously NOTHING in on_startup() ever constructed a LiveSTT
    # instance at all — its event handlers existed and were even already
    # subscribed-to-self at __init__ time, but the class was never
    # instantiated anywhere, so MIC_AUDIO_CHUNK/LIVE_STT_START events from
    # Phase 5.1/5.2 had no live subscriber to actually receive them.
    #
    # Phase 5.5 — session/concurrency model decision (documented here, at
    # the instantiation site, per the roadmap's explicit instruction):
    #   ONE shared LiveSTT instance for the whole process, NOT one per
    #   WebSocket connection. This means LiveSTT is single-speaker-at-a-time:
    #   if two browser tabs/users both toggle live mic input concurrently,
    #   their audio chunks interleave into the same rolling buffer and
    #   partials will be a garbled mix of both speakers. This is an accepted
    #   limitation for the current solo-user deployment model (see
    #   jarvis.conf's own LAN/tunnel-exposure framing — this system is not
    #   designed for concurrent multi-user voice today). Moving to a
    #   per-connection instance would need: (a) one LiveSTT object + faster-
    #   whisper model load per connection (memory cost scales with
    #   concurrent connections, not just total users), and (b) chunk/start/
    #   stop events tagged with session_id and routed to the right
    #   instance instead of broadcast on the shared bus. Revisit this
    #   decision before any genuine multi-user voice deployment.
    try:
        from perception.speech.live_stt import LiveSTT, LiveSTTConfig
        STATE.live_stt = LiveSTT(
            bus=STATE.server_bus,
            # Deliberately NOT reusing FASTER_WHISPER_MODEL (used by the
            # batch STT_ENGINE above) — tiny.en is a deliberate latency
            # choice for the streaming path specifically (see this class's
            # module docstring); forcing the two to share one env var would
            # silently slow down partials for anyone who's set
            # FASTER_WHISPER_MODEL=medium/small for batch-transcription
            # quality.
            config=LiveSTTConfig(),
        )
        STATE.live_stt.start()
        log.info("LiveSTT initialised (server.py)", model=LiveSTTConfig().model_size)
    except Exception as e:
        log.error(f"LiveSTT init failed: {e}", exc_info=True)
        STATE.live_stt = None

    # Register a health check so a failed faster-whisper load (missing
    # package, corrupt cache, etc.) is visible in /health as "degraded"
    # instead of partials just silently never appearing with no signal why.
    if STATE.health_monitor is not None:
        try:
            from observability.health.health_monitor import HealthCheck as _HC_LiveSTT
            def _check_live_stt() -> bool:
                return STATE.live_stt is not None and STATE.live_stt.is_healthy
            STATE.health_monitor.register(_HC_LiveSTT(
                name="live_stt",
                check_fn=_check_live_stt,
                critical=False,
            ))
            await STATE.health_monitor.check_all()
            log.info("HealthMonitor: registered live_stt check")
        except Exception as e:
            log.warning(f"LiveSTT health check registration failed (non-fatal): {e}")

    # ── Task Planner (PlanningEngine + GoalManager) ───────────────────────────
    try:
        from cognition.planning.goal_manager import GoalManager
        from cognition.planning.task_planner import PlanningEngine
        gm = GoalManager()
        if STATE.server_bus is not None:
            gm.inject(STATE.server_bus)   # Fix #4: wire bus so goal events are published
        STATE.task_planner = PlanningEngine(gm)
        log.info("TaskPlanner (PlanningEngine) initialised")
    except Exception as e:
        log.error(f"TaskPlanner init failed: {e}")
        STATE.task_planner = None

    # ── Phase 8.1 (wired in 8.2) — Action dispatch / media / project intel ───
    # These three modules were added in Phase 8.1 but the wiring snippet in
    # PHASE8_STATUS.md was never actually applied to on_startup() — confirmed
    # absent on review. Wiring it now. Each step is independently non-fatal:
    # a failure here must not prevent server.py from booting or prevent the
    # orchestrator (below) from starting.
    STATE.media_service = None
    STATE.action_coordinator = None
    STATE.project_intelligence = None
    try:
        from actions.media.media_service import MediaService, register_media_tools
        STATE.media_service = MediaService(
            event_bus=STATE.server_bus,
            action_guard=STATE.action_guard,
        )
        await STATE.media_service.start()
        if STATE.tool_registry is not None:
            # register_all_tools() ran earlier (before MediaService existed),
            # so media.* tools were registered with service=None and would
            # error at call-time. Re-register them now that the live
            # MediaService instance exists, overwriting those stub entries.
            register_media_tools(STATE.tool_registry, service=STATE.media_service, event_bus=STATE.server_bus)
        log.info("Phase 8.1: MediaService online")
    except Exception as e:
        log.error(f"Phase 8.1: MediaService init failed (non-fatal): {e}")
        STATE.media_service = None

    try:
        from actions.action_coordinator import ActionCoordinator
        STATE.action_coordinator = ActionCoordinator(
            event_bus=STATE.server_bus,
            action_guard=STATE.action_guard,
            tool_registry=STATE.tool_registry,
            file_manager=getattr(STATE.action_guard, "file_manager", None),
            terminal_manager=getattr(STATE.action_guard, "terminal_manager", None),
            media_service=STATE.media_service,
            service_registry=None,
            system_health=STATE.health_monitor,
        )
        await STATE.action_coordinator.start()
        log.info("Phase 8.1: ActionCoordinator online")
    except Exception as e:
        log.error(f"Phase 8.1: ActionCoordinator init failed (non-fatal): {e}")
        STATE.action_coordinator = None

    try:
        from cognition.intelligence.project_intelligence import (
            ProjectIntelligence,
            subscribe_to_orchestrator,
        )
        # BUG FIX: pass event_bus so _publish_report() can forward
        # SystemHealthReport signals. Previously constructed with no args
        # so pi._bus was always None and publish was silently skipped.
        STATE.project_intelligence = ProjectIntelligence(
            event_bus=STATE.server_bus,
        )
        if STATE.server_bus is not None:
            subscribe_to_orchestrator(STATE.project_intelligence, STATE.server_bus)
        await STATE.project_intelligence.start()

        # Register with health_monitor so /health reflects it.
        # check_fn must be Callable[[], bool] — wrap the async snapshot
        # in a sync lambda that checks the loop is alive + no ABORT signal.
        if STATE.health_monitor is not None:
            from observability.health.health_monitor import HealthCheck as _HC
            _pi_ref = STATE.project_intelligence
            def _check_project_intelligence() -> bool:
                if _pi_ref is None or not _pi_ref._running:
                    return False
                last = _pi_ref._last_report
                if last is None:
                    return True   # not yet run — not unhealthy
                from cognition.schemas import SystemSignal
                return last.signal != SystemSignal.ABORT
            STATE.health_monitor.register(_HC(
                name="project_intelligence",
                check_fn=_check_project_intelligence,
                critical=False,
            ))

        # Wire orchestrator to honour PAUSE / ABORT signals from ProjectIntelligence.
        # Subscribes to system.health.report on the same bus; the orchestrator's
        # own _on_health_report is not yet implemented, so we handle it here
        # and set a flag on STATE that the orchestrator can check.
        if STATE.server_bus is not None:
            async def _on_pi_health_report(event) -> None:
                try:
                    from cognition.schemas import SystemSignal
                    signal = event.payload.get("signal", "")
                    if signal == SystemSignal.ABORT.value:
                        log.critical(
                            "ProjectIntelligence issued ABORT signal — "
                            "health_score=%.2f gap_count=%d",
                            event.payload.get("health_score", 0),
                            event.payload.get("gap_count", 0),
                        )
                        if STATE.orchestrator is not None:
                            await STATE.orchestrator.stop()
                    elif signal == SystemSignal.PAUSE.value:
                        log.warning(
                            "ProjectIntelligence issued PAUSE signal — "
                            "gap_count=%d",
                            event.payload.get("gap_count", 0),
                        )
                        # Surface as a WS broadcast so HUD can indicate degraded state
                        await manager.broadcast({
                            "type":         "system_health",
                            "signal":       signal,
                            "health_score": event.payload.get("health_score"),
                            "gap_count":    event.payload.get("gap_count", 0),
                            "gaps":         event.payload.get("gaps", []),
                        })
                except Exception as _phi_exc:
                    log.error(
                        "ProjectIntelligence health report handler error: %s",
                        _phi_exc, exc_info=True,
                    )
            STATE.server_bus.subscribe("system.health.report", _on_pi_health_report)

        log.info("Phase 8.1: ProjectIntelligence online")
    except Exception as e:
        log.error(f"Phase 8.1: ProjectIntelligence init failed (non-fatal): {e}")
        STATE.project_intelligence = None

    # ── Phase 2 — Kernel Orchestrator (cognition + multi-agent execution) ────
    # Wired only when JARVIS_ENABLE_ORCHESTRATOR=true.
    # Shares STATE.server_bus, STATE.memory_router, and STATE.tool_registry — no second copies.
    # The specialist agent classes (ResearchAgent, EngineeringAgent, …) are
    # instantiated inside Orchestrator._start_agents(); each registers itself
    # in the AgentRegistry and subscribes to its own EventBus topics.
    #
    # Bridge: agent.metrics.updated events are forwarded into the existing
    # AGENT_REGISTRY dict so the HUD UI keeps showing live agent stats
    # regardless of whether the orchestrator is enabled.
    STATE.orchestrator = None
    if JARVIS_ENABLE_ORCHESTRATOR and STATE.server_bus is not None and STATE.memory_router is not None:
        try:
            from models.router.model_router import get_router as _get_model_router
            _model_router = _get_model_router()
        except Exception as _mr_exc:
            log.warning(f"Phase 2: could not get ModelRouter ({_mr_exc}) — orchestrator will run without LLM routing")
            _model_router = None

        try:
            from kernel.orchestrator.orchestrator import Orchestrator
            STATE.orchestrator = Orchestrator(
                event_bus=STATE.server_bus,
                model_router=_model_router,
                memory_router=STATE.memory_router,
                tool_registry=STATE.tool_registry,
            )
            await STATE.orchestrator.start()

            # ── Bridge: relay agent.metrics.updated → AGENT_REGISTRY ────────
            # Keeps the HUD agent cards (which read from AGENT_REGISTRY) alive
            # with real live data from the running agent classes.
            _AGENT_NAME_MAP: dict[str, str] = {
                # agent.name (set in super().__init__) → AGENT_REGISTRY key
                # These are the actual canonical names used inside each agent class:
                "athena":      "athena",      # ResearchAgent
                "vision_eng":  "vision_eng",  # EngineeringAgent
                "ashura":      "ashura",      # AnalysisAgent
                "herald":      "herald",      # CommunicationAgent
                "friday":      "friday",      # AutomationAgent
                "vision":      "vision",      # VisionAgent (Bug 4 fix: own slot, no longer shares vision_eng)
                "oracle":      "oracle",      # PlanningAgent
                "coordinator": "coordinator", # CoordinatorAgent
            }

            async def _on_agent_metrics(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    raw_name = p.get("agent_name", p.get("agent", ""))
                    reg_key = _AGENT_NAME_MAP.get(raw_name, raw_name)
                    if reg_key not in AGENT_REGISTRY:
                        return
                    rec = AGENT_REGISTRY[reg_key]
                    # MetricsPublisherMixin nests everything inside p["metrics"]:
                    #   {"agent_name": ..., "current_task": ..., "metrics": {"tasks_done": ..., "status": ..., ...}}
                    metrics = p.get("metrics", {})
                    # Sync status and task description
                    if "status" in metrics:
                        rec["status"] = metrics["status"]
                    if p.get("current_task"):
                        rec["current_task"] = p["current_task"][:60]
                    # Sync counters
                    if "tasks_done" in metrics:
                        rec["tasks_done"] = metrics["tasks_done"]
                    if "tasks_failed" in metrics:
                        rec["tasks_failed"] = metrics["tasks_failed"]
                    # Phase 8.5: sync per-agent telemetry keys explicitly so
                    # _agent_metrics_message() can read them without extra logic.
                    for tkey in ("success_rate_pct", "avg_task_duration_ms", "tool_call_count"):
                        if tkey in metrics:
                            rec["metrics"][tkey] = metrics[tkey]
                    # Merge any other agent-specific keys into the nested metrics dict
                    for k, v in metrics.items():
                        if k not in ("tasks_done", "tasks_failed", "status", "uptime_s",
                                     "success_rate_pct", "avg_task_duration_ms", "tool_call_count"):
                            rec["metrics"][k] = v
                except Exception:
                    pass

            STATE.server_bus.subscribe("agent.metrics.updated", _on_agent_metrics)

            # ── Bridge: relay agent goal lifecycle → HUD workflow steps ─────
            async def _on_agent_goal_completed(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    raw_name = p.get("agent_name", p.get("agent", ""))
                    reg_key = _AGENT_NAME_MAP.get(raw_name, raw_name)
                    if reg_key in AGENT_REGISTRY:
                        AGENT_REGISTRY[reg_key]["status"] = "idle"
                        AGENT_REGISTRY[reg_key]["tasks_done"] += 1
                        AGENT_REGISTRY[reg_key]["current_task"] = ""
                except Exception:
                    pass

            async def _on_agent_goal_failed(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    raw_name = p.get("agent_name", p.get("agent", ""))
                    reg_key = _AGENT_NAME_MAP.get(raw_name, raw_name)
                    if reg_key in AGENT_REGISTRY:
                        AGENT_REGISTRY[reg_key]["status"] = "idle"
                        AGENT_REGISTRY[reg_key]["tasks_failed"] += 1
                        AGENT_REGISTRY[reg_key]["current_task"] = ""
                except Exception:
                    pass

            STATE.server_bus.subscribe("agent.goal_completed", _on_agent_goal_completed)
            STATE.server_bus.subscribe("agent.goal_failed", _on_agent_goal_failed)

            # ── Phase 8.4: relay live tool-call events → WS broadcast ────────
            # agent.tool_call.started / .completed are emitted by BaseAgent.invoke_tool()
            # for EVERY tool call any specialist makes. Forwarded as
            # {"type": "agent_tool_call", "agent": ..., "tool": ..., "state": "started"|"completed", ...}
            # on the existing agent_metrics_updated channel so both web HUD
            # (jarvisV3.html) and PySide6 agent_workspace can show live
            # in-progress tool steps without polling or building a second channel.
            async def _on_tool_call_started(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    await manager.broadcast({
                        "type":       "agent_tool_call",
                        "agent":      p.get("agent_name", ""),
                        "tool":       p.get("tool", ""),
                        "state":      "started",
                        "args":       p.get("args", {}),
                        "ts":         time.time(),
                    })
                except Exception:
                    pass

            async def _on_tool_call_completed(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    await manager.broadcast({
                        "type":       "agent_tool_call",
                        "agent":      p.get("agent_name", ""),
                        "tool":       p.get("tool", ""),
                        "state":      "completed",
                        "success":    p.get("success", True),
                        "elapsed_ms": p.get("elapsed_ms", 0),
                        "ts":         time.time(),
                    })
                except Exception:
                    pass

            STATE.server_bus.subscribe("agent.tool_call.started",   _on_tool_call_started)
            STATE.server_bus.subscribe("agent.tool_call.completed", _on_tool_call_completed)

            # ── Phase 8.4: relay goal_started with description → WS ──────────
            # agent.goal_started now carries a "description" field (Phase 8.4
            # BaseAgent change). Broadcast it so the HUD can show "working on X"
            # immediately rather than waiting for the first metrics-loop tick.
            async def _on_agent_goal_started(event) -> None:
                try:
                    p = event.payload if hasattr(event, "payload") else event
                    raw_name = p.get("agent_name", p.get("agent", ""))
                    reg_key = _AGENT_NAME_MAP.get(raw_name, raw_name)
                    if reg_key in AGENT_REGISTRY:
                        desc = p.get("description", "")[:60]
                        if desc:
                            AGENT_REGISTRY[reg_key]["current_task"] = desc
                        AGENT_REGISTRY[reg_key]["status"] = "working"
                    await manager.broadcast({
                        "type":        "agent_goal_started",
                        "agent":       raw_name,
                        "goal_id":     p.get("goal_id", ""),
                        "description": p.get("description", ""),
                        "ts":          time.time(),
                    })
                except Exception:
                    pass

            STATE.server_bus.subscribe("agent.goal_started", _on_agent_goal_started)

            # Register a health check for the orchestrator so /health reflects it.
            if STATE.health_monitor is not None:
                from observability.health.health_monitor import HealthCheck as _HC
                def _check_orchestrator() -> bool:
                    return STATE.orchestrator is not None and bool(STATE.orchestrator.agents)
                STATE.health_monitor.register(_HC(
                    name="orchestrator",
                    check_fn=_check_orchestrator,
                    critical=False,
                ))
                await STATE.health_monitor.check_all()

            log.info(
                "Phase 2: Orchestrator started",
                agents=list(STATE.orchestrator.agents.keys()),
            )
        except Exception as _orch_exc:
            log.warning(
                f"Phase 2: Orchestrator init failed (non-fatal, falling back to "
                f"pre-Phase-2 single-LLM routing): {_orch_exc}",
                exc_info=True,
            )
            STATE.orchestrator = None
    elif JARVIS_ENABLE_ORCHESTRATOR:
        log.warning(
            "Phase 2: Orchestrator skipped — EventBus or MemoryRouter not available "
            "(Orchestrator requires both). Set JARVIS_ENABLE_ORCHESTRATOR=false to silence this."
        )

    # ── P-12: Browser Tools (Playwright) ─────────────────────────────────────
    # browser_tools.py manages its own PlaywrightEngine singleton via _get_engine().
    # We just import the module and call _get_engine() once to warm it up.
    # There is no BrowserTools class — all tools are module-level functions.
    try:
        from tools.browser_tools import browser_tools as _bt_module
        engine = _bt_module._get_engine()   # warm up; creates PlaywrightEngine
        # Only call start() if not already running (PlaywrightEngine has no guard)
        already_started = getattr(engine, "_playwright", None) is not None
        if not already_started and hasattr(engine, "start") and asyncio.iscoroutinefunction(engine.start):
            await engine.start()
        STATE.browser_tools = _bt_module
        is_real = not isinstance(engine, _bt_module._StubEngine)
        if is_real:
            log.info("Browser tools: Playwright engine warmed up")
        else:
            log.warning("Browser tools: running in stub mode (Playwright not available)")
    except Exception as e:
        log.warning(f"Browser tools: init skipped ({type(e).__name__}: {e})")
        STATE.browser_tools = None

    # ── Embedding Service (SentenceTransformers → OpenAI API → TF-IDF) ───────
    # Reuse the instance already registered by Bootstrap in the DI container
    # so all agents, ReasoningEngine, and the HTTP endpoints share one singleton
    # (one loaded model in memory, one LRU cache).  Fall back to creating a
    # fresh instance only if the DI container isn't available (e.g. server.py
    # is run standalone without Bootstrap).
    try:
        try:
            from boot.dependency_container import DependencyContainer
            _di = DependencyContainer.get_instance()
            STATE.embedding_service = _di.try_resolve("embedding_service")
            globals()['EMBEDDING_SERVICE'] = STATE.embedding_service
        except Exception:
            STATE.embedding_service = None
            globals()['EMBEDDING_SERVICE'] = None

        if STATE.embedding_service is None:
            from models.embeddings.embedding_service import EmbeddingService
            STATE.embedding_service = EmbeddingService()
            globals()['EMBEDDING_SERVICE'] = STATE.embedding_service

        # Force lazy init now so the first embed() call isn't slow
        await STATE.embedding_service.embed("jarvis system ready")
        log.info(f"EmbeddingService ready — backend: {STATE.embedding_service.stats()['backend']}")
    except Exception as e:
        log.warning(f"EmbeddingService init failed (non-fatal): {e}")
        STATE.embedding_service = None

    # ── Daily Summary (event aggregator / intelligence compressor) ────────────
    try:
        from memory.summaries.daily_summary import DailySummary
        STATE.daily_summary = DailySummary()
        globals()['DAILY_SUMMARY'] = STATE.daily_summary
        log.info("DailySummary initialized")
    except Exception as e:
        log.warning(f"DailySummary init failed (non-fatal): {e}")
        STATE.daily_summary = None
        globals()['DAILY_SUMMARY'] = None

    # ── Acknowledgement Engine (backchannel filler phrases over TTS) ──────────
    # Reuses _server_bus created above — no second EventBus needed.
    # Windows note: perception.speech.acknowledgement needs project root on sys.path
    # which is now guaranteed by the top-of-file sys.path injection.
    try:
        import importlib as _il
        _ack_mod = _il.import_module("perception.speech.acknowledgement")
        AcknowledgementEngine = _ack_mod.AcknowledgementEngine
        AcknowledgementConfig = _ack_mod.AcknowledgementConfig
        # Use the shared STATE.server_bus (module-level) — NOT a local variable.
        # Using a local "_server_bus" here silently created an orphaned second
        # EventBus that nothing else subscribed to, breaking ack engine events.
        _ack_bus = STATE.server_bus
        if _ack_bus is None:
            from kernel.event_bus.event_bus import EventBus
            _ack_bus = EventBus()
            await _ack_bus.start()
            STATE.server_bus = _ack_bus   # keep module ref consistent
        _ack_cfg = AcknowledgementConfig(enabled=True, probability=0.82)
        STATE.acknowledgement_engine = AcknowledgementEngine(
            bus=_ack_bus,
            tts_router=None,   # server.py uses edge-tts directly
            config=_ack_cfg,
        )
        globals()['ACKNOWLEDGEMENT_ENGINE'] = STATE.acknowledgement_engine
        log.info("AcknowledgementEngine initialized")
    except Exception as e:
        log.warning(f"AcknowledgementEngine init failed (non-fatal): {type(e).__name__}: {e}")
        STATE.acknowledgement_engine = None
        globals()['ACKNOWLEDGEMENT_ENGINE'] = None

    # ── Phase 3 — Always-listening wake-word pipeline ─────────────────────────
    # Ground-rule compliance:
    #   • Non-fatal: each component wrapped in try/except; server still boots.
    #   • One shared EventBus: STATE.server_bus is passed everywhere.
    #   • Env-var gated: JARVIS_ENABLE_ALWAYS_LISTENING (default False).
    #   • Additive: existing push-to-talk (stt_audio WS message) is UNCHANGED.
    #   • Visible in /health: registers a HealthCheck when started.
    #
    # Architecture:
    #   MicrophoneEngine (audio source, manages its own internal audio_queue)
    #     ↓ _mic.audio_queue (primary) + subscribe_audio_queue() fanout
    #   HotwordDetector (reads _mic.audio_queue → fires HOTWORD_DETECTED)
    #   WakeListener    (reads _mic.audio_queue → IDLE→CANDIDATE→ARMED→LISTENING)
    #     ↓ LISTENING_ENDED event with raw PCM
    #   STTRouter → shared STATE.stt_engine → STT_TRANSCRIPTION_FINAL event
    #   VoiceCoordinator → voice.utterance.received event
    #     ↓ [_handle_voice_utterance subscriber below]
    #     ↓ calls call_ai() → publishes voice.response.ready
    #   TTSRouter → shared STATE.tts_engine → audio playback

    STATE.wake_word_manager = None
    STATE.voice_coordinator = None
    STATE.interrupt_detector = None  # Phase 10.2: set to live instance if always-listening starts

    if JARVIS_ENABLE_ALWAYS_LISTENING and STATE.server_bus is not None:
        try:
            import queue as _queue_mod
            from perception.speech.microphone import MicrophoneEngine, MicConfig
            from perception.speech.noise_calibrator import NoiseCalibrator
            from perception.speech.hotword import HotwordDetector, HotwordConfig
            from perception.speech.wake_listener import WakeListener, WakeListenerConfig, VoiceMode
            from perception.speech.stt_router import STTRouter
            from perception.speech.tts_router import TTSRouter as _TTSRouter
            from perception.speech.interrupt_detector import InterruptDetector
            from perception.speech.voice_coordinator import VoiceCoordinator
            from wakeword.manager import WakeWordManager

            # ── Microphone ─────────────────────────────────────────────────
            # FIX 1: Constructor is (bus, config: MicConfig | None = None).
            # No audio_queue param — MicrophoneEngine owns its internal queue.
            # Config class is MicConfig (not MicrophoneConfig); has no chunk_ms field.
            _mic = MicrophoneEngine(
                bus=STATE.server_bus,
                config=MicConfig(sample_rate=16_000),
            )

            # ── Noise calibration (one-shot at boot, non-blocking) ──────────
            # FIX 2: Constructor is (config: CalibratorConfig | None = None).
            # Method is .run() — no parameters. Duration is set in CalibratorConfig.
            try:
                _calibrator = NoiseCalibrator()
                _cal_result = _calibrator.run()
                log.info(
                    "Phase 3: noise calibration complete",
                    noise_floor=round(getattr(_cal_result, "noise_floor", 0.0), 4),
                    environment=getattr(_cal_result, "environment", "unknown"),
                )
            except Exception as _cal_exc:
                log.debug(f"Phase 3: noise calibration skipped ({_cal_exc})")

            # ── Hotword Detector ────────────────────────────────────────────
            # FIX 2: Pass _mic.audio_queue (the engine's real internal queue),
            # not a separately created _p3_audio_queue that was never wired in.
            _hotword = HotwordDetector(
                bus=STATE.server_bus,
                audio_queue=_mic.audio_queue,
                config=HotwordConfig(use_livekit=True),
            )

            # ── Wake Listener ───────────────────────────────────────────────
            # FIX 3: WakeListener reads the primary queue for IDLE-phase ambient
            # listening. Pass _mic.audio_queue here, then also register its own
            # private _mic_audio_queue for fanout via subscribe_audio_queue().
            _wake_cfg = WakeListenerConfig(mode=VoiceMode.WAKE_WORD)
            _wake_listener = WakeListener(
                bus=STATE.server_bus,
                audio_queue=_mic.audio_queue,
                config=_wake_cfg,
            )

            # Register WakeListener's own private queue for independent fanout —
            # this gives it every chunk without competing with HotwordDetector.
            if hasattr(_mic, "subscribe_audio_queue"):
                _mic.subscribe_audio_queue(_wake_listener._mic_audio_queue)

            # ── STT Router ──────────────────────────────────────────────────
            # Routes LISTENING_ENDED → shared STATE.stt_engine → STT_TRANSCRIPTION_FINAL
            _stt_router = STTRouter(
                event_bus=STATE.server_bus,
                engine=STATE.stt_engine,
                groq_api_key=GROQ_KEY,
            )

            # ── TTS Router ──────────────────────────────────────────────────
            # FIX 4: kwarg is `default_engine`, not `engine`.
            _tts_router = _TTSRouter(
                event_bus=STATE.server_bus,
                default_engine=STATE.tts_engine,
            )

            # ── Interrupt Detector ──────────────────────────────────────────
            _interrupt = InterruptDetector(event_bus=STATE.server_bus)
            # Phase 10.2: store on STATE so the WS push-to-talk TTS path can
            # call begin_monitoring() without needing the always-listening
            # pipeline active.
            STATE.interrupt_detector = _interrupt

            # ── Voice Coordinator ───────────────────────────────────────────
            STATE.voice_coordinator = VoiceCoordinator(
                event_bus=STATE.server_bus,
                tts_router=_tts_router,
                interrupt_detector=_interrupt,
            )

            # ── WakeWordManager (runtime enable/disable) ────────────────────
            STATE.wake_word_manager = WakeWordManager(
                bus=STATE.server_bus,
                mic=_mic,
                hotword_detector=_hotword,
                wake_listener=_wake_listener,
                config=STATE.config,
            )

            # ── Bridge: voice.utterance.received → call_ai() → voice.response.ready ──
            # VoiceCoordinator dispatches voice.utterance.received when STT completes.
            # This subscriber handles it: calls the existing call_ai() pipeline
            # (with memory context) and publishes voice.response.ready so
            # VoiceCoordinator drives TTS for the response.
            async def _handle_voice_utterance(event) -> None:
                payload = event.payload if hasattr(event, "payload") else event
                run_id  = payload.get("run_id", "")
                text    = payload.get("text", "").strip()
                lang    = payload.get("language", "en") or "en"
                if not text:
                    return
                try:
                    _ai_reply: AIReply = await call_ai("oracle", text)
                    reply    = _ai_reply.text
                    provider = _ai_reply.provider
                    log.info(f"Phase 3: voice AI response via {provider} ({len(reply)} chars)")
                    if STATE.metrics_collector is not None:
                        STATE.metrics_collector.increment("voice_pipeline_completions_total")
                    from kernel.event_bus.event_bus import Event as _Ev, Priority as _Pr
                    await STATE.server_bus.publish(_Ev(
                        event_type="voice.response.ready",
                        source="server.voice_bridge",
                        payload={"run_id": run_id, "text": reply, "language": lang},
                        priority=_Pr.HIGH,
                    ))
                    # Also broadcast to any HUD WebSocket clients so the chat
                    # panel shows the voice conversation in real time.
                    _voice_chat_reply: dict = {
                        "type": "chat_reply", "agent": "oracle",
                        "text": reply, "provider": provider,
                        "source": "voice_pipeline",
                    }
                    # Phase 6.4 — same fallback-visibility fields as the main
                    # WS chat path, so a fallback during a voice turn is
                    # visible too, not just for typed messages.
                    if _ai_reply.fallback_occurred:
                        _voice_chat_reply["fallback_occurred"] = True
                        _voice_chat_reply["fallback_selected"] = _ai_reply.fallback_selected
                        _voice_chat_reply["answered_by"] = provider
                    await manager.broadcast(_voice_chat_reply)
                    await manager.broadcast({
                        "type": "voice_utterance_ack",
                        "transcript": text, "reply": reply,
                        "language": lang, "provider": provider,
                    })
                except Exception as _ve:
                    log.warning(f"Phase 3: voice utterance handler error: {_ve}")

            STATE.server_bus.subscribe("voice.utterance.received", _handle_voice_utterance)

            # ── Start everything ────────────────────────────────────────────
            await _stt_router.start()
            await _tts_router.start()
            await STATE.voice_coordinator.start()

            # Start mic + hotword + wake listener via WakeWordManager
            _mic.start()
            STATE.wake_word_manager.enable()

            # Register Phase 3 health check
            if STATE.health_monitor is not None:
                from observability.health.health_monitor import HealthCheck as _HC3
                def _check_voice_pipeline() -> bool:
                    return (
                        STATE.voice_coordinator is not None
                        and getattr(STATE.voice_coordinator, "_running", False)
                        and STATE.wake_word_manager is not None
                        and STATE.wake_word_manager.is_running()
                    )
                STATE.health_monitor.register(_HC3(
                    name="voice_pipeline",
                    check_fn=_check_voice_pipeline,
                    critical=False,
                ))
                await STATE.health_monitor.check_all()

            log.info(
                "Phase 3: always-listening voice pipeline online",
                hotword="hey jarvis",
                stt=STATE.stt_engine.__class__.__name__ if STATE.stt_engine else "None",
                tts=STATE.tts_engine.__class__.__name__ if STATE.tts_engine else "None",
            )

        except Exception as _p3_exc:
            log.warning(
                f"Phase 3: always-listening init failed (non-fatal, push-to-talk unaffected): {_p3_exc}",
                exc_info=True,
            )
            STATE.wake_word_manager = None
            STATE.voice_coordinator = None
    else:
        if JARVIS_ENABLE_ALWAYS_LISTENING:
            log.warning(
                "Phase 3: always-listening skipped — EventBus unavailable. "
                "Set JARVIS_ENABLE_ALWAYS_LISTENING=false to silence this."
            )
        else:
            log.info("Phase 3: always-listening disabled (JARVIS_ENABLE_ALWAYS_LISTENING=false)")

    # ── Phase 3 — VisionPipeline + ActivityObserver (feeds ProactiveEngine) ──
    # VisionPipeline captures screen frames and publishes perception.vision.*
    # events. ActivityObserver polls active windows, idle time, and processes;
    # publishes perception.activity.* events. ProactiveEngine (Phase 2) consumes
    # activity snapshots when the orchestrator is enabled. Both non-fatal standalone.
    STATE.activity_observer = None
    STATE.vision_pipeline = None

    if JARVIS_ENABLE_VISION_PIPELINE and STATE.server_bus is not None:
        # ── VisionPipeline ─────────────────────────────────────────────────
        try:
            from perception.vision.vision_pipeline import VisionPipeline
            _model_router_for_vision = None
            try:
                from models.router.model_router import get_router as _get_mr_v
                _model_router_for_vision = _get_mr_v()
            except Exception:
                pass
            STATE.vision_pipeline = VisionPipeline(
                event_bus=STATE.server_bus,
                model_router=_model_router_for_vision,
                capture_interval=2.0,
                auto_capture=False,   # on-demand only; avoid continuous CPU load
            )
            await STATE.vision_pipeline.start()

            if STATE.health_monitor is not None:
                from observability.health.health_monitor import HealthCheck as _HCV
                def _check_vision_pipeline() -> bool:
                    return STATE.vision_pipeline is not None and getattr(STATE.vision_pipeline, "_running", False)
                STATE.health_monitor.register(_HCV(
                    name="vision_pipeline",
                    check_fn=_check_vision_pipeline,
                    critical=False,
                ))
                await STATE.health_monitor.check_all()

            log.info("Phase 3: VisionPipeline started (auto_capture=False, on-demand only)")
        except Exception as _vp_exc:
            log.warning(f"Phase 3: VisionPipeline init failed (non-fatal): {_vp_exc}")
            STATE.vision_pipeline = None

        # ── ActivityObserver ───────────────────────────────────────────────
        try:
            from perception.observation.activity_observer import ActivityObserver
            STATE.activity_observer = ActivityObserver(
                event_bus=STATE.server_bus,
                poll_interval=10.0,   # every 10 s — lightweight
                idle_threshold=60.0,
                track_processes=True,
            )
            await STATE.activity_observer.start()

            # If ProactiveEngine is accessible via Orchestrator, subscribe it
            # to activity snapshots so it gets a live context signal.
            if STATE.orchestrator is not None:
                try:
                    _proactive = getattr(STATE.orchestrator, "_proactive_engine", None)
                    if _proactive is None:
                        _proactive = getattr(STATE.orchestrator, "proactive_engine", None)

                    if _proactive is not None:
                        async def _on_activity_snapshot(event) -> None:
                            try:
                                payload = event.payload if hasattr(event, "payload") else event
                                _proactive.observe_decision(type("_D", (), {
                                    "score": 0.8, "confidence": "medium",
                                    "reasoning": str(payload.get("active_window", "")),
                                    "action": "activity_snapshot",
                                })())
                            except Exception:
                                pass
                        STATE.server_bus.subscribe(
                            ActivityObserver.EVT_SNAPSHOT, _on_activity_snapshot
                        )
                        log.info("Phase 3: ActivityObserver → ProactiveEngine bridge active")
                except Exception as _pe_exc:
                    log.debug(f"Phase 3: ProactiveEngine bridge skipped ({_pe_exc})")

            log.info("Phase 3: ActivityObserver started (poll_interval=10s)")
        except Exception as _ao_exc:
            log.warning(f"Phase 3: ActivityObserver init failed (non-fatal): {_ao_exc}")
            STATE.activity_observer = None
    prov: list[str] = []
    if GROQ_KEY:   prov.append("Groq ✓")
    if _qwen_openvino_enabled(): prov.append("Qwen-OpenVINO (local)")
    if GEMINI_KEY: prov.append("Gemini ✓")
    prov.append(f"Ollama/{OLLAMA_MODEL} (local fallback)")

    log.info("=" * 62)
    log.info("  J.A.R.V.I.S  HTML HUD  BACKEND  ONLINE")
    log.info(f"  WS/HTTP:   ws://{HOST}:{PORT}/ws")
    log.info(f"  AI:        {' → '.join(prov)}")
    log.info(f"  STT:       Groq Whisper → faster-whisper/{FASTER_WHISPER_MODEL}")
    log.info(f"  TTS:       edge-tts → Kokoro ONNX")
    log.info(f"  Memory:    {MEMORY_DB}")
    log.info("=" * 62)


# ── Phase 3 — Graceful shutdown (updated from Phase 2) ───────────────────────
async def on_shutdown():
    """
    Gracefully stop all phased subsystems on server exit.
    Phase 3 components (voice pipeline, vision, activity observer) are stopped
    first, then Phase 2 (Orchestrator), then Phase 1 (Action Guard).
    All subsystems are non-fatal — errors are logged and shutdown continues.
    """
    # All subsystems below live on STATE (AppState) — no `global` needed.

    # ── Phase 3: always-listening voice pipeline ─────────────────────────────
    if STATE.activity_observer is not None:
        try:
            await STATE.activity_observer.stop()
            log.info("Phase 3: ActivityObserver stopped")
        except Exception as exc:
            log.warning(f"Phase 3: ActivityObserver stop() raised (non-fatal): {exc}")
        STATE.activity_observer = None

    if STATE.vision_pipeline is not None:
        try:
            await STATE.vision_pipeline.stop()
            log.info("Phase 3: VisionPipeline stopped")
        except Exception as exc:
            log.warning(f"Phase 3: VisionPipeline stop() raised (non-fatal): {exc}")
        STATE.vision_pipeline = None

    if STATE.voice_coordinator is not None:
        try:
            await STATE.voice_coordinator.stop()
            log.info("Phase 3: VoiceCoordinator stopped")
        except Exception as exc:
            log.warning(f"Phase 3: VoiceCoordinator stop() raised (non-fatal): {exc}")
        STATE.voice_coordinator = None

    if STATE.wake_word_manager is not None:
        try:
            STATE.wake_word_manager.disable()
            log.info("Phase 3: WakeWordManager disabled")
        except Exception as exc:
            log.warning(f"Phase 3: WakeWordManager disable() raised (non-fatal): {exc}")
        STATE.wake_word_manager = None

    # ── Phase 5.3: LiveSTT (shared streaming-partial instance) ──────────────
    # STT_ENGINE/TTS_ENGINE above have no corresponding stop() call in this
    # function either (pre-existing gap, not introduced here) — LiveSTT gets
    # one because its .stop() does a real thread .join(timeout=3.0) and it
    # costs nothing extra to shut down cleanly given the method already
    # exists.
    if STATE.live_stt is not None:
        try:
            STATE.live_stt.stop()
            log.info("Phase 5.3: LiveSTT stopped")
        except Exception as exc:
            log.warning(f"Phase 5.3: LiveSTT stop() raised (non-fatal): {exc}")
        STATE.live_stt = None

    # ── Phase 1: Safety & Action Layer ───────────────────────────────────────
    # FIX 7: was missing the `if STATE.action_guard is not None:` guard, which caused
    # a crash at shutdown when STATE.action_guard was never initialised.
    if STATE.action_guard is not None:
        try:
            await STATE.action_guard.stop()
            log.info("Phase 1: Safety & Action Layer shut down cleanly")
        except Exception as exc:
            log.warning(f"Phase 1: ActionGuard stop() raised (non-fatal): {exc}")
        STATE.action_guard = None

    # ── Phase 2: Orchestrator ─────────────────────────────────────────────────
    if STATE.orchestrator is not None:
        try:
            await STATE.orchestrator.stop()
            log.info("Phase 2: Orchestrator shut down cleanly")
        except Exception as exc:
            log.warning(f"Phase 2: Orchestrator stop() raised (non-fatal on shutdown): {exc}")
        STATE.orchestrator = None


# ═══════════════════════════════════════════════════════════════════════════════
#  ENTRY POINT
# ═══════════════════════════════════════════════════════════════════════════════

def _install_shutdown_diagnostics():
    """
    Log exactly which OS signal triggered a shutdown, and dump all thread
    stacks at that instant. uvicorn's default signal handler just sets an
    internal should_exit flag and prints 'Shutting down' — it never tells
    you *why*. This wraps the handler so the cause is visible in the log
    instead of looking like a silent/unexplained exit.
    """
    import sys
    import signal as _signal
    import traceback as _traceback
    import faulthandler as _faulthandler

    _SIGNAL_NAMES = {
        getattr(_signal, n): n
        for n in dir(_signal)
        if n.startswith("SIG") and not n.startswith("SIG_")
    }

    def _handler(signum, frame):
        name = _SIGNAL_NAMES.get(signum, str(signum))
        log.warning(f"Shutdown signal received: {name} ({signum}) — dumping thread stacks for diagnosis")
        try:
            _faulthandler.dump_traceback(file=sys.stdout)
        except Exception:
            log.warning("Thread stack dump:\n" + "".join(_traceback.format_stack(frame)))
        # Re-raise the default behavior uvicorn/Python expects.
        raise KeyboardInterrupt()

    for sig in (_signal.SIGINT, _signal.SIGTERM):
        try:
            _signal.signal(sig, _handler)
        except (ValueError, OSError):
            pass  # not available on this platform/thread

    # CTRL_CLOSE_EVENT / CTRL_LOGOFF_EVENT / CTRL_SHUTDOWN_EVENT (Windows only):
    # these fire when the *console window* closes, the user logs off, or the
    # OS shuts down — none of which are a normal Ctrl+C. Windows delivers
    # these via a separate console control handler, not via signal.signal().
    if sys.platform == "win32":
        try:
            import ctypes

            _CTRL_NAMES = {
                0: "CTRL_C_EVENT",
                1: "CTRL_BREAK_EVENT",
                2: "CTRL_CLOSE_EVENT (console window closed)",
                5: "CTRL_LOGOFF_EVENT (user logged off)",
                6: "CTRL_SHUTDOWN_EVENT (OS shutting down)",
            }

            @ctypes.WINFUNCTYPE(ctypes.c_int, ctypes.c_uint)
            def _win_console_handler(ctrl_type):
                log.warning(
                    f"Windows console control event received: "
                    f"{_CTRL_NAMES.get(ctrl_type, ctrl_type)} — this is what is killing the process, "
                    f"not application code."
                )
                return False  # let default handling continue (don't block OS shutdown)

            ctypes.windll.kernel32.SetConsoleCtrlHandler(_win_console_handler, True)
            # Keep a reference alive so it isn't garbage-collected.
            _install_shutdown_diagnostics._win_handler_ref = _win_console_handler
        except Exception as exc:
            log.warning(f"Could not install Windows console control handler: {exc}")


if __name__ == "__main__":
    _install_shutdown_diagnostics()
    uvicorn.run(
        "server:app",
        host=HOST,
        port=PORT,
        log_level="info",
        reload=False,
    )