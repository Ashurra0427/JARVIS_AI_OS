# ============================================================
# JARVIS AI OS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is never committed to version control.
# API keys in this file override config/models.yaml at runtime.
# ============================================================


# ============================================================
# LLM Providers
# ============================================================

# Gemini — PRIMARY provider (required for default config)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq — SECONDARY provider + Whisper STT via API
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI — optional, enable in config/models.yaml
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude — optional
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=


# ============================================================
# Tool APIs
# ============================================================

# Google / Serper web search (used by ResearchAgent)
# Get key: https://serper.dev/
SERPER_API_KEY=

# NewsAPI — news fetching tool
# Get key: https://newsapi.org/register
NEWS_API_KEY=

# Wolfram Alpha — computation/knowledge tool
# Get key: https://developer.wolframalpha.com/
WOLFRAM_APP_ID=

# GitHub — code/repo tool
# Create token: https://github.com/settings/tokens
GITHUB_TOKEN=

# ElevenLabs — premium TTS (optional, edge-tts is the default)
# Get key: https://elevenlabs.io/
ELEVENLABS_API_KEY=


# ============================================================
# Phase 0 — Foundations (server_integration_brief.md)
# ============================================================
# Each subsystem below is additive and non-fatal: if it fails to load,
# server.py logs a warning and keeps running with that subsystem set to
# None. Set any of these to "0"/"false"/"no" to disable instantly without
# a code change. All default to enabled (true).

# config/settings.py — ConfigManager (layers config/*.yaml + JARVIS_SECTION__KEY
# env vars). Existing os.getenv() calls elsewhere in server.py are untouched.
JARVIS_ENABLE_CONFIG_MANAGER=true

# observability/logging/logger.py — LoggerFactory/get_logger, routes
# "jarvis.*" loggers through one consistently formatted handler.
JARVIS_ENABLE_STRUCTURED_LOGGING=true

# observability/health/health_monitor.py — backs GET /health with real
# subsystem checks (event_bus, tool_registry, memory_router, model_router)
# instead of a static "ok".
JARVIS_ENABLE_HEALTH_MONITOR=true

# observability/metrics/metrics_collector.py — backs GET /metrics with
# real counters (HTTP requests served, tool invocations) in addition to
# the existing CPU/RAM/disk snapshot.
JARVIS_ENABLE_METRICS_COLLECTOR=true


# ============================================================
# Local Model / Ollama
# ============================================================

# Base URL for local Ollama server (default shown)
# Only change if you run Ollama on a non-default port or remote host
OLLAMA_BASE_URL=http://localhost:11434


# ============================================================
# System Overrides
# ============================================================

# Override the environment tag (development | staging | production)
# JARVIS_SYSTEM__ENVIRONMENT=development

# Override log level (DEBUG | INFO | WARNING | ERROR)
# JARVIS_LOGGING__LEVEL=INFO

# Override data directory
# JARVIS_SYSTEM__DATA_DIR=datastore

# ============================================================
# OpenVINO Local Inference (qwen2.5-Coder-7b-instruct_int4)
# ============================================================

# Target device for OpenVINO inference.
# Options:
#   AUTO           — let OpenVINO pick best available device (default)
#   CPU            — Intel/AMD CPU (always works, no driver needed)
#   GPU            — Intel integrated GPU or Arc discrete GPU
#   GPU.0          — first GPU (when multiple are present)
#   GPU.1          — second GPU
#   MULTI:GPU,CPU  — run on GPU with automatic CPU fallback (recommended)
#   HETERO:GPU,CPU — heterogeneous: split layers across GPU + CPU
#   NPU            — Intel NPU (Meteor Lake+ / Core Ultra laptops)
OPENVINO_DEVICE=AUTO

# Phase 7.4 — QWEN_OPENVINO_DEVICE: explicit device for the QwenOpenVINO
# provider, separate from the general OPENVINO_DEVICE above.
# ModelRouter checks openvino.Core().available_devices at boot and logs a
# clear WARNING (+ falls back to CPU) if the requested device is unavailable.
#
# Recommended safe default for machines without a confirmed GPU driver:
#   QWEN_OPENVINO_DEVICE=CPU
# Recommended for Intel laptops with iGPU (verified driver installed):
#   QWEN_OPENVINO_DEVICE=HETERO:GPU,CPU
#
# Without this set, server.py defaults to HETERO:GPU,CPU which may silently
# run CPU-only if no GPU driver is installed. Setting CPU explicitly avoids
# the warning and is always correct.
QWEN_OPENVINO_DEVICE=CPU

# Phase 7.4 — QWEN_OPENVINO_CPU_THREADS: number of CPU threads for OpenVINO
# CPU inference. 0 = auto (OpenVINO picks), which can consume all cores.
# A conservative value (e.g. 4 on an 8-core machine) leaves headroom for
# the FastAPI event loop and other tasks.
# server.py auto-sets this to (logical_cores - 2) if not set and CPU is in
# the device string, but explicit is better than implicit.
QWEN_OPENVINO_CPU_THREADS=4

# Performance hint sent to the OpenVINO runtime.
#   LATENCY     — minimise time-to-first-token (best for voice/chat)
#   THROUGHPUT  — maximise tokens/sec (best for long document tasks)
OPENVINO_PERFORMANCE_HINT=LATENCY

# Inference precision for GPU execution.
#   f16  — half precision (faster, less VRAM, default)
#   f32  — full precision (more accurate, uses more memory)
#   bf16 — bfloat16 (Sapphire Rapids+ CPUs with AMX)
OPENVINO_INFER_PRECISION=f16

# Number of parallel inference streams per device.
# Leave blank to let the performance hint decide (recommended).
# Set to 1 for lowest memory usage; 2-4 for higher throughput.
# OPENVINO_NUM_STREAMS=1

# Number of CPU threads. 0 = auto-detect (recommended).
OPENVINO_CPU_THREADS=0

# Whether to cache compiled kernels on disk (speeds up subsequent cold starts).
OPENVINO_ENABLE_CACHE=true


# ─────────────────────────────────────────────────────────────────────────────
# Phase 1 — Safety & Action Layer (server_integration_brief.md)
# ─────────────────────────────────────────────────────────────────────────────
# Wires PolicyEngine + PermissionManager + ActionGuard as a mandatory checkpoint
# inside ToolRegistry.invoke() so every tool call passes through policy
# enforcement before executing.  Also starts TerminalManager (replaces raw
# subprocess.run in system.execute) and FileManager (enforces path sandboxing
# for file read/write/delete tools).
#
# Deny-by-default for destructive actions (delete outside /tmp, write to /etc,
# shell exec with dangerous patterns like rm -rf /).  Allow-by-default for safe
# reads.  High-risk actions (risk ≥ 0.70) require confirmation if a callback is
# registered; CRITICAL actions (risk ≥ 0.85) are auto-blocked regardless.
#
# Audit log: logs/audit/audit_*.jsonl (persistent, rotated at 10 MB)
# View live status: GET /security/status
# View audit records: GET /security/audit?requester=&action_type=&allowed=
# View policy rules: GET /security/policy
#
# Default: true — set to false to disable the entire layer and revert to
# pre-Phase-1 unguarded subprocess calls.
JARVIS_ENABLE_ACTION_GUARD=true

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2 — Cognition & Multi-Agent Execution (server_integration_brief.md)
# ─────────────────────────────────────────────────────────────────────────────
# Start the Kernel Orchestrator with all specialist agent classes
# (ResearchAgent / ATHENA, EngineeringAgent / VISION, AnalysisAgent / ASHURA,
# CommunicationAgent / HERALD, AutomationAgent / FRIDAY, PlanningAgent / ORACLE,
# VisionAgent, CoordinatorAgent) and the full cognition pipeline
# (ReasoningEngine → DecisionEngine → PlanningEngine).
#
# When enabled, non-streaming chat requests are routed through the Coordinator
# Agent which dispatches to specialist agents via the EventBus. Falls back to
# the standard call_ai() path automatically if the orchestrator does not
# respond within JARVIS_ORCH_REPLY_TIMEOUT_S (see below).
#
# Requires JARVIS_ENABLE_HEALTH_MONITOR=true (or HEALTH_MONITOR available) for
# the orchestrator health check to appear in /health.
# Requires MemoryRouter and EventBus to be running (they are by default).
#
# Default: false — set to true to opt in. Revert instantly by setting false.
JARVIS_ENABLE_ORCHESTRATOR=true

# How long (seconds) server.py waits for the orchestrator's "user.reply"
# event before falling back to call_ai(). Simple messages answer almost
# immediately via CoordinatorAgent's fast path and don't depend on this;
# this budget is for requests that need full multi-agent planning.
# Default: 45.0 — a starting point, not a profiled value. Re-tune based on
# observed plan-completion latency in your deployment.
JARVIS_ORCH_REPLY_TIMEOUT_S=45.0

# ── Nightly DB backup (agents/agro/backup_manager.py) ──────────────────────
# Local rotation runs automatically every night at 23:59 NPT, no setup
# needed. These are optional overrides:
# AGRO_BACKUP_KEEP_DAYS=7
# AGRO_BACKUP_WEBHOOK_URL=https://your-webhook-endpoint.example.com/upload
