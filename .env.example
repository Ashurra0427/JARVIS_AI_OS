# ============================================================
# JARVIS AI OS — Environment Variables (EXAMPLE)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is never committed to version control.
# API keys in this file override config/models.yaml at runtime.
# ============================================================


# ============================================================
# LLM Providers
# ============================================================

# Gemini — PRIMARY provider (required for default config)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq — SECONDARY provider + Whisper STT via API
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — optional, enable in config/models.yaml
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude — optional
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=


# ============================================================
# Tool APIs
# ============================================================

# Google / Serper web search (used by ResearchAgent)
# Get key: https://serper.dev/
SERPER_API_KEY=

# NewsAPI — news fetching tool
# Get key: https://newsapi.org/register
NEWS_API_KEY=

# Wolfram Alpha — computation/knowledge tool
# Get key: https://developer.wolframalpha.com/
WOLFRAM_APP_ID=

# GitHub — code/repo tool
# Create token: https://github.com/settings/tokens
GITHUB_TOKEN=

# ElevenLabs — premium TTS (optional, edge-tts is the default)
# Get key: https://elevenlabs.io/
ELEVENLABS_API_KEY=


# ============================================================
# Local Model / Ollama
# ============================================================

# Base URL for local Ollama server (default shown)
OLLAMA_BASE_URL=http://localhost:11434


# ============================================================
# System Overrides
# ============================================================

JARVIS_PORT=7788
JARVIS_SECRET=
JARVIS_ENABLE_ORCHESTRATOR=false
