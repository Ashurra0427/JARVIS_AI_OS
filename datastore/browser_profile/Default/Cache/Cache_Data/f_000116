    var AUCTION = {
        namespace:             _overrides.namespace             || 'tmpbjs',  // single shared Prebid namespace for all templates
        prebidUrl:             _overrides.prebidUrl             || '//dsrv.tmadsrv.com/auction/tmpbjs.js',
        timeout:               _overrides.timeout               || 1500,
        auctionRetries:        _overrides.auctionRetries        || 0,     // internal per-auction retries (same req data, short backoff)
        auctionBackoff:        _overrides.auctionBackoff        || 200,   // ms between internal retries
        prebidPollInterval:    _overrides.prebidPollInterval    || 10,    // ms between Prebid ready polls
        maxPrebidPollAttempts: _overrides.maxPrebidPollAttempts || 20,    // max Prebid ready polls
        debug:                 _overrides.debug || _dbg(),  // tied to __tmdebug — see _installDebugFlag above
    };

    var PRICE_BUCKETS = {
        granularity: 'custom',
        bands: _overrides.priceBands || [
            { min: 0.10, max: 1.00,  increment: 0.10 },
            { min: 1.00, max: 3.00,  increment: 0.25 },
            { min: 3.00, max: 5.00,  increment: 0.50 },
            { min: 5.00, max: 10.00, increment: 1.00 },
        ],
        minCpm: _overrides.minCpm || 0.10,
        maxCpm: _overrides.maxCpm || 10.00,

        prebidFormat: function () {
            return {
                buckets: PRICE_BUCKETS.bands.map(function (b) {
                    return { min: b.min, max: b.max, increment: b.increment };
                })
            };
        },

        bucketCpm: function (cpm) {
            if (!cpm || cpm < PRICE_BUCKETS.minCpm) return null;
            var cappedCpm = Math.min(cpm, PRICE_BUCKETS.maxCpm);
            var bands     = PRICE_BUCKETS.bands;
            var bucketUsd = null;
            for (var i = 0; i < bands.length; i++) {
                var b = bands[i];
                if (cappedCpm >= b.min && cappedCpm <= b.max) {
                    bucketUsd = Math.floor(cappedCpm / b.increment) * b.increment;
                    bucketUsd = Math.round(bucketUsd * 100) / 100;
                    break;
                }
            }
            if (bucketUsd === null && cappedCpm === PRICE_BUCKETS.maxCpm) {
                bucketUsd = PRICE_BUCKETS.maxCpm;
            }
            if (bucketUsd === null) return null;
            var cents = Math.round(bucketUsd * 100);
            return cents.toString().padStart(4, '0');
        },
    };

    var PREBID_CONFIG = {
        debug:              false,
        bidderTimeout:      AUCTION.timeout,
        enableSendAllBids:  _overrides.enableSendAllBids  !== undefined ? _overrides.enableSendAllBids  : false,
        useBidCache:        _overrides.useBidCache         !== undefined ? _overrides.useBidCache         : false,
        deviceAccess:       _overrides.deviceAccess        !== undefined ? _overrides.deviceAccess        : true,
        disableAjaxTimeout: _overrides.disableAjaxTimeout  !== undefined ? _overrides.disableAjaxTimeout  : false,
        maxNestedIframes:   _overrides.maxNestedIframes    || 10,
        maxBid:             _overrides.maxBid              || 5000,
        enableTIDs:         _overrides.enableTIDs          !== undefined ? _overrides.enableTIDs          : true,
        priceGranularity:   PRICE_BUCKETS.granularity,
        customPriceBucket:  PRICE_BUCKETS.prebidFormat(),
        currency: { adServerCurrency: _overrides.adServerCurrency || 'USD' },
        userSync: {
            syncEnabled:    _overrides.syncEnabled    !== undefined ? _overrides.syncEnabled    : true,
            syncsPerBidder: _overrides.syncsPerBidder || 999,
            syncDelay:      _overrides.syncDelay      || 3000,
            auctionDelay:   _overrides.auctionDelay   || 0,
            filterSettings: {
                iframe: { bidders: '*', filter: 'include' },
                image:  { bidders: '*', filter: 'include' },
            },
            userIds: _overrides.userIds || [
                { name: 'novatiq', bidders: ['equativ','smartadserver'], params: { sourceid: 'Hcj' } },
            ],
        },
        auctionOptions: {
            rejectInvalidMediaTypes: _overrides.rejectInvalidMediaTypes !== undefined ? _overrides.rejectInvalidMediaTypes : false,
            rejectUnknownMediaTypes: _overrides.rejectUnknownMediaTypes !== undefined ? _overrides.rejectUnknownMediaTypes : false,
        },
        storageControl:   { enforcement: _overrides.storageEnforcement || 'warn' },
        floors:           {},
        instreamTracking: { enabled: false },
        s2sConfig: {
            bidders:                 [],
            adapter:                 'prebidServer',
            allowUnknownBidderCodes: false,
            syncTimeout:             _overrides.s2sSyncTimeout || 1000,
            maxTimeout:              AUCTION.timeout,
        },
        realTimeData: { dataProviders: [] },
    };

    /* Telemetry endpoints — injected dynamically from server response.
     * Set via tmHBConfig.setEndpoints(jsonResponse) called by the template
     * after receiving the /req response. Defaults are fallback only. */
    var TELEMETRY = {
        ihbEndpoint:      _overrides.ihbEndpoint      || 'https://hb-rpt-akamai.tmadsrv.com/api/v1/events',
        unfilledEndpoint: _overrides.unfilledEndpoint || 'https://hb-rpt.tmadsrv.com/api/v1/requestImpressionTrack',
        xhrTimeout:       _overrides.xhrTimeout       || 3000,
        events: { REQ: 'req', BID_WON: 'bidWon', IMP: 'imp', CLICK: 'click', UNFILLED: 'unfilled' },
    };

    var BIDDER_SETTINGS = {
        standard: { storageAllowed: true, adserverTargeting: [] },
    };

    var BIDDER_FLAGS = {
        requiresIpParam: _overrides.requiresIpParam || ['pixfuture'],
        aliasMap:        _overrides.aliasMap        || { vaayaMedia: 'limelightDigital' },
        schainWarnings:  _overrides.schainWarnings  || ['pixfuture'],
    };

    var LOG = {
        // 'enabled' is read live via _dbg() on every call below — NOT a snapshot —
        // so toggling window.__tmdebug at runtime (e.g. from console) takes effect
        // immediately without needing a page reload, and ?tmdebug=1 always applies
        // regardless of definition order relative to other tmCore sections.
        get enabled() { return _dbg(); },
        _ts: function () { return new Date().toISOString().slice(11, 23); },
        info: function (mod, msg) {
            if (!LOG.enabled) return;
            console.log('%c[TM:HB:' + mod + '] [' + LOG._ts() + '] ' + msg, 'color:#4fc3f7;font-weight:600;font-size:11px');
        },
        ok: function (mod, msg) {
            if (!LOG.enabled) return;
            console.log('%c[TM:HB:' + mod + '] ✅ ' + msg, 'color:#66bb6a;font-weight:700;font-size:11px');
        },
        warn: function (mod, msg) {
            if (!LOG.enabled) return;
            console.warn('%c[TM:HB:' + mod + '] ⚠️  ' + msg, 'color:#ffb74d;font-weight:600;font-size:11px');
        },
        error: function (mod, msg) {
            if (!LOG.enabled) return;
            console.error('%c[TM:HB:' + mod + '] ❌ ' + msg, 'color:#ef5350;font-weight:700;font-size:12px');
        },
    };

    var tmHBConfig = {
        auction:        AUCTION,
        priceBuckets:   PRICE_BUCKETS,
        prebidConfig:   PREBID_CONFIG,
        telemetry:      TELEMETRY,
        bidderSettings: BIDDER_SETTINGS,
        bidderFlags:    BIDDER_FLAGS,
        log:            LOG,
        namespace:      AUCTION.namespace,
        timeout:        AUCTION.timeout,
        debug:          AUCTION.debug,

        getPrebid: function () {
            return root[AUCTION.namespace] || null;
        },

        /**
         * setEndpoints — called by template after /req response to inject
         * server-side telemetry endpoints dynamically.
         * jsonResponse may contain: hb_endpoints.ihb, hb_endpoints.unfilled
         */
        setEndpoints: function (jsonResponse) {
            if (!jsonResponse) return;
            var ep = jsonResponse.hb_endpoints;
            if (ep && ep.ihb)      TELEMETRY.ihbEndpoint      = ep.ihb;
            if (ep && ep.unfilled) TELEMETRY.unfilledEndpoint = ep.unfilled;
            if (ep && ep.timeout)  TELEMETRY.xhrTimeout       = ep.timeout;
            LOG.info('HBConfig', 'endpoints updated from response');
        },

        /**
         * applyResponseConfig — called by template to push any per-response
         * HB overrides (timeout, retries etc) from server into AUCTION config.
         * jsonResponse.hb_config: { timeout, auctionRetries, auctionBackoff }
         */
        applyResponseConfig: function (jsonResponse) {
            if (!jsonResponse || !jsonResponse.hb_config) return;
            var hc = jsonResponse.hb_config;
            if (hc.timeout)        { AUCTION.timeout = hc.timeout; PREBID_CONFIG.bidderTimeout = hc.timeout; }
            if (hc.auctionRetries !== undefined) AUCTION.auctionRetries = hc.auctionRetries;
            if (hc.auctionBackoff !== undefined) AUCTION.auctionBackoff = hc.auctionBackoff;
            if (hc.prebidUrl)      AUCTION.prebidUrl = hc.prebidUrl;
            LOG.info('HBConfig', 'response config applied');
        },

        buildPrebidConfig: function (hbData) {
            var cfg = JSON.parse(JSON.stringify(PREBID_CONFIG));
            var hasAdagio = Array.isArray(hbData) && hbData.some(function (h) { return h.bidder === 'adagio'; });
            if (hasAdagio) {
                var seen = {}, providers = [];
                hbData.forEach(function (h) {
                    if (h.bidder === 'adagio' && !seen[h.bidder]) {
                        seen[h.bidder] = true;
                        h.conditions.forEach(function (c) { providers.push({ name: 'adagio', params: c }); });
                    }
                });
                cfg.realTimeData.dataProviders = providers;
            }
            return cfg;
        },

        validateHbData: function (hbData) {
            if (!Array.isArray(hbData) || hbData.length === 0) {
                LOG.error('HBConfig', 'header_bidding[] is empty or missing');
                return false;
            }
            var valid = hbData.every(function (h) {
                return h.bidder && Array.isArray(h.conditions) && h.conditions.length > 0
                    && typeof h.floorPrice === 'number';
