// tmCore.js

/*!
 * TapMind_HB_v2.js — Combined HB Engine (GAM-free / Prebid-only)
 * Modules: HBConfig · IHBRep · AdUnitBuilder · SchainManager · AuctionManager
 * Load order: this file first, then template js (e.g. sldr_mod.js)
 * Enable logs: add ?tmdebug=1 to your URL
 *
 * All values are dynamic — hardcoded defaults only where no override exists.
 * Override any value via: window.tmHBOverrides = { key: value } BEFORE loading tmCore.
 * Telemetry endpoints come from server response (jsonResponse.hb_endpoints).
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * CHANGELOG — dual-Prebid-load fix (tmCore vs template-owned HB engines)
 * ─────────────────────────────────────────────────────────────────────────────
 * ROOT CAUSE: _loadWithPrebid() always preloaded Prebid from PREBID_URL
 *   ('//dsrv.tmadsrv.com/auction/tmpbjs.js') for EVERY template, regardless
 *   of whether that template actually uses window.tmAuctionManager. Templates
 *   that own their own HB engine (e.g. sldr_mod's PlayerHeaderBidding, which
 *   loads its own Prebid build from a DIFFERENT URL) would then inject a
 *   SECOND, separate Prebid bundle. Both bundles raced to populate
 *   window.tmpbjs — whichever finished last silently won, which stalled/
 *   corrupted bidsBackHandler and delayed the ad from becoming visible.
 *
 * FIX: _loadWithPrebid() now checks jsonResponse.his.usesTmAuctionManager.
 *   - true  → unchanged behaviour: tmCore preloads Prebid and owns
 *             window.tmpbjs via window.tmAuctionManager, as before.
 *   - false/undefined → tmCore does NOT touch Prebid at all. It hands off
 *             straight to _loadCreativeJs() so the template (sldr_mod) is
 *             the single, sole owner of loading + running its own Prebid
 *             auction. No competing script tag, no race.
 *
 *   Server/response side: set his.usesTmAuctionManager = true only for
 *   templates that actually call window.tmAuctionManager.run(). Leave it
 *   false/omitted for sldr_mod-based units.
 * ─────────────────────────────────────────────────────────────────────────────
 */
(function (root) {
    'use strict';

    /* =====================================================================
     * VERSION MARKER — check window.tmCoreVersion to confirm correct file loaded
     * ===================================================================== */
    root.tmCoreVersion = '2.1.0';
    root.tmCoreLoaded  = true;

    /* =====================================================================
     * DEBUG FLAG — single source of truth for ALL tmCore logging.
     * Enabled via ?tmdebug=1 in the URL, OR window.__tmdebug = true set
     * manually before tmCore loads, OR _overrides.debug = true.
     * Evaluated FIRST (before AUCTION/LOG/etc are built) so every logger
     * in this file reads the same live flag — no stale captured values.
     * ===================================================================== */
