                        // old templates rarely call this directly, but support it anyway
                        if (data && typeof data === 'object') {
                            instance.unfilled(data.adUnitId, data.device, data.country, data.attempt);
                        }
                        break;
                    default:
                        if (typeof instance[eventType] === 'function') instance[eventType](data);
                }
            } catch (e) {
                LOG.error('IHBRep', 'shimFn(' + eventType + ') failed: ' + e.message);
            }
            if (typeof cb === 'function') cb();
        };
        shimFn.req      = instance.req.bind(instance);
        shimFn.bidWon   = instance.bidWon.bind(instance);
        shimFn.imp      = instance.imp.bind(instance);
        shimFn.click    = instance.click.bind(instance);
        shimFn.unfilled = instance.unfilled.bind(instance);

        root.tmsrv.IHBRep = shimFn;
        root.IHBRep        = IHBRep;
        LOG.ok('IHBRep', 'mounted at window.tmsrv.IHBRep');
    })();

    /* =====================================================================
     * SECTION 3 — AdUnitBuilder  (unchanged — only used when
     * usesTmAuctionManager templates call window.tmAuctionManager.run())
     * ===================================================================== */

    function _uid(id, sfx) {
        var base = id + '_' + Math.random().toString(36).slice(2) + '_' + Date.now();
        return sfx ? base + '_' + sfx : base;
    }
    function _rid() { return Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8); }
    function _mkSchain(nodes) {
        if (!Array.isArray(nodes) || !nodes.length) return null;
        return { ver: '1.0', complete: 1, nodes: nodes.map(function (n) { return Object.assign({}, n, { rid: _rid() }); }) };
    }
    function _mkFloor(price) { return { currency: 'USD', schema: { fields: ['mediaType'] }, values: { banner: price } }; }
    function _safeFloor(raw, fallback) { var n = Number(raw); return (isNaN(n) || n < 0) ? (fallback || 0.01) : Number(n.toFixed(2)); }
    var MAX_BUYER_REQUESTS = 5;
    function _buyerRequestCount(raw) { var n = Number(raw); return (isNaN(n) || n < 1) ? 1 : Math.min(Math.floor(n), MAX_BUYER_REQUESTS); }

    var AdUnitBuilder = {};

    AdUnitBuilder.build = function (hbData, adUnitCode, adUnitData, containerEl, l2Bidders, config) {
        var units      = [];
        var log        = (config && config.log) ? config.log : { info:function(){}, warn:function(){}, error:function(){} };
        var flags      = (config && config.bidderFlags) ? config.bidderFlags : { requiresIpParam:[], aliasMap:{}, schainWarnings:[] };
        var mainIp     = (adUnitData && adUnitData.ip) ? adUnitData.ip : null;
        var adUnitId   = (adUnitData && adUnitData.AdUnitID) ? adUnitData.AdUnitID : null;
        var l2Set      = (l2Bidders instanceof Set) ? l2Bidders : new Set();
        var primaryCnt = 0, secondaryCnt = 0, skippedCnt = 0;

        if (!Array.isArray(hbData) || !hbData.length) { log.error('AdUnitBuilder','hbData is empty'); return units; }
        if (!adUnitCode || typeof adUnitCode !== 'string') { log.error('AdUnitBuilder','adUnitCode required'); return units; }

        hbData.forEach(function (hb) {
            if (!hb.bidder || !Array.isArray(hb.conditions) || !hb.conditions.length) { skippedCnt++; return; }
            if (typeof hb.floorPrice !== 'number') { log.warn('AdUnitBuilder','Skipping "'+hb.bidder+'" — floorPrice not a number'); skippedCnt++; return; }

            var fp             = _safeFloor(hb.floorPrice);
            var sp             = hb.isSecondaryFloorPriceEnabled ? _safeFloor(hb.secondaryFloorPrice, fp) : null;
            var sizes          = Array.isArray(hb.size) ? hb.size : [[300,250]];
            var cnt            = _buyerRequestCount(hb.buyerRequests);
            var mt             = { banner: { sizes: sizes } };
            var resolvedBidder = (flags.aliasMap && flags.aliasMap[hb.bidder]) ? flags.aliasMap[hb.bidder] : hb.bidder;
            var pixExtra       = {};
            if (Array.isArray(flags.requiresIpParam) && flags.requiresIpParam.indexOf(resolvedBidder) !== -1 && mainIp) {
                pixExtra = { ip: mainIp };
            }
            var schainObj    = l2Set.has(resolvedBidder) ? _mkSchain(hb.schain) : null;
            var secSchainObj = l2Set.has(resolvedBidder) ? _mkSchain(hb.schain) : null;

            // [PORTED from ref_mod.js RefHeaderBidding.buildAdUnits — FIX-1 UNIVERSAL divId]
            // Stable publisher placement ID for adapters (e.g. adagio) that read
            // ortb2Imp.ext.data.divId instead of falling back to adUnit.code, which
            // is a dynamic internal string (e.g. "tmsrv_Imp_123"), not a real div ID.
            var divId = adUnitId != null ? ('tmsrv-' + adUnitId) : null;

            hb.conditions.forEach(function (cond) {
                for (var r = 0; r < cnt; r++) {
                    var tID  = _uid(hb.buyer_id);
                    var unit = {
                        code: adUnitCode, mediaTypes: mt, floors: _mkFloor(fp),
                        bids: [{ bidder: resolvedBidder, bidderName: hb.buyer_name, bidderID: hb.buyer_id,
                                 mediaType: 'banner', params: Object.assign({}, cond, pixExtra), uniqueTrackingId: tID }],
                        ortb2Imp: { ext: { data: {
                            buyer_name: hb.buyer_name, buyer_id: hb.buyer_id, adUnitId: adUnitId,
                            operational_domain: hb.operational_domain || null,
                            bidderAdjustment: hb.bidder_adjustment,
                            customTrackingId: tID, floorPrice: fp,
                            divId: divId,
                        }}},
                    };
                    if (containerEl) unit.element = containerEl;
                    if (schainObj)   unit.ortb2   = { source: { ext: { schain: schainObj } } };
                    units.push(unit);
                    primaryCnt++;
                }
                if (sp !== null) {
                    var sTID    = _uid(hb.buyer_id, 'sec');
                    var secUnit = {
                        code: adUnitCode, mediaTypes: mt, floors: _mkFloor(sp),
                        bids: [{ bidder: resolvedBidder, bidderName: hb.buyer_name, bidderID: hb.buyer_id,
                                 mediaType: 'banner', params: Object.assign({}, cond, pixExtra), uniqueTrackingId: sTID }],
                        ortb2Imp: { ext: { data: {
                            buyer_name: hb.buyer_name, buyer_id: hb.buyer_id, adUnitId: adUnitId,
                            operational_domain: hb.operational_domain || null,
                            bidderAdjustment: hb.bidder_adjustment,
                            customTrackingId: sTID, floorPrice: sp, isSecondary: true,
                            divId: divId,
                        }}},
                    };
                    if (containerEl) secUnit.element = containerEl;
                    if (secSchainObj) secUnit.ortb2  = { source: { ext: { schain: secSchainObj } } };
                    units.push(secUnit);
                    secondaryCnt++;
                }
            });
        });
        log.info('AdUnitBuilder', primaryCnt+' primary, '+secondaryCnt+' secondary, '+skippedCnt+' skipped = '+units.length+' total');
        return units;
    };

    AdUnitBuilder.buildRtProviders = function (hbData) {
        if (!Array.isArray(hbData)) return [];
        var seen = new Set(), providers = [];
        hbData.filter(function (h) { return h.bidder === 'adagio'; }).forEach(function (h) {
            if (!seen.has(h.bidder)) { seen.add(h.bidder); h.conditions.forEach(function (c) { providers.push({ name: h.bidder, params: c }); }); }
        });
        return providers;
    };

    AdUnitBuilder.validate = function (units, config) {
        var log    = (config && config.log) ? config.log : { warn:function(){}, error:function(){} };
        var errors = [], warnings = [];
        if (!Array.isArray(units) || units.length === 0) { errors.push('adUnits array is empty'); return { valid: false, errors: errors, warnings: warnings }; }
        units.forEach(function (u, i) {
            var p = 'unit[' + i + ']';
            if (!u.code) errors.push(p + ': missing code');
            if (!u.mediaTypes || !u.mediaTypes.banner || !Array.isArray(u.mediaTypes.banner.sizes)) errors.push(p + ': invalid mediaTypes');
            if (!Array.isArray(u.bids) || !u.bids.length) { errors.push(p + ': bids empty'); }
            else { u.bids.forEach(function (b, j) { if (!b.bidder) errors.push(p+'.bids['+j+']: missing bidder'); }); }
            if (!u.ortb2Imp || !u.ortb2Imp.ext || !u.ortb2Imp.ext.data) errors.push(p + ': missing ortb2Imp.ext.data');
        });
        var valid = errors.length === 0;
        if (!valid) errors.forEach(function (e) { log.error('AdUnitBuilder:validate', e); });
        return { valid: valid, errors: errors, warnings: warnings };
    };

    AdUnitBuilder.summarise = function (units) {
        if (!Array.isArray(units)) return '(no units)';
        var primary = units.filter(function (u) { return !u.ortb2Imp.ext.data.isSecondary; });
        var secondary = units.filter(function (u) { return !!u.ortb2Imp.ext.data.isSecondary; });
        var bidders = {};
        units.forEach(function (u) { var b = u.bids[0].bidder; bidders[b] = (bidders[b]||0)+1; });
        return primary.length+' primary + '+secondary.length+' secondary = '+units.length+' total | ['
            + Object.keys(bidders).map(function(k){return k+'×'+bidders[k];}).join(', ') + ']';
    };

    root.AdUnitBuilder = AdUnitBuilder;
    LOG.ok('AdUnitBuilder', 'loaded');

    /* =====================================================================
     * SECTION 4 — SchainManager  (unchanged)
     * ===================================================================== */

    function _schainRid() { return Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,8); }
    function _schainSig(nodes) {
        if (!Array.isArray(nodes) || !nodes.length) return '';
        return JSON.stringify(nodes.slice().sort(function (a,b) { return a.asi.localeCompare(b.asi); }));
    }
    function _buildSchainObj(nodes) {
        return { ver:'1.0', complete:1, nodes: nodes.map(function(n){ return Object.assign({}, n, { rid: _schainRid() }); }) };
    }

    var SchainManager = {};

    SchainManager.apply = function (tmpbjs, hbData, hbSchainData, config) {
        var log       = (config && config.log) ? config.log : { info:function(){}, warn:function(){}, error:function(){}, ok:function(){} };
        var flags     = (config && config.bidderFlags) ? config.bidderFlags : { aliasMap:{}, schainWarnings:[] };
        var l2Bidders = new Set();
        if (!tmpbjs || typeof tmpbjs.setBidderConfig !== 'function') { log.error('SchainManager', 'setBidderConfig not available'); return l2Bidders; }
        var map = _buildSchainMap(hbData, hbSchainData, flags, log);
        if (map.size === 0) { log.warn('SchainManager','No schain data found'); return l2Bidders; }
        var l1Count = 0, l2Count = 0;
        map.forEach(function (entry, bidder) {
            var rb = (flags.aliasMap && flags.aliasMap[bidder]) ? flags.aliasMap[bidder] : bidder;
            _validatePixSchain(bidder, entry.nodes, flags, log);
            if (entry.sigs.size > 1) { l2Bidders.add(rb); l2Count++; return; }
            try {
                tmpbjs.setBidderConfig({ bidders:[rb], config:{ ortb2:{ source:{ ext:{ schain: _buildSchainObj(entry.nodes) }}}}});
                l1Count++;
            } catch (e) { log.error('SchainManager','setBidderConfig failed for "'+rb+'": '+e.message); l2Bidders.add(rb); }
        });
        log.info('SchainManager','apply() — L1: '+l1Count+', L2: '+l2Count);
        return l2Bidders;
    };

    function _buildSchainMap(hbData, hbSchainData, flags, log) {
        var map = new Map();
        var src = (Array.isArray(hbSchainData) && hbSchainData.length > 0) ? hbSchainData : (Array.isArray(hbData) ? hbData : []);
        src.forEach(function (entry) {
            if (!entry.bidder) return;
            var nodes = entry.schain || (function(){ var h = (hbData||[]).find(function(x){return x.bidder===entry.bidder;}); return h && h.schain; })() || [];
            if (!Array.isArray(nodes) || !nodes.length) return;
            var sig = _schainSig(nodes);
            if (!map.has(entry.bidder)) {
                map.set(entry.bidder, { nodes: nodes, sigs: new Set([sig]), domains: new Set([entry.operational_domain||'']) });
            } else {
                var ex = map.get(entry.bidder); ex.sigs.add(sig);
                if (entry.operational_domain) ex.domains.add(entry.operational_domain);
            }
        });
        return map;
    }

    function _validatePixSchain(bidder, nodes, flags, log) {
        if (!Array.isArray(flags.schainWarnings) || flags.schainWarnings.indexOf(bidder) === -1) return;
        if (!Array.isArray(nodes) || !nodes.length) return;
        var hasPixNode = nodes.some(function(n){ return n.asi && n.asi.toLowerCase().indexOf('pixfuture') !== -1; });
        if (!hasPixNode && nodes.length === 1) log.warn('SchainManager','pixfuture schain has only 1 node');
    }

    root.SchainManager = SchainManager;
    LOG.ok('SchainManager', 'loaded');

    /* =====================================================================
     * SECTION 5 — AuctionManager  (only exercised by templates that set
     * his.usesTmAuctionManager = true and call window.tmAuctionManager.run()
     * themselves — sldr_mod's own PlayerHeaderBidding never calls this)
     * ===================================================================== */

    function AuctionManager(config, adUnitBuilder, schainManager, ihbRep) {
        if (!config) throw new Error('[AuctionManager] config is required');
        this._cfg               = config;
        this._auc               = config.auction;
        this._log               = config.log;
        this._ab                = adUnitBuilder || root.AdUnitBuilder;
        this._sm                = schainManager || root.SchainManager;
        this._ihb               = ihbRep;
        this._refreshTimers     = {};
        this._vaayaAliasCreated = false;
        this._eventsWired       = false;   // wire onEvent listeners only once
        this._lastL2Bidders     = new Set();
        this._log.info('AuctionManager', 'initialised');
    }

    AuctionManager.prototype._getIhb = function () {
        if (this._ihb) return this._ihb;
        if (root.tmsrv && root.tmsrv.IHBRep) { this._ihb = root.tmsrv.IHBRep; }
        return this._ihb || null;
    };

    /**
     * run(adUnitCode, adUnitData, containerEl, onComplete, timeoutOverride)
     * timeoutOverride — per-call auction timeout (e.g. his.hbAuctionTimeout from sldr_mod)
     * Takes precedence over AUCTION.timeout for this call only.
     */
    AuctionManager.prototype.run = function (adUnitCode, adUnitData, containerEl, onComplete, timeoutOverride) {
        var self = this, log = this._log;
        var cb   = typeof onComplete === 'function' ? onComplete : function () {};

        // Apply any per-response config from server (endpoints, timeouts)
        if (adUnitData) {
            this._cfg.setEndpoints(adUnitData);
            this._cfg.applyResponseConfig(adUnitData);
        }

        // Reset event wiring flag for this new waterfall round.
        // Events will be wired fresh with new enrichment (new tid from rreq).
        this._eventsWired   = false;
        this._lastL2Bidders = new Set();

        var hbData = adUnitData && adUnitData.header_bidding;
        if (!this._cfg.validateHbData(hbData)) { log.error('AuctionManager','header_bidding[] invalid'); cb(null); return; }

        var effectiveTimeout = timeoutOverride || this._auc.timeout;
        log.info('AuctionManager','run: adUnit="'+adUnitCode+'" timeout='+effectiveTimeout+'ms bidders=['+hbData.map(function(h){return h.bidder;}).join(', ')+']');

        // IHBRep.req fires ONCE per waterfall round (before auction, not per internal retry)
        var ihb = this._getIhb();
        if (ihb && ihb.req) {
            // adUnits not built yet — send adUnitData only; hbDup added after build
            ihb.req(adUnitData, []);
        }

        this._ensureScript(root.document || document, function () {
            self._pollPrebidReady(function (tmpbjs) {
                if (!tmpbjs) { log.error('AuctionManager','Prebid not ready'); cb(null); return; }
                self._runAuction(tmpbjs, adUnitCode, adUnitData, containerEl, hbData, 1, cb, effectiveTimeout);
            });
        });
    };

    AuctionManager.prototype.destroy = function (adUnitCode) {
        if (this._refreshTimers[adUnitCode]) { clearTimeout(this._refreshTimers[adUnitCode]); delete this._refreshTimers[adUnitCode]; }
    };

    AuctionManager.prototype._runAuction = function (tmpbjs, adUnitCode, adUnitData, containerEl, hbData, attempt, cb, timeoutOverride) {
        var self = this, log = this._log;
        var effectiveTimeout = timeoutOverride || this._auc.timeout;
        log.info('AuctionManager','_runAuction: attempt='+attempt+' timeout='+effectiveTimeout+'ms');

        // setConfig and SchainManager only on first attempt — retries reuse same config.
        // Re-running setConfig on retry resets RTD providers and may break adagio/other RTD modules.
        // Build bidderSettings dynamically from hbData bidder_adjustment values.
        // This is the ONLY way Prebid applies CPM adjustments when ranking bids.
        // Without this, bids compare at raw CPM ignoring buyer net/gross adjustment.
        try {
            var flags       = this._cfg.bidderFlags;
            var bSettings   = { standard: { storageAllowed: true, adserverTargeting: [] } };
            hbData.forEach(function (hb) {
                var bidder = (flags.aliasMap && flags.aliasMap[hb.bidder]) ? flags.aliasMap[hb.bidder] : hb.bidder;
                var adj = Number(hb.bidder_adjustment);
                // bidder_adjustment is a PERCENTAGE value e.g. 80 means 80%
                // multiplier = adj / 100  →  80% = 0.80
                // bidder_adjustment=0 or missing or 100 → no adjustment (use raw CPM)
                // Never divide by zero or apply 0% — would zero all bids
                var multiplier = ((!isNaN(adj) && adj > 0 && adj !== 100))
                    ? (adj / 100)
                    : 1.0;
                if (multiplier !== 1.0) {
                    bSettings[bidder] = {
                        storageAllowed: true,
                        bidCpmAdjustment: (function (m) {
                            return function (bidCpm) { return bidCpm * m; };
                        })(multiplier),
                    };
                }
            });
            tmpbjs.bidderSettings = bSettings;
        } catch(e) { log.warn('AuctionManager','bidderSettings failed: '+e.message); }

        if (attempt === 1) {
            var hasVaaya = hbData.some(function(h){ return h.bidder === 'vaayaMedia'; });
            if (hasVaaya && !this._vaayaAliasCreated) {
                try {
                    if (!tmpbjs.bidderRegistry || !tmpbjs.bidderRegistry.vaayaMedia) {
                        tmpbjs.aliasBidder('limelightDigital','vaayaMedia');
                        this._vaayaAliasCreated = true;
                    }
                } catch(e) { log.error('AuctionManager','aliasBidder failed: '+e.message); }
            }
        }

        // setConfig + schain only on first attempt
        if (attempt === 1) {
            try { tmpbjs.setConfig(this._cfg.buildPrebidConfig(hbData)); } catch(e) { log.error('AuctionManager','setConfig threw: '+e.message); }
        }
        var hbSchainData = adUnitData.header_bidding_schain || [];
        var l2Bidders    = (attempt === 1 && this._sm)
            ? this._sm.apply(tmpbjs, hbData, hbSchainData, this._cfg)
            : (this._lastL2Bidders || new Set());
        if (attempt === 1) this._lastL2Bidders = l2Bidders;

        var adUnits;
        try { adUnits = this._ab.build(hbData, adUnitCode, adUnitData, containerEl, l2Bidders, this._cfg); }
        catch (e) { log.error('AuctionManager','build threw: '+e.message); cb(null); return; }

        var validation = this._ab.validate(adUnits, this._cfg);
        if (!validation.valid) { log.error('AuctionManager','validation failed: '+validation.errors.join('; ')); cb(null); return; }
        log.info('AuctionManager', this._ab.summarise(adUnits));

        try { if (tmpbjs.adUnits) tmpbjs.adUnits.length = 0; tmpbjs.addAdUnits(adUnits); }
        catch (e) { log.error('AuctionManager','addAdUnits threw: '+e.message); cb(null); return; }

        // Wire Prebid events only once — onEvent() listeners accumulate (no offEvent).
        // Firing wireEvents on every attempt causes duplicate IHBRep.bidWon reporting.
        if (!this._eventsWired) {
            this._wireEvents(tmpbjs, adUnits, hbData, this._enrichment(adUnitData));
            this._eventsWired = true;
        }

        try {
            tmpbjs.requestBids({
                adUnits:  adUnits,
                timeout:  effectiveTimeout,
                bidsBackHandler: function (bids) {
                    self._onBidsBack(bids, adUnitCode, tmpbjs, adUnitData, hbData, attempt, cb, timeoutOverride);
                },
            });
            log.info('AuctionManager','requestBids fired — timeout='+effectiveTimeout+'ms attempt='+attempt);
        } catch (e) { log.error('AuctionManager','requestBids threw: '+e.message); cb(null); }
    };

    AuctionManager.prototype._onBidsBack = function (bids, adUnitCode, tmpbjs, adUnitData, hbData, attempt, cb, timeoutOverride) {
        var self    = this, log = this._log;
        var hasBids = bids && (adUnitCode in bids);
        var allBids = hasBids ? (bids[adUnitCode].bids || []) : [];
        var winners = hasBids ? tmpbjs.getHighestCpmBids(adUnitCode) : [];
        var winner  = winners[0] || null;

        log.info('AuctionManager','_onBidsBack: attempt='+attempt+' bids='+allBids.length+' winner='+(winner ? winner.bidder+' $'+winner.cpm.toFixed(4) : 'none'));

        // Internal per-auction retry (same req data, short backoff — NOT a waterfall round)
        if (!winner && attempt < this._auc.auctionRetries) {
            log.warn('AuctionManager','No winner attempt '+attempt+' — retrying in '+this._auc.auctionBackoff+'ms');
            setTimeout(function(){
                self._runAuction(tmpbjs, adUnitCode, adUnitData, null, hbData, attempt+1, cb, timeoutOverride);
            }, this._auc.auctionBackoff);
            return;
        }

        if (!winner) {
            log.warn('AuctionManager','No winner after '+attempt+' attempt(s) — passing null to waterfall');
            // IHBRep.req fired in run() once per round. IHBRep.unfilled fired by sldr_mod waterfall.
            cb(null);
            return;
        }

        log.ok('AuctionManager','Winner: bidder="'+winner.bidder+'" cpm=$'+winner.cpm.toFixed(4));

        // IHBRep.imp fires when HB wins — reports winning + all bids to ihb endpoint
        var ihb2 = this._getIhb();
        if (ihb2 && ihb2.imp) {
            ihb2.imp(allBids, winner, this._enrichment(adUnitData));
            log.info('AuctionManager', 'IHBRep.imp fired for winner: "' + winner.bidder + '"');
        }

        cb({ winner: winner, allBids: allBids });
    };

    AuctionManager.prototype._wireEvents = function (tmpbjs, adUnits, hbData, enrichment) {
        var self = this, log = this._log;
        var trackMap = new Map(), bidIdMap = new Map();
        try {
            tmpbjs.onEvent('bidRequested', function (req) {
                if (!req || !Array.isArray(req.bids)) return;
                req.bids.forEach(function (bid) {
                    var tID = bid.uniqueTrackingId; if (!tID) return;
                    var u = adUnits.find(function(u){ return u.code===bid.adUnitCode && u.ortb2Imp && u.ortb2Imp.ext && u.ortb2Imp.ext.data && u.ortb2Imp.ext.data.customTrackingId===tID; });
                    if (u) { trackMap.set(tID, Object.assign({}, u.ortb2Imp.ext.data, { bidId: bid.bidId })); bidIdMap.set(bid.bidId, tID); }
                });
            });
        } catch(e) { log.warn('AuctionManager','onEvent(bidRequested) failed: '+e.message); }
        try {
            tmpbjs.onEvent('bidResponse', function (b) {
                var tID  = bidIdMap.get(b.requestId) || self._fallbackTID(tmpbjs, b, trackMap);
                var meta = tID ? trackMap.get(tID) : self._metaFrom(hbData, b.bidder);
                Object.assign(b, meta||{}, enrichment);
            });
        } catch(e) { log.warn('AuctionManager','onEvent(bidResponse) failed: '+e.message); }
        try {
            tmpbjs.onEvent('bidWon', function (b) {
                var tID  = bidIdMap.get(b.requestId) || self._fallbackTID(tmpbjs, b, trackMap);
                var meta = tID ? trackMap.get(tID) : self._metaFrom(hbData, b.bidder);
                Object.assign(b, meta||{}, enrichment);
                var ihb = self._getIhb();
                if (ihb && ihb.bidWon) ihb.bidWon(b, enrichment);
            });
        } catch(e) { log.warn('AuctionManager','onEvent(bidWon) failed: '+e.message); }
        try {
            tmpbjs.onEvent('noBid', function(nb){ log.warn('AuctionManager','noBid from "'+(nb.bidder||'?')+'"'); });
        } catch(e){}
        return { trackMap: trackMap, bidIdMap: bidIdMap };
