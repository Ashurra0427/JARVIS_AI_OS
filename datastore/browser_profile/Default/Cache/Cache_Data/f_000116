                : self._log.warn('IHBRep', label + ' → HTTP ' + xhr.status);
        };
        xhr.ontimeout = function () { self._log.warn('IHBRep', label + ' timed out'); };
        xhr.onerror   = function () { self._log.warn('IHBRep', label + ' network error'); };
        try {
            xhr.open('POST', url);
            xhr.setRequestHeader('Accept', 'application/json');
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.timeout = self._xhrTimeout();
            xhr.send(body);
            self._log.info('IHBRep', label + ' fired');
        } catch (e) { self._log.warn('IHBRep', '_send failed for ' + label + ': ' + e.message); }
    };

    IHBRep.prototype._makeXhr = function () {
        try { return new XMLHttpRequest(); } catch (e) { this._log.error('IHBRep', 'XHR unavailable'); return null; }
    };

    IHBRep.prototype._sanitizeAdData = function (d) {
        if (!d || typeof d !== 'object') return {};
        var out = {}, keys = Object.keys(d);
        for (var i = 0; i < keys.length; i++) { if (!STRIP_KEYS.has(keys[i])) out[keys[i]] = d[keys[i]]; }
        return out;
    };

    IHBRep.prototype._sanitizeHbDup = function (units) {
        if (!Array.isArray(units)) return [];
        return units.map(function (unit) {
            var out = {}, skip = new Set(['ortb2Imp','ortb2','element']), keys = Object.keys(unit);
            for (var i = 0; i < keys.length; i++) { if (!skip.has(keys[i])) out[keys[i]] = unit[keys[i]]; }
            if (Array.isArray(out.bids)) {
                out.bids = out.bids.map(function (b) {
                    var bOut = {}, bSkip = new Set(['schain','params','uniqueTrackingId']), bKeys = Object.keys(b);
                    for (var j = 0; j < bKeys.length; j++) { if (!bSkip.has(bKeys[j])) bOut[bKeys[j]] = b[bKeys[j]]; }
                    return bOut;
                });
            }
            return out;
        });
    };

    IHBRep.prototype._sanitizeBid = function (b) {
        if (!b || typeof b !== 'object') return b;
        var out = {}, keys = Object.keys(b);
        for (var i = 0; i < keys.length; i++) { if (BID_KEEP_KEYS.has(keys[i])) out[keys[i]] = b[keys[i]]; }
        if (out.floorData && typeof out.floorData === 'object') out.floorData = { floorValue: out.floorData.floorValue };
        // Prebid uses width+height not size[] — reconstruct size array for reporting
        if (!out.size && b.width && b.height) { out.size = [b.width, b.height]; }
        return out;
    };

    IHBRep.prototype._isDuplicate = function (key) {
        var entry = this._sentMap[key];
        return entry && (Date.now() - entry) < 500;
    };

    IHBRep.prototype._markSent = function (key) {
        this._sentMap[key] = Date.now();
        var keys = Object.keys(this._sentMap), now = Date.now(), self = this;
        if (keys.length > 50) keys.forEach(function (k) { if (now - self._sentMap[k] > 5000) delete self._sentMap[k]; });
    };

    (function mountIHBRep() {
        var instance = new IHBRep(tmHBConfig);

        root.tmsrv = root.tmsrv || {};

        /**
         * shimFn — backward-compat for OLD-style templates that call:
         *   utils.IHBRep('req',    cleanPayload,            cb)
         *   utils.IHBRep('imp',    { listOfWinningBids, winningBids }, cb)
         *   utils.IHBRep('bidWon', bidObject,               cb)
         *   utils.IHBRep('click',  { adId, pid, tid },       cb)
         *
         * Adapts the old single-object-argument call style to the new
         * positional-argument method signatures, so templates with HB
         * running client-side (pre-tmAuctionManager) keep working unchanged.
         *
         * NOTE: this stays mounted at window.tmsrv.IHBRep regardless of
         * usesTmAuctionManager — sldr_mod's PlayerHeaderBidding calls
         * this.utils.IHBRep(...) directly for its own telemetry, and that
         * must keep working even though tmCore no longer preloads Prebid
         * for it. Telemetry reporting and Prebid loading are independent.
         */
        var shimFn = function (eventType, data, cb) {
            LOG.warn('IHBRep', 'Deprecated call: tmsrv.IHBRep("' + eventType + '") — use named method');
            try {
                switch (eventType) {
                    case 'req':
                        // old: IHBRep('req', cleanPayload, cb) — cleanPayload already includes hbDup
                        // req(adUnitData, adUnits) — pass cleanPayload as adUnitData, adUnits unused
                        // since hbDup is already embedded in cleanPayload by old template's _sanitizeAdData
                        instance.req(data, []);
                        break;
                    case 'imp':
                        // old: IHBRep('imp', { listOfWinningBids, winningBids }, cb)
                        // imp(allBids, winnerBid, enrichment) — unpack the old report shape
                        var allBids   = (data && data.listOfWinningBids) || [];
                        var winnerBid = (data && data.winningBids) || null;
                        instance.imp(allBids, winnerBid, {});
                        break;
                    case 'bidWon':
                        // old: IHBRep('bidWon', bidObject, cb) — bidObject already has
                        // pid/tid/country/etc merged in via Object.assign(b, meta, enrichment)
                        // before this call, so pass {} as enrichment (already merged into bid)
                        instance.bidWon(data, {});
                        break;
                    case 'click':
                        // old: IHBRep('click', { adId, pid, tid }, cb)
                        // click(adId, pid, tid) — unpack object to positional args
                        if (data && typeof data === 'object') {
                            instance.click(data.adId, data.pid, data.tid);
                        }
