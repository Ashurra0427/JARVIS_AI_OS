    })();

    function _dbg() {
        try { return root.__tmdebug === true; } catch(e) { return false; }
    }

    /* =====================================================================
     * CSP NONCE HELPER
     * Reads the nonce from an existing trusted script on the page and
     * applies it to all dynamically injected <script> tags.
     * This allows dynamic scripts to pass strict CSP policies that use nonces.
     * Publisher must ensure their CSP includes the nonce for trusted sources.
     * ===================================================================== */
