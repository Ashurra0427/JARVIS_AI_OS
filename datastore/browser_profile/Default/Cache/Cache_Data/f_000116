                    decoy.setAttribute('src', legacyUrl);
                    decoy.setAttribute('data-tm-decoy', '1');
                    (doc.head || doc.body).appendChild(decoy);
                    if (window.__tmdebug) console.log('[TapMind] Seeded inert decoy script for legacy URL (no network fetch): ' + legacyUrl);
                });
            } catch (e) {
                console.warn('[TapMind] _seedLegacyDecoyScripts failed: ' + e.message);
            }
        }

        /**
         * _lockPrebidNamespace — protects window[PREBID_NAMESPACE] from being
         * overwritten by a SECOND Prebid build injected by an old template that
         * still hardcodes a different Prebid URL in its own ensureScript().
         * Only relevant/invoked for usesTmAuctionManager:true templates — see
         * _loadWithPrebid below. sldr_mod units never reach this function at all,
         * so this never fights with sldr_mod's own Prebid load.
         */
        function _lockPrebidNamespace(ns) {
            try {
                var existing = window[ns];
                if (!existing || typeof existing.requestBids !== 'function') return;
                var locked = existing;
                Object.defineProperty(window, ns, {
                    configurable: true,
                    enumerable: true,
                    get: function () { return locked; },
                    set: function (v) {
                        if (v && typeof v.requestBids === 'function' && v !== locked) {
                            console.warn('[TapMind] Blocked a second Prebid build from overwriting window.' + ns +
                                ' — a template likely injected its own Prebid script with a different/legacy URL. ' +
                                'tmCore keeps the build it originally loaded (' + PREBID_URL + ').');
                            return; // ignore the overwrite — keep tmCore's build
                        }
                        locked = v; // allow non-Prebid or same-instance assignments through
                    },
                });
                if (window.__tmdebug) console.log('[TapMind] window.' + ns + ' locked to tmCore\'s Prebid build — duplicate injections will be ignored.');
            } catch (e) {
                // If defineProperty fails for any reason, fail open (no lock) rather than break the page.
                console.warn('[TapMind] _lockPrebidNamespace could not lock window.' + ns + ': ' + e.message);
            }
        }

        this._loadWithPrebid = function (adDataUrl, This, jsonResponse) {
            var jsFile       = adDataUrl.split('~')[0];
            var initFunction = adDataUrl.split('~')[1];
            var self         = this;

            var _inject3 = window._tmInjectScript || function(doc, src, onload, onerror) {
                var s = doc.createElement('script'); s.src = src; s.type = 'text/javascript';
                if (onload)  s.onload  = onload;
                if (onerror) s.onerror = onerror;
                (doc.head || doc.body).appendChild(s);
            };

            var _hbArray = (jsonResponse.header_bidding && jsonResponse.header_bidding.length > 0)
                ? jsonResponse.header_bidding
                : (jsonResponse.his && jsonResponse.his.header_bidding && jsonResponse.his.header_bidding.length > 0
                    ? jsonResponse.his.header_bidding
                    : null);
            if (_hbArray && !jsonResponse.header_bidding) jsonResponse.header_bidding = _hbArray;

            /* ─────────────────────────────────────────────────────────────
             * usesTmAuctionManager GATE  (the actual dual-Prebid-load fix)
             *
             * Templates that manage their OWN HB engine (sldr_mod's
             * PlayerHeaderBidding, which loads Prebid from its own hardcoded
             * URL '//dsrv-prbd.tmadsrv.com/tmpbjs.js') must set
             * his.usesTmAuctionManager = false (or omit it entirely).
             * For those, tmCore does NOT touch Prebid in any way — no
             * preload, no dedupe seeding, no namespace locking. It hands
             * straight off to _loadCreativeJs so sldr_mod's own
             * ensureScript() is the ONE AND ONLY thing that ever injects
             * a <script src="...tmpbjs.js">. That removes the race that
             * was causing two separate tmpbjs.js network requests and a
             * corrupted/delayed bidsBackHandler.
             *
             * Templates that DO call window.tmAuctionManager.run() (the
             * newer tmCore-native path) must set his.usesTmAuctionManager
             * = true from the server, and get the exact same preload
             * behaviour as before this change.
             * ───────────────────────────────────────────────────────────── */
            var usesTmAuctionManager = !!(jsonResponse.his && jsonResponse.his.usesTmAuctionManager);

            if (!usesTmAuctionManager) {
                if (window.__tmdebug) {
                    console.log('[TapMind] his.usesTmAuctionManager is false/unset — template owns its own HB engine (e.g. sldr_mod). tmCore is NOT touching Prebid for this unit.');
                }
                self._loadCreativeJs(jsFile, initFunction, This, jsonResponse);
                return;
            }

            /**
             * tmCore's job here is ONLY to ensure tmpbjs.js is loaded and ready.
             * For usesTmAuctionManager:true templates, the template calls
             * window.tmAuctionManager.run() itself per waterfall round.
             */

            /**
             * _verifyPrebidModules — logs (once) which modules are actually compiled
             * into the loaded Prebid build, so you can confirm bidder/userId/RTD
             * support at any time without guessing. Diagnostic-only, gated on
             * ?tmdebug=1.
             */
            function _verifyPrebidModules(pbjs, namespace, url) {
                if (!window.__tmdebug) return;
                var flagKey = '__tm_module_check_' + namespace;
                if (window[flagKey]) return;
                window[flagKey] = true;

                try {
                    var installed = pbjs.installedModules || [];
                    var hasUserIdCore = installed.indexOf('userId') !== -1;
                    var hasNovatiq    = installed.indexOf('novatiqIdSystem') !== -1;
                    var idModulesFound = installed.filter(function(m) { return /IdSystem$/.test(m); });

                    console.log(
                        '%c[TapMind:ModuleCheck] namespace="' + namespace + '" url="' + url + '"\n' +
                        '  userId core module present: ' + hasUserIdCore + '\n' +
                        '  novatiqIdSystem present: ' + hasNovatiq + '\n' +
                        '  all *IdSystem modules found: [' + idModulesFound.join(', ') + ']\n' +
                        '  total installedModules: ' + installed.length,
                        'color:#ffcc02;font-weight:700;font-size:11px;background:#222;padding:2px 4px'
                    );

                    if (!hasUserIdCore) {
                        console.warn('[TapMind:ModuleCheck] ⚠️ "' + namespace + '" has NO userId module — userIds config is a silent no-op.');
                    } else if (!hasNovatiq) {
                        console.warn('[TapMind:ModuleCheck] ⚠️ "' + namespace + '" has userId core but NOT novatiqIdSystem.');
                    } else {
                        console.log('%c[TapMind:ModuleCheck] ✅ "' + namespace + '" fully supports novatiq userId resolution.', 'color:#66bb6a;font-weight:700');
                    }

                    var hasCurrency = installed.indexOf('currency') !== -1;
                    var hasRtd      = installed.indexOf('rtdModule') !== -1;
                    var hasAdagio   = installed.indexOf('adagioRtdProvider') !== -1 || installed.indexOf('adagioAnalyticsAdapter') !== -1;
                    console.log('[TapMind:ModuleCheck] currency module: ' + hasCurrency + ' | realTimeData(rtdModule): ' + hasRtd + ' | adagio RTD: ' + hasAdagio);
                    if (!hasCurrency) console.warn('[TapMind:ModuleCheck] ⚠️ missing currency module — currency config is a silent no-op.');
                    if (!hasRtd)      console.warn('[TapMind:ModuleCheck] ⚠️ missing rtdModule — realTimeData config is a silent no-op.');

                    var COMMON_BIDDERS = [
                        'pixfuture', 'vaayaMedia', 'limelightDigital', 'equativ',
                        'smartadserver', 'adagio', 'appnexus', 'rubicon', 'pubmatic',
                        'openx', 'criteo', 'ix', 'sovrn', 'triplelift', 'gumgum',
                    ];
                    if (pbjs.bidderRegistry) {
                        var missingBidders = COMMON_BIDDERS.filter(function(b) { return !pbjs.bidderRegistry[b]; });
                        var presentBidders = COMMON_BIDDERS.filter(function(b) { return !!pbjs.bidderRegistry[b]; });
                        console.log('[TapMind:ModuleCheck] bidders PRESENT: [' + presentBidders.join(', ') + ']');
                        if (missingBidders.length) {
                            console.warn('[TapMind:ModuleCheck] ⚠️ bidders MISSING (will be silently skipped if used): [' + missingBidders.join(', ') + ']');
                        }
                    }
                } catch (e) {
                    console.warn('[TapMind:ModuleCheck] Could not inspect installedModules: ' + e.message);
                }
            }

            function _pollPrebidThenLoad() {
                var maxTries = (window.tmHBConfig && window.tmHBConfig.auction && window.tmHBConfig.auction.maxPrebidPollAttempts) || 20;
                var pollMs   = (window.tmHBConfig && window.tmHBConfig.auction && window.tmHBConfig.auction.prebidPollInterval)    || 10;
                var attempts = 0;
                var poll = setInterval(function () {
                    attempts++;
                    var pbjs = window[PREBID_NAMESPACE];
                    if (pbjs && typeof pbjs.requestBids === 'function') {
                        clearInterval(poll);
                        if (window.__tmdebug) console.log('%c[TapMind] Prebid ready after ' + (attempts * pollMs) + 'ms', 'color:#66bb6a;font-weight:700');
                        _verifyPrebidModules(pbjs, PREBID_NAMESPACE, PREBID_URL);
                        _lockPrebidNamespace(PREBID_NAMESPACE);
                        _seedLegacyDecoyScripts(window.tmsrv.D);
                        self._loadCreativeJs(jsFile, initFunction, This, jsonResponse);
                        return;
                    }
                    if (attempts >= maxTries) {
                        clearInterval(poll);
                        if (window.__tmdebug) console.warn('[TapMind] Prebid not ready after ' + (attempts * pollMs) + 'ms — loading template anyway');
                        self._loadCreativeJs(jsFile, initFunction, This, jsonResponse);
                    }
                }, pollMs);
            }

            if (window.__tmdebug) {
                console.log('[TapMind] usesTmAuctionManager=true | header_bidding check | top-level=' + !!(jsonResponse.header_bidding && jsonResponse.header_bidding.length) +
                    ' | his.header_bidding=' + !!(jsonResponse.his && jsonResponse.his.header_bidding && jsonResponse.his.header_bidding.length) +
                    ' | resolved length=' + (_hbArray ? _hbArray.length : 0));
            }

            if (_hbArray && _hbArray.length > 0) {
                if (!window.tmsrv.header_bidding) {
                    _inject3(window.tmsrv.D, PREBID_URL,
                        function () {
                            window.tmsrv.header_bidding = true;
                            _pollPrebidThenLoad();
                        },
                        function () {
                            console.warn('[TapMind] prebid.js failed to load from ' + PREBID_URL + ' — loading template anyway');
                            self._loadCreativeJs(jsFile, initFunction, This, jsonResponse);
                        }
                    );
                } else {
                    var pbjsExisting = window[PREBID_NAMESPACE];
                    if (pbjsExisting && typeof pbjsExisting.requestBids === 'function') {
                        _lockPrebidNamespace(PREBID_NAMESPACE);
                        _seedLegacyDecoyScripts(window.tmsrv.D);
                        self._loadCreativeJs(jsFile, initFunction, This, jsonResponse);
                    } else {
                        _pollPrebidThenLoad();
                    }
                }
            } else {
                if (window.__tmdebug) console.log('[TapMind] No header_bidding config — loading template with SSPTag only');
                self._loadCreativeJs(jsFile, initFunction, This, jsonResponse);
            }
        };

        this.stdb1       = function (jsonResponse, This) { var adData = jsonResponse.stdb;             if (typeof adData.url !== 'undefined') { This._loadWithPrebid(adData.url, This, jsonResponse); } };
        this.highImpact1 = function (jsonResponse, This) { var adData = jsonResponse.his;              if (typeof adData.url !== 'undefined') { This._loadWithPrebid(adData.url, This, jsonResponse); } };
        this.stdb2       = function (jsonResponse, This) { var adData = jsonResponse.creative_content; if (typeof adData.url !== 'undefined') { This._loadWithPrebid(adData.url, This, jsonResponse); } };
        this.highImpact2 = function (jsonResponse, This) { var adData = jsonResponse.creative_content; if (typeof adData.url !== 'undefined') { This._loadWithPrebid(adData.url, This, jsonResponse); } };
    };

    /* ── Global event methods ── */
    window.tmsrv.imp    = function (ad_unit_id, pid, tid, viewability) { window.tmsrv.sendBeacon({ what: 'imp',    AdUnitID: ad_unit_id, pid: pid, tid: tid, viewability: viewability }); };
    window.tmsrv.click  = function (ad_unit_id, pid, tid)              { window.tmsrv.sendBeacon({ what: 'click',  AdUnitID: ad_unit_id, pid: pid, tid: tid }); };
    window.tmsrv.rimp   = function (ad_unit_id, pid, tid, viewability) { window.tmsrv.sendBeacon({ what: 'rimp',   AdUnitID: ad_unit_id, pid: pid, tid: tid, viewability: viewability }); };
    window.tmsrv.rclick = function (ad_unit_id, pid, tid)              { window.tmsrv.sendBeacon({ what: 'rclick', id: ad_unit_id, pid: pid, tid: tid }); };
    window.tmsrv.pload  = function (ad_unit_id, pid, tid, viewability) { window.tmsrv.sendBeacon({ what: 'pload',  id: ad_unit_id, pid: pid, tid: tid, viewability: viewability }); };
    window.tmsrv.stop   = function ()                                   { window.tmsrv.sendBeacon({ what: 'stop',   list: window.tmsrv.instancesMetadata }); };

    window.tmsrv.rreq = function (ad_unit_id, pid, callback) {
        var jsonRequest = { cb: (new Date()).getTime(), AdUnitID: ad_unit_id, what: 'rreq', pid: pid };
        window.tmsrv.httpPost(window.tmsrv.display.ASU + '/rreq', jsonRequest, function (adUnit) {
            window.tmsrv.log(adUnit, 'display');
            if (adUnit === '[]') return;
            if (adUnit.lce === 0) { callback(adUnit); }
        }, null);
    };

    window.tmsrv.tevt = function (args, retries) {
        if (typeof retries === 'undefined') retries = 3;
        var status = navigator.sendBeacon(window.tmsrv.display.ASU_Re, JSON.stringify(args));
        if (!status && retries > 0) { setTimeout(function () { window.tmsrv.tevt(args, retries - 1); }, 100); }
        else if (!status) { console.warn('sendBeacon failed after max retries:', args); }
    };

    window.tmsrv.d_imp   = function (ad_unit_id, pid, tid, viewability) { window.tmsrv.sendBeaconDisplay({ what: 'imp',   AdUnitID: ad_unit_id, pid: pid, tid: tid, viewability: viewability }); };
    window.tmsrv.d_click = function (ad_unit_id, pid, tid)              { window.tmsrv.sendBeaconDisplay({ what: 'click', AdUnitID: ad_unit_id, pid: pid, tid: tid }); };

    window.tmsrv.d_rreq = function (ad_unit_id, pid, callback) {
        var jsonRequest = { cb: (new Date()).getTime(), AdUnitID: ad_unit_id, what: 'rreq', pid: pid };
        window.tmsrv.httpPost(window.tmsrv.display.ASU + '/rreq', jsonRequest, function (adUnit) {
            window.tmsrv.log(adUnit, 'display');
            if (adUnit === '[]') return;
            if (adUnit.lce === 0) { callback(adUnit); }
        }, null);
    };

    window.tmsrv.d_tevt = function (args, retries) {
        if (typeof retries === 'undefined') retries = 3;
        var status = navigator.sendBeacon(window.tmsrv.display.ASU_Re, JSON.stringify(args));
        if (!status && retries > 0) { setTimeout(function () { window.tmsrv.d_tevt(args, retries - 1); }, 100); }
        else if (!status) { console.warn('sendBeacon (display) failed after max retries:', args); }
    };
}