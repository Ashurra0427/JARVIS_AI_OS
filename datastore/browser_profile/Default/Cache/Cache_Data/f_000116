            return valid;
        },
    };

    root.tmHBConfig = tmHBConfig;
    LOG.info('HBConfig', 'v2 loaded — namespace="' + AUCTION.namespace + '" timeout=' + AUCTION.timeout + 'ms');

    /* =====================================================================
     * SECTION 2 — IHBRep  (unchanged — telemetry endpoints now dynamic)
     * ===================================================================== */

    var STRIP_KEYS = new Set([
        'user_consent','keywords','commit','language','his','interest',
        'latlon','contextual_targeting','brand','ip','demand','zipcode',
        'header_bidding','creative_content','header_bidding_schain',
        'bot','description','title','category',
    ]);

    var BID_KEEP_KEYS = new Set([
        'pid','tid','buyer_name','buyer_id','size','adId','bidder',
        'cpm','originalCpm','floorData','responseTimestamp',
        'requestTimestamp','bidderAdjustment','adUnitCode','timeToRespond',
    ]);

    function IHBRep(config) {
        if (!config || !config.telemetry) throw new Error('[IHBRep] HBConfig must be passed to constructor');
        this._config     = config;   // keep ref so endpoint changes propagate
        this._events     = config.telemetry.events;
        this._log        = config.log;
        this._sentMap    = {};
        this._log.info('IHBRep', 'initialised');
    }

    /* Always read endpoint from config at call-time so setEndpoints() propagates */
    IHBRep.prototype._endpoint    = function () { return this._config.telemetry.ihbEndpoint; };
    IHBRep.prototype._unfilledEp  = function () { return this._config.telemetry.unfilledEndpoint; };
    IHBRep.prototype._xhrTimeout  = function () { return this._config.telemetry.xhrTimeout; };

    IHBRep.prototype.req = function (adUnitData, adUnits) {
        this._send(this._endpoint(), {
            eventType: this._events.REQ,
            eventData: Object.assign({}, this._sanitizeAdData(adUnitData), { hbDup: this._sanitizeHbDup(adUnits) }),
        }, 'req');
    };

    IHBRep.prototype.bidWon = function (bid, enrichment) {
        var safeBid = this._sanitizeBid(bid);
        var key     = this._events.BID_WON + (safeBid.adUnitCode || safeBid.adId || '');
        if (this._isDuplicate(key)) { this._log.warn('IHBRep', 'bidWon duplicate suppressed'); return; }
        this._markSent(key);
        this._send(this._endpoint(), {
            eventType: this._events.BID_WON,
            eventData: Object.assign({}, safeBid, enrichment || {}),
        }, 'bidWon');
    };

    IHBRep.prototype.imp = function (allBids, winnerBid, enrichment) {
        var safeWinner = winnerBid ? this._sanitizeBid(winnerBid) : null;
        var safeAll    = Array.isArray(allBids) ? allBids.map(this._sanitizeBid.bind(this)) : (safeWinner ? [safeWinner] : []);
        this._send(this._endpoint(), {
            eventType: this._events.IMP,
            eventData: Object.assign({}, { listOfWinningBids: safeAll, winningBids: safeWinner }, enrichment || {}),
        }, 'imp');
    };

    IHBRep.prototype.click = function (adId, pid, tid) {
        if (!adId) { this._log.warn('IHBRep', 'click() called with no adId'); return; }
        this._send(this._endpoint(), { eventType: this._events.CLICK, eventData: { adId: adId, pid: pid, tid: tid } }, 'click');
    };

    IHBRep.prototype.unfilled = function (adUnitId, device, country, attempt) {
        var data = { eventType: this._events.UNFILLED, adUnitId: adUnitId };
        if (device  !== undefined) data.device  = device;
        if (country !== undefined) data.country = country;
        if (attempt !== undefined) data.attempt = attempt;
        var xhr = this._makeXhr();
        if (!xhr) return;
        try {
            xhr.open('POST', this._unfilledEp());
            xhr.setRequestHeader('Accept', 'application/json');
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.timeout = this._xhrTimeout();
            xhr.send(JSON.stringify(data));
            this._log.info('IHBRep', 'unfilled fired — adUnitId=' + adUnitId);
        } catch (e) { this._log.warn('IHBRep', 'unfilled XHR failed: ' + e.message); }
    };

    IHBRep.prototype._send = function (url, payload, label) {
        var self = this, body;
        try { body = JSON.stringify(payload); } catch (e) { self._log.warn('IHBRep', 'stringify failed for ' + label); return; }

        if (label === 'click' && navigator.sendBeacon) {
            try {
                navigator.sendBeacon(url, new Blob([body], { type: 'application/json' }));
                self._log.info('IHBRep', 'beacon(' + label + ') queued');
                return;
            } catch (e) { /* fall through */ }
        }

        var xhr = this._makeXhr();
        if (!xhr) return;
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            xhr.status >= 200 && xhr.status < 300
