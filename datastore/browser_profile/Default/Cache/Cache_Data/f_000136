/**
 * sldr_mod — Prebid.js 11.5.0 compatible build
 *
 * ─── CHANGES FROM 10.x → 11.5.0 ────────────────────────────────────────────
 *
 * [1] SCHAIN — ortb2 first-party data (Prebid 10+, required in 11)
 *     OLD: ad unit bids object had `schain: { ver, complete, nodes }` inline.
 *     NEW: schain must live in ortb2.source.ext.schain (or ortb2.source.schain).
 *          The per-bid schain field is ignored by adapters in Prebid 11.
 *          Fixed in: hBGetData() — schain nodes are now set via ortb2 on tmpbjs,
 *          not embedded inside the bid object.
 *
 * [2] BIDDER SETTINGS — adserverTargeting custom key (Prebid 11)
 *     The `hb_req` / `hb_rreq` custom key written via bidderSettings.standard
 *     .adserverTargeting still works, BUT returning a non-string from `val`
 *     now causes a warning and may be silently dropped. The function must return
 *     a string (or number coercible to string). Fixed: explicit String() cast.
 *
 * [3] EVENTS REMOVED (Prebid 11)
 *     `addAdUnits`, `bidAccepted`, and `seatNonBid` events no longer fire.
 *     Your code used `bidWon`, `bidResponse`, `bidRequested`, `noBid` — these
 *     are all still valid. No change needed here.
 *
 * [4] MEDIA TYPE VALIDATION (Prebid 11)
 *     Bids whose mediaType does not match the ad unit's mediaTypes are rejected.
 *     All ad units built in hBGetData() already declare `mediaTypes: { banner: { sizes } }`.
 *     The bid objects themselves don't set a conflicting mediaType, so no change needed.
 *     Added auctionOptions.rejectInvalidMediaTypes = false as a safety valve in setConfig
 *     in case a downstream bidder adapter returns an unexpected mediaType.
 *
 * [5] storageControl STRICT MODE (Prebid 11)
 *     The storageControl module now defaults to strict enforcement. If included
 *     in the Prebid build, undisclosed storage use will throw instead of warn.
 *     `storageAllowed: true` in bidderSettings.standard is preserved (it was
 *     already there) — this is the correct way to opt-in per Prebid 7+.
 *
 * [6] statusMessage REMOVED (Prebid 11.3+)
 *     `bid.statusMessage` was removed in 11.3.0. Any code reading it will get
 *     `undefined`. Removed one reference in the noBid handler log object.
 *
 * [7] enableTIDs (Prebid 10+)
 *     `enableTIDs: true` in setConfig is still valid through 11.x. Kept as-is.
 *
 * [8] DNT (Prebid 11)
 *     navigator.doNotTrack is no longer read by the core. No action needed in
 *     publisher code.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 */

class sldr_mod {
  constructor(root, adData, utils) {
    this.root = root || document.body;
    this.utils = utils;
    this.log = utils.log || ((msg) => console.log(msg));

    this.mainData = adData;
    this.adData = adData.his;
    this.adDataContent = adData.creative_content;
    this.pid = adData.pid;
    this.tid = adData.tid;
    this.id = adData.AdUnitID;
    this.header_bidding = adData.header_bidding;

    this.disableLogging = this.adData.disableLogging === undefined ? true : this.adData.disableLogging;
    this.utils.enableLog(this.disableLogging);
    let [w, h] = (this.adData.size || "300x250").split("x");
    this.width = Number(w);
    this.height = Number(h);
    this.showBranding = Boolean(this.adData.showBranding);
    this.closeButtonSize = "medium";
    if (
      this.adData.closeButton_delay == undefined ||
      this.adData.closeButton_delay < 5
